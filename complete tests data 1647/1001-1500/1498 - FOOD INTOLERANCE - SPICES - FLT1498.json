      "data": {
        "value": "<table style=\"height: 659px; width: 97.2061%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 22.4944%;\"><strong>Spice Name</strong></th>\n<th style=\"width: 22.8654%;\"><strong>IgG Level</strong> (Example)</th>\n<th style=\"width: 6.74459%;\"><strong>Unit</strong></th>\n<th style=\"width: 18.5447%;\"><strong>Reaction Class</strong></th>\n<th style=\"width: 21.2929%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Turmeric</td>\n<td style=\"width: 22.8654%;\">55</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style=\"width: 18.5447%;\">Class 2</td>\n<td style=\"width: 21.2929%;\">Moderate Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Ginger</td>\n<td style=\"width: 22.8654%;\">12</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style=\"width: 18.5447%;\">Class 1</td>\n<td style=\"width: 21.2929%;\">Mild Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Garlic</td>\n<td style=\"width: 22.8654%;\">0</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style=\"width: 18.5447%;\">Class 0</td>\n<td style=\"width: 21.2929%;\">No Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Black Pepper</td>\n<td style=\"width: 22.8654%;\">80</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style=\"width: 18.5447%;\">Class 3</td>\n<td style=\"width: 21.2929%;\">High Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Cinnamon</td>\n<td style=\"width: 22.8654%;\">65</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style=\"width: 18.5447%;\">Class 2</td>\n<td style=\"width: 21.2929%;\">Moderate Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 22.4944%;\">Clove</td>\n<td style=\"width: 22.8654%;\">7</td>\n<td style=\"width: 6.74459%;\">&micro;g/mL</td>\n<td style