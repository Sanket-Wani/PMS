  "interpretation": "<table style=\"height: 175px; width: 89.2193%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 14.9121%;\"><strong>Class</strong></th>\n<th style=\"width: 39.2383%;\"><strong>IgG Level (&micro;g/mL)</strong></th>\n<th style=\"width: 39.0202%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 34px;\">\n<td style=\"width: 14.9121%;\">Class 0</td>\n<td style=\"width: 39.2383%;\">&lt;10</td>\n<td style=\"width: 39.0202%;\">No Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 14.9121%;\">Class 1</td>\n<td style=\"width: 39.2383%;\">10 &ndash; 24</td>\n<td style=\"width: 39.0202%;\">Mild Intolerance</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 14.9121%;\">Class 2</td>\n<td style=\"width: 39.2383%;\">25 &ndash; 49</td>\n<td style=\"width: 39.0202%;\">Moderate Intolerance</td>\n</tr>\n<tr style=\"height: 39px;\">\n<td style=\"width: 14.9121%;\">Class 3</td>\n<td style=\"width: 39.2383%;\">&ge;50</td>\n<td style=\"width: 39.0202%;\">High Intolerance</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
