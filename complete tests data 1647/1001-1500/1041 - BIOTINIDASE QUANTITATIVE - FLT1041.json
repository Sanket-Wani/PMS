  "cost": 0,
  "interpretation": "<table class=\"border-borderMain my-[1em] w-full table-auto border\">\n<thead class=\"bg-offset\">\n<tr>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><span style=\"font-size: 10px;\">Biotinidase Activity (nmol/min/mL)</span></th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><span style=\"font-size: 10px;\">Interpretation</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">&gt;5.0</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">Normal</span></td>\n</tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">1.0&ndash;5.0</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">Partial deficiency</span></td>\n</tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">&lt;1.0</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">Profound deficiency</span></td>\n</tr>\n</tbody>\n</table>\n<ul class=\"marker:text-textOff list-disc\">\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\"><strong>Normal</strong>: Indicates adequate enzyme activity; biotinidase deficiency unlikely.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\"><strong>Partial deficiency</strong>: Reduced enzyme activity; may indicate heterozygous carriers or mild clinical manifestations.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\"><strong>Profound deficiency</strong>: Very low/absent enzyme activity; risk of severe clinical symptoms, needs urgent clinical management and treatment with biotin supplementation.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Genetic testing may be recommended for confirmation, particularly in the case of abnormal results.</span></p>\n</li>\n</ul>",
