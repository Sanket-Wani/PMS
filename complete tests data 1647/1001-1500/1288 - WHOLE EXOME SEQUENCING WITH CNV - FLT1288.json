  "interpretation": "<ul data-start=\"1070\" data-end=\"1439\">\n<li data-start=\"1070\" data-end=\"1194\">\n<p data-start=\"1072\" data-end=\"1194\"><span style=\"font-size: 9px;\"><strong data-start=\"1072\" data-end=\"1104\">Whole Exome Sequencing (WES)</strong> identifies disease-associated variants across all protein-coding regions (~20,000 genes).</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1195\" data-end=\"1281\">\n<p data-start=\"1197\" data-end=\"1281\"><span style=\"font-size: 9px;\">CNV analysis enables detection of large deletions or duplications in exonic regions.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1282\" data-end=\"1439\">\n<p data-start=\"1284\" data-end=\"1320\"><span style=\"font-size: 9px;\">Detected variants are classified as:</span></p>\n<ul data-start=\"1323\" data-end=\"1439\">\n<li style=\"font-size: 9px;\" data-start=\"1323\" data-end=\"1359\">\n<p data-start=\"1325\" data-end=\"1359\"><span style=\"font-size: 9px;\"><strong data-start=\"1325\" data-end=\"1359\">Pathogenic / Likely Pathogenic</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1362\" data-end=\"1408\">\n<p data-start=\"1364\" data-end=\"1408\"><span style=\"font-size: 9px;\"><strong data-start=\"1364\" data-end=\"1408\">Variants of Uncertain Significance (VUS)</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1411\" data-end=\"1439\">\n<p data-start=\"1413\" data-end=\"1439\"><span style=\"font-size: 9px;\"><strong data-start=\"1413\" data-end=\"1439\">Benign / Likely Benign</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n<p data-start=\"1413\" data-end=\"1439\"><span style=\"font-size: 9px;\"><strong data-start=\"1453\" data-end=\"1474\">Clinical Utility:</strong></span></p>\n<ul data-start=\"1476\" data-end=\"1873\">\n<li style=\"font-size: 9px;\" data-start=\"1476\" data-end=\"1623\">\n<p data-start=\"1478\" data-end=\"1623\"><span style=\"font-size: 9px;\">Used for diagnosis of <strong data-start=\"1500\" data-end=\"1526\">rare genetic disorders</strong>, <strong data-start=\"1528\" data-end=\"1550\">Mendelian diseases</strong>, <strong data-start=\"1552\" data-end=\"1574\">neurodevelopmental</strong>, <strong data-start=\"1576\" data-end=\"1593\">neuromuscular</strong>, and <strong data-start=\"1599\" data-end=\"1622\">metabolic syndromes</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1624\" data-end=\"1687\">\n<p data-start=\"1626\" data-end=\"1687\"><span style=\"font-size: 9px;\">Detects both <strong data-start=\"1639\" data-end=\"1658\">point mutations</strong> and <strong data-start=\"1663\" data-end=\"1686\">copy number changes</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1688\" data-end=\"1873\">\n<p data-start=\"1690\" data-end=\"1714\"><span style=\"font-size: 9px;\">Ideal for patients with:</span></p>\n<ul data-start=\"1717\" data-end=\"1873\">\n<li style=\"font-size: 9px;\" data-start=\"1717\" data-end=\"1749\">\n<p data-start=\"1719\" data-end=\"1749\"><span style=\"font-size: 9px;\">Undiagnosed genetic conditions</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1752\" data-end=\"1783\">\n<p data-start=\"1754\" data-end=\"1783\"><span style=\"font-size: 9px;\">Multiple congenital anomalies</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1786\" data-end=\"1834\">\n<p data-start=\"1788\" data-end=\"1834\"><span style=\"font-size: 9px;\">Intellectual disability or developmental delay</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1837\" data-end=\"1873\">\n<p data-start=\"1839\" data-end=\"1873\"><span style=\"font-size: 9px;\">Family history of genetic diseases</span></p>\n</li>\n</ul>\n</li>\n</ul>",
