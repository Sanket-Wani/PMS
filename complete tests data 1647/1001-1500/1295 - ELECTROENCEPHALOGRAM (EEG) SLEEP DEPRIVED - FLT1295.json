    {
      "type": "textEditor",
      "data": {
        "value": "<h4 data-start=\"623\" data-end=\"652\"><strong data-start=\"628\" data-end=\"651\">Patient Information</strong>:</h4>\n<ul data-start=\"653\" data-end=\"747\">\n<li data-start=\"653\" data-end=\"666\">\n<p data-start=\"655\" data-end=\"666\"><strong data-start=\"655\" data-end=\"663\">Name</strong>:</p>\n</li>\n<li data-start=\"667\" data-end=\"685\">\n<p data-start=\"669\" data-end=\"685\"><strong data-start=\"669\" data-end=\"682\">Age / Sex</strong>:</p>\n</li>\n<li data-start=\"686\" data-end=\"708\">\n<p data-start=\"688\" data-end=\"708\"><strong data-start=\"688\" data-end=\"705\">UHID / Lab ID</strong>:</p>\n</li>\n<li data-start=\"709\" data-end=\"725\">\n<p data-start=\"711\" data-end=\"725\"><strong data-start=\"711\" data-end=\"722\">Ref. By</strong>:</p>\n</li>\n<li data-start=\"726\" data-end=\"747\">\n<p data-start=\"728\" data-end=\"747\"><strong data-start=\"728\" data-end=\"744\">Date of Test</strong>:</p>\n</li>\n</ul>\n<h4 data-start=\"754\" data-end=\"793\"><strong data-start=\"759\" data-end=\"792\">Indication / Clinical History</strong>:</h4>\n<ul data-start=\"794\" data-end=\"870\">\n<li data-start=\"794\" data-end=\"870\">\n<p data-start=\"796\" data-end=\"870\">(e.g., Recurrent seizures, unexplained blackout, suspected epilepsy, etc.)</p>\n</li>\n</ul>\n<h4 data-start=\"877\" data-end=\"896\"><strong data-start=\"882\" data-end=\"895\">Procedure</strong>:</h4>\n<ul data-start=\"897\" data-end=\"1110\">\n<li data-start=\"897\" data-end=\"984\">\n<p data-start=\"899\" data-end=\"984\">Sleep-deprived EEG performed using <strong data-start=\"934\" data-end=\"984\">10&ndash;20 international electrode placement system</strong></p>\n</li>\n<li data-start=\"985\" data-end=\"1015\">\n<p data-start=\"987\" data-end=\"1015\">Duration: ~<strong data-start=\"998\" data-end=\"1015\">30&ndash;45 minutes</strong></p>\n</li>\n<li data-start=\"1016\" data-end=\"1110\">\n<p data-start=\"1018\" data-end=\"1110\">States: <strong data-start=\"1026\" data-end=\"1035\">Awake</strong>, <strong data-start=\"1037\" data-end=\"1047\">Drowsy</strong>, <strong data-start=\"1049\" data-end=\"1064\">Light Sleep</strong>, <strong data-start=\"1066\" data-end=\"1086\">Hyperventilation</strong>, <strong data-start=\"1088\" data-end=\"1110\">Photic stimulation</strong></p>\n</li>\n</ul>\n<h4 data-start=\"1117\" data-end=\"1135\"><strong data-start=\"1122\" data-end=\"1134\">Findings</strong>:</h4>\n<ul data-start=\"1136\" data-end=\"1474\">\n<li data-start=\"1136\" data-end=\"1201\">\n<p data-start=\"1138\" data-end=\"1201\"><strong data-start=\"1138\" data-end=\"1161\">Background Activity</strong>: (e.g., Normal alpha rhythm at 8&ndash;12 Hz)</p>\n</li>\n<li data-start=\"1202\" data-end=\"1265\">\n<p data-start=\"1204\" data-end=\"1265\"><strong data-start=\"1204\" data-end=\"1221\">Sleep Markers</strong>: (e.g., Vertex sharp waves, sleep spindles)</p>\n</li>\n<li data-start=\"1266\" data-end=\"1371\">\n<p data-start=\"1268\" data-end=\"1294\"><strong data-start=\"1268\" data-end=\"1291\">Paroxysmal Activity</strong>:</p>\n<ul data-start=\"1297\" data-end=\"1371\">\n<li data-start=\"1297\" data-end=\"1319\">\n<p data-start=\"1299\" data-end=\"1319\"><strong data-start=\"1299\" data-end=\"1319\">Absent / Present</strong></p>\n</li>\n<li data-start=\"1322\" data-end=\"1371\">\n<p data-start=\"1324\" data-end=\"1371\">(e.g., Sharp waves/spikes over temporal region)</p>\n</li>\n</ul>\n</li>\n<li data-start=\"1372\" data-end=\"1474\">\n<p data-start=\"1374\" data-end=\"1413\"><strong data-start=\"1374\" data-end=\"1410\">Focal or Generalized Abnormality</strong>:</p>\n<ul data-start=\"1416\" data-end=\"1474\">\n<li data-start=\"1416\" data-end=\"1474\">\n<p data-start=\"1418\" data-end=\"1474\">(e.g., Generalized spike-wave discharges, focal slowing)</p>\n</li>\n</ul>\n</li>\n</ul>",
        "field": "textEditor"
      },
