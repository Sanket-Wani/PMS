  "interpretation": "<p data-start=\"1521\" data-end=\"1537\"><strong data-start=\"1523\" data-end=\"1537\">Normal EEG</strong></p>\n<ul data-start=\"1540\" data-end=\"1628\">\n<li data-start=\"1540\" data-end=\"1574\">\n<p data-start=\"1542\" data-end=\"1574\">No epileptiform activity seen.</p>\n</li>\n<li data-start=\"1577\" data-end=\"1625\">\n<p data-start=\"1579\" data-end=\"1625\">Normal background with expected sleep changes.</p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": null,
