      "data": {
        "value": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 9px;\"><strong>Embryo No.</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Embryo Type/Stage</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>PGS Result</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Chromosomal Findings</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Sex</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Remarks</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 9px;\">1</span></td>\n<td><span style=\"font-size: 9px;\">Blastocyst (Day 5)</span></td>\n<td><span style=\"font-size: 9px;\">Euploid</span></td>\n<td><span style=\"font-size: 9px;\">Normal chromosomal complement</span></td>\n<td><span style=\"font-size: 9px;\">Male</span></td>\n<td><span style=\"font-size: 9px;\">Suitable for transfer</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\">2</span></td>\n<td><span style=\"font-size: 9px;\">Blastocyst (Day 5)</span></td>\n<td><span style=\"font-size: 9px;\">Aneuploid</span></td>\n<td><span style=\"font-size: 9px;\">Trisomy 21</span></td>\n<td><span style=\"font-size: 9px;\">Female</span></td>\n<td><span style=\"font-size: 9px;\">Not suitable for transfer</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\">3</span></td>\n<td><span style=\"font-size: 9px;\">Blastocyst (Day 5)</span></td>\n<td><span style=\"font-size: 9px;\">Mosaic</span></td>\n<td><span style=\"font-size: 9px;\">Mosaic for Monosomy X</span></td>\n<td><span style=\"font-size: 9px;\">Female</span></td>\n<td><span style=\"font-size: 9px;\">Caution advised &ndash; clinical judgment needed</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\">4</span></td>\n<td><span style=\"font-size: 9px;\">Blastocyst (Day 6)</span></td>\n<td><span style=\"font-size: 9px;\">Euploid</span></td>\n<td><span style=\"font-size: 9px;\">Normal chromosomal complement</span></td>\n<td><span style=\"font-size: 9px;\">Male</span></td>\n<td><span style=\"font-size: 9px;\">Suitable for transfer</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"1860\" data-end=\"1881\"><span style=\"font-size: 9px;\"><strong data-start=\"1864\" data-end=\"1878\">Conclusion</strong>:</span></h3>\n<ul data-start=\"1882\" data-end=\"2048\">\n<li style=\"font-size: 9px;\" data-start=\"1882\" data-end=\"2048\">\n<p data-start=\"1884\" data-end=\"1910\"><span style=\"font-size: 9px;\">Out of 4 embryos tested:</span></p>\n<ul data-start=\"1913\" data-end=\"2048\">\n<li style=\"font-size: 9px;\" data-start=\"1913\" data-end=\"1961\">\n<p data-start=\"1915\" data-end=\"1961\"><span style=\"font-size: 9px;\"><strong data-start=\"1915\" data-end=\"1928\">2 Euploid</strong> &ndash; suitable for embryo transfer</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1964\" data-end=\"2001\">\n<p data-start=\"1966\" data-end=\"2001\"><span style=\"font-size: 9px;\"><strong data-start=\"1966\" data-end=\"1981\">1 Aneuploid</strong> &ndash; not recommended</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"2004\" data-end=\"2048\">\n<p data-start=\"2006\" data-end=\"2048\"><span style=\"font-size: 9px;\"><strong data-start=\"2006\" data-end=\"2018\">1 Mosaic</strong> &ndash; requires genetic counseling</span></p>\n</li>\n</ul>\n</li>\n</ul>",
