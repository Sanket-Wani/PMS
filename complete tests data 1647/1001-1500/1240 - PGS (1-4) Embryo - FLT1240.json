  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Result Type</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Meaning</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Euploid</span></td>\n<td><span style=\"font-size: 10px;\">Normal chromosomal number &ndash; preferred for implantation</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Aneuploid</span></td>\n<td><span style=\"font-size: 10px;\">Abnormal chromosome number &ndash; not recommended for use</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Mosaic</span></td>\n<td><span style=\"font-size: 10px;\">Mixed normal and abnormal cells &ndash; clinical discretion advised</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
