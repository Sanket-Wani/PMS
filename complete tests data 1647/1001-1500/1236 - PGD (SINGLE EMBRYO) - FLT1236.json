  "interpretation": "<ul>\n<li data-start=\"1784\" data-end=\"1940\">\n<p data-start=\"1786\" data-end=\"1816\"><span style=\"font-size: 11px;\"><strong data-start=\"1786\" data-end=\"1814\">Normal (Euploid) Embryo:</strong></span></p>\n<ul data-start=\"1819\" data-end=\"1940\">\n<li style=\"font-size: 11px;\" data-start=\"1819\" data-end=\"1883\">\n<p data-start=\"1821\" data-end=\"1883\"><span style=\"font-size: 11px;\">No chromosomal abnormalities or targeted mutations detected.</span></p>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"1886\" data-end=\"1940\">\n<p data-start=\"1888\" data-end=\"1940\"><span style=\"font-size: 11px;\">Suitable for transfer (pending clinical assessment).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"1942\" data-end=\"2117\">\n<p data-start=\"1944\" data-end=\"1988\"><span style=\"font-size: 11px;\"><strong data-start=\"1944\" data-end=\"1986\">Abnormal (Aneuploid / Mutated) Embryo:</strong></span></p>\n<ul data-start=\"1991\" data-end=\"2117\">\n<li style=\"font-size: 11px;\" data-start=\"1991\" data-end=\"2048\">\n<p data-start=\"1993\" data-end=\"2048\"><span style=\"font-size: 11px;\">Chromosomal abnormality or targeted mutation present.</span></p>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"2051\" data-end=\"2117\">\n<p data-start=\"2053\" data-end=\"2117\"><span style=\"font-size: 11px;\">Not recommended for transfer (unless specific exceptions apply).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"2119\" data-end=\"2288\">\n<p data-start=\"2121\" data-end=\"2138\"><span style=\"font-size: 11px;\"><strong data-start=\"2121\" data-end=\"2136\">Counseling:</strong></span></p>\n<ul data-start=\"2141\" data-end=\"2288\">\n<li style=\"font-size: 11px;\" data-start=\"2141\" data-end=\"2216\">\n<p data-start=\"2143\" data-end=\"2216\"><span style=\"font-size: 11px;\">Results must be interpreted with <strong data-start=\"2176\" data-end=\"2198\">genetic counseling</strong> for the couple.</span></p>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"2219\" data-end=\"2288\">\n<p data-start=\"2221\" data-end=\"2288\"><span style=\"font-size: 11px;\">Final decision on embryo transfer is <strong data-start=\"2258\" data-end=\"2287\">clinical + patient choice</strong>.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
