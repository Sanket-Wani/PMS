  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Gene</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Result</strong> (Variant Type)</span></th>\n<th><span style=\"font-size: 10px;\"><strong>What It Means</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Action/Advice</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">BRCA1</span></td>\n<td><span style=\"font-size: 10px;\">Pathogenic (Frameshift)</span></td>\n<td><span style=\"font-size: 10px;\">Strongly linked to increased breast &amp; ovarian cancer risk</span></td>\n<td><span style=\"font-size: 10px;\">Genetic counseling &amp; screening advised</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">BRCA2</span></td>\n<td><span style=\"font-size: 10px;\">Likely Pathogenic (Missense)</span></td>\n<td><span style=\"font-size: 10px;\">May increase risk for breast, ovarian, or prostate cancer</span></td>\n<td><span style=\"font-size: 10px;\">Further evaluation &amp; family testing needed</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">TP53</span></td>\n<td><span style=\"font-size: 10px;\">Pathogenic (Missense)</span></td>\n<td><span style=\"font-size: 10px;\">Associated with Li-Fraumeni syndrome and many types of early cancers</span></td>\n<td><span style=\"font-size: 10px;\">Close monitoring &amp; family counseling</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">PIK3CA</span></td>\n<td><span style=\"font-size: 10px;\">VUS (Uncertain significance)</span></td>\n<td><span style=\"font-size: 10px;\">Change found, but we don't yet know if it causes disease</span></td>\n<td><span style=\"font-size: 10px;\">No action now; monitor for new research</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
