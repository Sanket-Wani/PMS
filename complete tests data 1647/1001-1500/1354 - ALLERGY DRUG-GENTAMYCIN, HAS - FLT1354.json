  "interpretation": "<ul data-start=\"1415\" data-end=\"1907\">\n<li data-start=\"1415\" data-end=\"1498\">\n<p data-start=\"1417\" data-end=\"1446\"><span style=\"font-size: 10px;\"><strong data-start=\"1417\" data-end=\"1444\">Negative (&lt;0.35 kUA/L):</strong></span></p>\n<ul data-start=\"1449\" data-end=\"1498\">\n<li style=\"font-size: 10px;\" data-start=\"1449\" data-end=\"1498\">\n<p data-start=\"1451\" data-end=\"1498\"><span style=\"font-size: 10px;\">No evidence of IgE-mediated hypersensitivity.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1500\" data-end=\"1625\">\n<p data-start=\"1502\" data-end=\"1536\"><span style=\"font-size: 10px;\"><strong data-start=\"1502\" data-end=\"1534\">Equivocal (0.35&ndash;0.70 kUA/L):</strong></span></p>\n<ul data-start=\"1539\" data-end=\"1625\">\n<li style=\"font-size: 10px;\" data-start=\"1539\" data-end=\"1625\">\n<p data-start=\"1541\" data-end=\"1625\"><span style=\"font-size: 10px;\">Possible mild sensitization; recommend <strong data-start=\"1580\" data-end=\"1622\">clinical correlation or repeat testing</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1627\" data-end=\"1762\">\n<p data-start=\"1629\" data-end=\"1658\"><span style=\"font-size: 10px;\"><strong data-start=\"1629\" data-end=\"1656\">Positive (&gt;0.70 kUA/L):</strong></span></p>\n<ul data-start=\"1661\" data-end=\"1762\">\n<li style=\"font-size: 10px;\" data-start=\"1661\" data-end=\"1762\">\n<p data-start=\"1663\" data-end=\"1762\"><span style=\"font-size: 10px;\">Indicates <strong data-start=\"1673\" data-end=\"1704\">sensitization to Gentamicin</strong>; correlate with history (rash, urticaria, anaphylaxis).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1764\" data-end=\"1907\">\n<p data-start=\"1766\" data-end=\"1803\"><span style=\"font-size: 10px;\"><strong data-start=\"1766\" data-end=\"1801\">Strongly Positive (&gt;3.5 kUA/L):</strong></span></p>\n<ul data-start=\"1806\" data-end=\"1907\">\n<li style=\"font-size: 10px;\" data-start=\"1806\" data-end=\"1907\">\n<p data-start=\"1808\" data-end=\"1907\"><span style=\"font-size: 10px;\">High probability of clinical allergy; <strong data-start=\"1846\" data-end=\"1866\">avoid Gentamicin</strong> and refer to allergist for management.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
