        "value": "<table style=\"height: 176px; width: 96.4134%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 36.3859%;\"><strong>Parameter</strong></th>\n<th style=\"width: 18.163%;\"><strong>Result</strong></th>\n<th style=\"width: 40.6215%;\"><strong>Reference / Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3859%;\">IGHV Mutation Status</td>\n<td style=\"width: 18.163%;\">Mutated / Unmutated</td>\n<td style=\"width: 40.6215%;\">&gt;98% homology = <strong>Unmutated</strong>&lt;98% = <strong>Mutated</strong></td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3859%;\">% Homology with Germline</td>\n<td style=\"width: 18.163%;\">e.g., 95.2%</td>\n<td style=\"width: 40.6215%;\">Cut-off: 98%</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3859%;\">Dominant Clonal Rearrangement Detected</td>\n<td style=\"width: 18.163%;\">Yes / No</td>\n<td style=\"width: 40.6215%;\">Indicates clonal B-cell population</td>\n</tr>\n<tr style=\"height: 37px;\">\n<td style=\"width: 36.3859%;\">IGHV Gene Segment</td>\n<td style=\"width: 18.163%;\">e.g., IGHV3-23</td>\n<td style=\"width: 40.6215%;\">Informative for prognosis</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
