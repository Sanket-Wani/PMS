  "name": "NERVE CONDUCTION VELOCITY (NCV) +SSR 2 LIMBS",
  "code": "2558",
  "cost": 0,
  "interpretation": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\"><strong>Result Category</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Description</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Normal</span></td>\n<td><span style=\"font-size: 10px;\">All conduction velocities, amplitudes, latencies, and SSR are within reference limits.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Peripheral Neuropathy</span></td>\n<td><span style=\"font-size: 10px;\">Reduced velocities/amplitudes, prolonged latencies, absent SSR; suggestive of neuropathy.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Demyelinating Neuropathy</span></td>\n<td><span style=\"font-size: 10px;\">Markedly slowed conduction, prolonged F-wave/H-reflex; conduction block may be present.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Axonal Neuropathy</span></td>\n<td><span style=\"font-size: 10px;\">Reduced amplitudes with relatively preserved velocities; SSR may be absent.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Autonomic Dysfunction</span></td>\n<td><span style=\"font-size: 10px;\">SSR absent or significantly delayed despite near-normal NCV.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
