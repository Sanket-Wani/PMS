  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>IgE Value (kU/L)</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Allergy Class</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Clinical Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">&lt; 0.35</span></td>\n<td><span style=\"font-size: 10px;\">Class 0</span></td>\n<td><span style=\"font-size: 10px;\">Negative</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">0.35 &ndash; 0.70</span></td>\n<td><span style=\"font-size: 10px;\">Class 1</span></td>\n<td><span style=\"font-size: 10px;\">Borderline / Low Sensitization</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">0.71 &ndash; 3.50</span></td>\n<td><span style=\"font-size: 10px;\">Class 2</span></td>\n<td><span style=\"font-size: 10px;\">Moderate Sensitization</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">3.51 &ndash; 17.50</span></td>\n<td><span style=\"font-size: 10px;\">Class 3</span></td>\n<td><span style=\"font-size: 10px;\">High Sensitization</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">17.51 &ndash; 50.00</span></td>\n<td><span style=\"font-size: 10px;\">Class 4</span></td>\n<td><span style=\"font-size: 10px;\">Very High Sensitization</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">50.01 &ndash; 100.00</span></td>\n<td><span style=\"font-size: 10px;\">Class 5</span></td>\n<td><span style=\"font-size: 10px;\">Strong Positive</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">&gt;100.00</span></td>\n<td><span style=\"font-size: 10px;\">Class 6</span></td>\n<td><span style=\"font-size: 10px;\">Extremely High Sensitization</span></td>\n</tr>\n</tbody>\n</table>\n<h3 data-start=\"2083\" data-end=\"2107\"><span style=\"font-size: 10px;\"><strong data-start=\"2087\" data-end=\"2107\">Final Impression</strong></span></h3>\n<ul data-start=\"2109\" data-end=\"2350\">\n<li style=\"font-size: 10px;\" data-start=\"2109\" data-end=\"2259\">\n<p data-start=\"2111\" data-end=\"2259\"><span style=\"font-size: 10px;\"><strong data-start=\"2111\" data-end=\"2123\">Positive</strong> results indicate <strong data-start=\"2141\" data-end=\"2178\">sensitization to Candida albicans</strong>, which may be associated with respiratory allergy, atopic dermatitis, or asthma.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2260\" data-end=\"2350\">\n<p data-start=\"2262\" data-end=\"2350\"><span style=\"font-size: 10px;\"><strong data-start=\"2262\" data-end=\"2274\">Negative</strong> results do not rule out non-IgE mediated allergy or other fungal allergen</span></p>\n</li>\n</ul>",
