  "name": "ALPHA THALASSEMIA MUTATION DETECTION - PCR SEQUENCING (HBA1/HBA2)",
  "code": "2263",
  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Category</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">No Mutation Detected</span></td>\n<td><span style=\"font-size: 10px;\">No pathogenic variants detected in HBA1/HBA2 &ndash; unlikely carrier status</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Pathogenic Mutation Detected</span></td>\n<td><span style=\"font-size: 10px;\">Alpha thalassemia carrier or affected individual depending on zygosity</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Compound Heterozygous Mutations</span></td>\n<td><span style=\"font-size: 10px;\">Suggests HbH disease (moderate alpha-thalassemia)</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Homozygous / Double Deletion</span></td>\n<td><span style=\"font-size: 10px;\">Suggests Hydrops Fetalis (severe alpha-thalassemia)</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"2972\" data-end=\"2987\"><span style=\"font-size: 10px;\"><strong data-start=\"2976\" data-end=\"2987\">Remarks</strong></span></h3>\n<ul data-start=\"2989\" data-end=\"3299\">\n<li style=\"font-size: 10px;\" data-start=\"2989\" data-end=\"3072\">\n<p data-start=\"2991\" data-end=\"3072\"><span style=\"font-size: 10px;\">Genetic counseling is strongly recommended for carriers and affected individuals.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3073\" data-end=\"3109\">\n<p data-start=\"3075\" data-end=\"3109\"><span style=\"font-size: 10px;\">Family screening may be indicated.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3110\" data-end=\"3229\">\n<p data-start=\"3112\" data-end=\"3229\"><span style=\"font-size: 10px;\">PCR-based sequencing does not detect large deletions; MLPA or Gap-PCR may be needed for deletional alpha-thalassemia.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3230\" data-end=\"3299\">\n<p data-start=\"3232\" data-end=\"3299\"><span style=\"font-size: 10px;\">Clinical correlation with CBC, HPLC, and iron studies is essential</span></p>\n</li>\n</ul>",
