  "name": "HLA PRA SCREENING (C CLASS I & II) PANEL REACTIVE ANTIBODY",
  "code": "2390",
  "cost": 0,
  "interpretation": "<p data-start=\"562\" data-end=\"620\"><span style=\"font-size: 9px;\"><strong data-start=\"562\" data-end=\"576\">Method:</strong></span><br data-start=\"576\" data-end=\"579\"><span style=\"font-size: 9px;\">Luminex / Flow Cytometry based bead assay</span></p>\n<p data-start=\"622\" data-end=\"646\"><span style=\"font-size: 9px;\"><strong data-start=\"622\" data-end=\"644\">&nbsp;Interpretation:</strong></span></p>\n<ul data-start=\"647\" data-end=\"1095\">\n<li style=\"font-size: 9px;\" data-start=\"647\" data-end=\"758\">\n<p data-start=\"649\" data-end=\"758\"><span style=\"font-size: 9px;\"><strong data-start=\"649\" data-end=\"684\">PRA (Panel Reactive Antibodies)</strong> assess the level of preformed antibodies against a panel of HLA antigens.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"759\" data-end=\"881\">\n<p data-start=\"761\" data-end=\"881\"><span style=\"font-size: 9px;\">A <strong data-start=\"763\" data-end=\"784\">higher percentage</strong> indicates <strong data-start=\"795\" data-end=\"822\">increased sensitization</strong> and <strong data-start=\"827\" data-end=\"852\">reduced compatibility</strong> with potential organ donors.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"882\" data-end=\"955\">\n<p data-start=\"884\" data-end=\"955\"><span style=\"font-size: 9px;\">Useful in <strong data-start=\"894\" data-end=\"919\">transplant evaluation</strong>, especially kidney and bone marrow.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"956\" data-end=\"1049\">\n<p data-start=\"958\" data-end=\"1049\"><span style=\"font-size: 9px;\"><strong data-start=\"958\" data-end=\"970\">&gt;20% PRA</strong> suggests <strong data-start=\"980\" data-end=\"997\">sensitization</strong> due to prior transfusion, transplant, or pregnancy.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1050\" data-end=\"1095\">\n<p data-start=\"1052\" data-end=\"1095\"><span style=\"font-size: 9px;\">Helps in assessing risk of graft rejection.</span></p>\n</li>\n</ul>",
