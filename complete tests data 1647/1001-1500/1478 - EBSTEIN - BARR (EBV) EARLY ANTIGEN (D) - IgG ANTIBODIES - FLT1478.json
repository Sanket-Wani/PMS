  "name": "EBSTEIN - BARR (EBV) EARLY ANTIGEN (D) - IgG ANTIBODIES",
  "code": "2725",
  "cost": 0,
  "interpretation": "<p data-start=\"68\" data-end=\"352\">The <strong data-start=\"72\" data-end=\"109\">EBV Early Antigen (EA-D) IgG test</strong> detects <strong data-start=\"118\" data-end=\"136\">IgG antibodies</strong> to the <strong data-start=\"144\" data-end=\"163\">early D antigen</strong> of <strong data-start=\"167\" data-end=\"195\">Epstein-Barr Virus (EBV)</strong>. It is primarily used to assess <strong data-start=\"228\" data-end=\"267\">recent or reactivated EBV infection</strong>, especially in combination with other EBV markers (like VCA IgM, VCA IgG, EBNA IgG).</p>\n<p data-start=\"68\" data-end=\"352\"><strong>Understanding EBV Antibody Timeline :</strong></p>\n<table>\n<thead>\n<tr>\n<th><strong>Antibody</strong></th>\n<th><strong>Appears</strong></th>\n<th><strong>Indicates</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>VCA IgM</strong></td>\n<td>Early</td>\n<td>Acute infection</td>\n</tr>\n<tr>\n<td><strong>VCA IgG</strong></td>\n<td>Early</td>\n<td>Acute and past infection</td>\n</tr>\n<tr>\n<td><strong>EA-D IgG</strong></td>\n<td>Early</td>\n<td>Recent infection or reactivation</td>\n</tr>\n<tr>\n<td><strong>EBNA IgG</strong></td>\n<td>Late</td>\n<td>Past infection (not seen in acute phase)</td>\n</tr>\n</tbody>\n</table>\n<p data-start=\"68\" data-end=\"352\">&nbsp;</p>\n<p data-start=\"68\" data-end=\"352\">Common Clinical Scenarios</p>\n<p data-start=\"68\" data-end=\"352\">&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th><strong>VCA IgM</strong></th>\n<th><strong>VCA IgG</strong></th>\n<th><strong>EA-D IgG</strong></th>\n<th><strong>EBNA IgG</strong></th>\n<th><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>+</td>\n<td>+</td>\n<td>+</td>\n<td>-</td>\n<td><strong>Acute primary EBV infection</strong></td>\n</tr>\n<tr>\n<td>-</td>\n<td>+</td>\n<td>-</td>\n<td>+</td>\n<td><strong>Past infection, resolved</strong></td>\n</tr>\n<tr>\n<td>-</td>\n<td>+</td>\n<td>+</td>\n<td>+</td>\n<td><strong>Possible reactivation or chronic EBV</strong></td>\n</tr>\n<tr>\n<td>-</td>\n<td>-</td>\n<td>-</td>\n<td>-</td>\n<td>No evidence of past or present EBV infection</td>\n</tr>\n</tbody>\n</table>\n<p data-start=\"68\" data-end=\"352\">&nbsp;</p>",
