  "name": "FOOD INTOLERANCE - DAIRY ITEMS",
  "code": "2740",
  "cost": 0,
  "interpretation": "<ul data-start=\"2301\" data-end=\"2620\">\n<li data-start=\"2301\" data-end=\"2395\">\n<p data-start=\"2303\" data-end=\"2395\"><strong data-start=\"2303\" data-end=\"2322\">High IgG levels</strong> may indicate sensitivity or delayed intolerance to that dairy product.</p>\n</li>\n<li data-start=\"2396\" data-end=\"2517\">\n<p data-start=\"2398\" data-end=\"2517\"><strong data-start=\"2398\" data-end=\"2421\">Dietary elimination</strong> of high-reactive items may improve symptoms such as bloating, indigestion, or skin reactions.</p>\n</li>\n<li data-start=\"2518\" data-end=\"2620\">\n<p data-start=\"2520\" data-end=\"2620\">This is <strong data-start=\"2528\" data-end=\"2567\">not a diagnostic allergy (IgE) test</strong> and should be interpreted with clinical correlation.</p>\n</li>\n<li data-start=\"2518\" data-end=\"2620\">\n<p data-start=\"2520\" data-end=\"2620\">IgG food intolerance testing reflects possible immune response, not immediate hypersensitivity.</p>\n</li>\n</ul>",
