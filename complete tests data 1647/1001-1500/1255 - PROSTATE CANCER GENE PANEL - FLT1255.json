  "interpretation": "<ul data-start=\"1071\" data-end=\"1321\">\n<li data-start=\"1071\" data-end=\"1238\">\n<p data-start=\"1073\" data-end=\"1238\"><span style=\"font-size: 9px;\"><strong data-start=\"1073\" data-end=\"1117\">Pathogenic or likely pathogenic variants</strong> in genes such as <strong data-start=\"1135\" data-end=\"1174\">BRCA1, BRCA2, ATM, CHEK2, or HOXB13</strong> may indicate <strong data-start=\"1188\" data-end=\"1217\">increased hereditary risk</strong> for prostate cancer.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1239\" data-end=\"1321\">\n<p data-start=\"1241\" data-end=\"1321\"><span style=\"font-size: 9px;\">Helps guide <strong data-start=\"1253\" data-end=\"1278\">therapeutic decisions</strong>, including <strong data-start=\"1290\" data-end=\"1320\">PARP inhibitor eligibility</strong>.</span></p>\n</li>\n</ul>\n<h3 data-start=\"1328\" data-end=\"1356\"><span style=\"font-size: 9px;\"><strong data-start=\"1335\" data-end=\"1356\">Clinical Utility:</strong></span></h3>\n<ul data-start=\"1358\" data-end=\"1627\">\n<li style=\"font-size: 9px;\" data-start=\"1358\" data-end=\"1415\">\n<p data-start=\"1360\" data-end=\"1415\"><span style=\"font-size: 9px;\">Assesses <strong data-start=\"1369\" data-end=\"1395\">genetic predisposition</strong> to prostate cancer.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1416\" data-end=\"1574\">\n<p data-start=\"1418\" data-end=\"1440\"><span style=\"font-size: 9px;\">Important in cases of:</span></p>\n<ul data-start=\"1443\" data-end=\"1574\">\n<li style=\"font-size: 9px;\" data-start=\"1443\" data-end=\"1472\">\n<p data-start=\"1445\" data-end=\"1472\"><span style=\"font-size: 9px;\">Early onset prostate cancer</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1475\" data-end=\"1537\">\n<p data-start=\"1477\" data-end=\"1537\"><span style=\"font-size: 9px;\">Strong family history of prostate, breast, or ovarian cancer</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1540\" data-end=\"1574\">\n<p data-start=\"1542\" data-end=\"1574\"><span style=\"font-size: 9px;\">Aggressive or metastatic disease</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1575\" data-end=\"1627\">\n<p data-start=\"1577\" data-end=\"1627\"><span style=\"font-size: 9px;\">Aids in family counseling and <strong data-start=\"1607\" data-end=\"1626\">cascade testing</strong>.</span></p>\n</li>\n</ul>",
