 of TST</span></td>\n<td data-start=\"1442\" data-end=\"1513\" data-col-size=\"md\"><span style=\"font-size: 10px;\">5&ndash;10%</span></td>\n</tr>\n<tr data-start=\"1514\" data-end=\"1673\">\n<td data-start=\"1514\" data-end=\"1562\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">Stage N2 Sleep</span></td>\n<td data-start=\"1562\" data-end=\"1585\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">____</span></td>\n<td data-start=\"1585\" data-end=\"1602\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">% of TST</span></td>\n<td data-start=\"1602\" data-end=\"1673\" data-col-size=\"md\"><span style=\"font-size: 10px;\">45&ndash;55%</span></td>\n</tr>\n<tr data-start=\"1674\" data-end=\"1833\">\n<td data-start=\"1674\" data-end=\"1722\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">Stage N3 (Slow-Wave) Sleep</span></td>\n<td data-start=\"1722\" data-end=\"1745\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">____</span></td>\n<td data-start=\"1745\" data-end=\"1762\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">% of TST</span></td>\n<td data-start=\"1762\" data-end=\"1833\" data-col-size=\"md\"><span style=\"font-size: 10px;\">15&ndash;20%</span></td>\n</tr>\n<tr data-start=\"1834\" data-end=\"1993\">\n<td data-start=\"1834\" data-end=\"1882\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">REM Sleep</span></td>\n<td data-start=\"1882\" data-end=\"1905\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">____</span></td>\n<td data-start=\"1905\" data-end=\"1922\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">% of TST</span></td>\n<td data-start=\"1922\" data-end=\"1993\" data-col-size=\"md\"><span style=\"font-size: 10px;\">20&ndash;25%</span></td>\n</tr>\n<tr data-start=\"1994\" data-end=\"2154\">\n<td data-start=\"1994\" data-end=\"2042\" data-col-size=\"sm\"><span style=\"font-size: 10px;\">Apnea-Hypopnea Index (AHI)</span></td>\n<td data-start=\"2042\" data-end=\"2065\" data-col-size=\"sm\"><span style=\"