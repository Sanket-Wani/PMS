        "value": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>STR Marker</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Donor Alleles</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Recipient Alleles</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>% Donor DNA</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>% Recipient DNA</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">D3S1358</span></td>\n<td><span style=\"font-size: 10px;\">16, 17</span></td>\n<td><span style=\"font-size: 10px;\">14, 16</span></td>\n<td><span style=\"font-size: 10px;\">95%</span></td>\n<td><span style=\"font-size: 10px;\">5%</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">D21S11</span></td>\n<td><span style=\"font-size: 10px;\">29, 31</span></td>\n<td><span style=\"font-size: 10px;\">30, 32.2</span></td>\n<td><span style=\"font-size: 10px;\">100%</span></td>\n<td><span style=\"font-size: 10px;\">0%</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">FGA</span></td>\n<td><span style=\"font-size: 10px;\">23, 24</span></td>\n<td><span style=\"font-size: 10px;\">22, 25</span></td>\n<td><span style=\"font-size: 10px;\">98%</span></td>\n<td><span style=\"font-size: 10px;\">2%</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
