  "interpretation": "<table class=\"w-fit min-w-(--thread-content-width)\" style=\"width: 99.9731%;\" data-start=\"248\" data-end=\"1349\">\n<thead data-start=\"248\" data-end=\"400\">\n<tr data-start=\"248\" data-end=\"400\">\n<th style=\"width: 14.1194%;\" data-start=\"248\" data-end=\"270\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Type</span></th>\n<th style=\"width: 18.5929%;\" data-start=\"270\" data-end=\"291\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Appearance</span></th>\n<th style=\"width: 15.3776%;\" data-start=\"291\" data-end=\"314\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">WBC Count (/mm&sup3;)</span></th>\n<th style=\"width: 14.5388%;\" data-start=\"314\" data-end=\"336\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Neutrophils (%)</span></th>\n<th style=\"width: 14.5388%;\" data-start=\"336\" data-end=\"357\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Glucose</span></th>\n<th style=\"width: 22.9266%;\" data-start=\"357\" data-end=\"400\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Interpretation</span></th>\n</tr>\n</thead>\n<tbody data-start=\"559\" data-end=\"1349\">\n<tr data-start=\"559\" data-end=\"716\">\n<td style=\"width: 14.1194%;\" data-start=\"559\" data-end=\"581\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Normal</span></td>\n<td style=\"width: 18.5929%;\" data-col-size=\"sm\" data-start=\"581\" data-end=\"605\"><span style=\"font-size: 9px;\">Clear, high viscosity</span></td>\n<td style=\"width: 15.3776%;\" data-col-size=\"sm\" data-start=\"605\" data-end=\"627\"><span style=\"font-size: 9px;\">&lt; 200</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"627\" data-end=\"649\"><span style=\"font-size: 9px;\">&lt; 25%</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"649\" data-end=\"671\"><span style=\"font-size: 9px;\">Equal to serum</span></td>\n<td style=\"width: 22.9266%;\" data-col-size=\"sm\" data-start=\"671\" data-end=\"716\"><span style=\"font-size: 9px;\">Normal synovial fluid</span></td>\n</tr>\n<tr data-start=\"717\" data-end=\"874\">\n<td style=\"width: 14.1194%;\" data-start=\"717\" data-end=\"739\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Non-inflammatory</span></td>\n<td style=\"width: 18.5929%;\" data-col-size=\"sm\" data-start=\"739\" data-end=\"763\"><span style=\"font-size: 9px;\">Clear, high viscosity</span></td>\n<td style=\"width: 15.3776%;\" data-col-size=\"sm\" data-start=\"763\" data-end=\"785\"><span style=\"font-size: 9px;\">&lt; 2,000</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"785\" data-end=\"807\"><span style=\"font-size: 9px;\">&lt; 25%</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"807\" data-end=\"829\"><span style=\"font-size: 9px;\">Normal</span></td>\n<td style=\"width: 22.9266%;\" data-col-size=\"sm\" data-start=\"829\" data-end=\"874\"><span style=\"font-size: 9px;\">Osteoarthritis, trauma</span></td>\n</tr>\n<tr data-start=\"875\" data-end=\"1032\">\n<td style=\"width: 14.1194%;\" data-start=\"875\" data-end=\"897\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Inflammatory</span></td>\n<td style=\"width: 18.5929%;\" data-col-size=\"sm\" data-start=\"897\" data-end=\"921\"><span style=\"font-size: 9px;\">Cloudy, low viscosity</span></td>\n<td style=\"width: 15.3776%;\" data-col-size=\"sm\" data-start=\"921\" data-end=\"943\"><span style=\"font-size: 9px;\">2,000-75,000</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"943\" data-end=\"965\"><span style=\"font-size: 9px;\">&gt; 50%</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"965\" data-end=\"987\"><span style=\"font-size: 9px;\">mild to moderate</span></td>\n<td style=\"width: 22.9266%;\" data-col-size=\"sm\" data-start=\"987\" data-end=\"1032\"><span style=\"font-size: 9px;\">Rheumatoid arthritis, gout, lupus</span></td>\n</tr>\n<tr data-start=\"1033\" data-end=\"1190\">\n<td style=\"width: 14.1194%;\" data-start=\"1033\" data-end=\"1055\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Septic</span></td>\n<td style=\"width: 18.5929%;\" data-col-size=\"sm\" data-start=\"1055\" data-end=\"1079\"><span style=\"font-size: 9px;\">Turbid/purulent</span></td>\n<td style=\"width: 15.3776%;\" data-col-size=\"sm\" data-start=\"1079\" data-end=\"1101\"><span style=\"font-size: 9px;\">&gt; 50,000-100,000+</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"1101\" data-end=\"1123\"><span style=\"font-size: 9px;\">&gt; 75%</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"1123\" data-end=\"1145\"><span style=\"font-size: 9px;\">very low</span></td>\n<td style=\"width: 22.9266%;\" data-col-size=\"sm\" data-start=\"1145\" data-end=\"1190\"><span style=\"font-size: 9px;\">Bacterial septic arthritis</span></td>\n</tr>\n<tr data-start=\"1191\" data-end=\"1349\">\n<td style=\"width: 14.1194%;\" data-start=\"1191\" data-end=\"1213\" data-col-size=\"sm\"><span style=\"font-size: 9px;\">Hemorrhagic</span></td>\n<td style=\"width: 18.5929%;\" data-col-size=\"sm\" data-start=\"1213\" data-end=\"1237\"><span style=\"font-size: 9px;\">Bloody</span></td>\n<td style=\"width: 15.3776%;\" data-col-size=\"sm\" data-start=\"1237\" data-end=\"1260\"><span style=\"font-size: 9px;\">Variable</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"1260\" data-end=\"1282\"><span style=\"font-size: 9px;\">Variable</span></td>\n<td style=\"width: 14.5388%;\" data-col-size=\"sm\" data-start=\"1282\" data-end=\"1304\"><span style=\"font-size: 9px;\">Normal</span></td>\n<td style=\"width: 22.9266%;\" data-col-size=\"sm\" data-start=\"1304\" data-end=\"1349\"><span style=\"font-size: 9px;\">Trauma, hemophilia, anticoagulant use</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
