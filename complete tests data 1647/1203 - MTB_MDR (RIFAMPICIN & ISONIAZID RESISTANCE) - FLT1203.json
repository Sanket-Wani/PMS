  "name": "MTB/MDR (RIFAMPICIN & ISONIAZID RESISTANCE)",
  "code": "2441",
  "cost": 0,
  "interpretation": "<ul class=\"marker:text-textOff list-disc\">\n<li>\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Detection of MTB means presence of tuberculosis infection.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Rifampicin and Isoniazid resistance \"Detected\" indicates MDR-TB.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Negative results decrease the likelihood of MDR-TB but clinical correlation is necessary.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">\"Indeterminate\" or \"Error\" results require further clinical and laboratory review.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Always correlate with clinical, radiological, and other laboratory findings</span></p>\n</li>\n</ul>",
