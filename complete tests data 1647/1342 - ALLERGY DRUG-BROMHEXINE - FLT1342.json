  "interpretation": "<table style=\"height: 271px; width: 89.2193%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 33.7305%;\"><strong>IgE Value (kU/L)</strong></th>\n<th style=\"width: 12.5716%;\"><strong>Class</strong></th>\n<th style=\"width: 46.8684%;\"><strong>Allergy Reaction Level</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">&lt; 0.35</td>\n<td style=\"width: 12.5716%;\">0</td>\n<td style=\"width: 46.8684%;\">Negative</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">0.35 &ndash; 0.70</td>\n<td style=\"width: 12.5716%;\">1</td>\n<td style=\"width: 46.8684%;\">Low</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">0.71 &ndash; 3.50</td>\n<td style=\"width: 12.5716%;\">2</td>\n<td style=\"width: 46.8684%;\">Moderate</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">3.51 &ndash; 17.50</td>\n<td style=\"width: 12.5716%;\">3</td>\n<td style=\"width: 46.8684%;\">High</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">17.51 &ndash; 50.00</td>\n<td style=\"width: 12.5716%;\">4</td>\n<td style=\"width: 46.8684%;\">Very High</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 33.7305%;\">50.01 &ndash; 100.00</td>\n<td style=\"width: 12.5716%;\">5</td>\n<td style=\"width: 46.8684%;\">Strong</td>\n</tr>\n<tr style=\"height: 39px;\">\n<td style=\"width: 33.7305%;\">&gt; 100.00</td>\n<td style=\"width: 12.5716%;\">6</td>\n<td style=\"width: 46.8684%;\">Extremely Strong</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<ul data-start=\"1335\" data-end=\"1586\">\n<li data-start=\"1335\" data-end=\"1396\">\n<p data-start=\"1337\" data-end=\"1396\"><strong data-start=\"1337\" data-end=\"1363\">Negative (&lt; 0.35 kU/L)</strong>: No sensitization to Bromhexine.</p>\n</li>\n<li data-start=\"1397\" data-end=\"1586\">\n<p data-start=\"1399\" data-end=\"1532\"><strong data-start=\"1399\" data-end=\"1425\">Positive (&gt;= 0.35 kU/L)</strong>: Indicates presence of <strong data-start=\"1449\" data-end=\"1470\">drug-specific IgE</strong>. Correlate clinically for hypersensitivity reactions such as:</p>\n<ul data-start=\"1535\" data-end=\"1586\">\n<li data-start=\"1535\" data-end=\"1546\">\n<p data-start=\"1537\" data-end=\"1546\">Skin rash</p>\n</li>\n<li data-start=\"1549\" data-end=\"1563\">\n<p data-start=\"1551\" data-end=\"1563\">Bronchospasm</p>\n</li>\n<li data-start=\"1566\" data-end=\"1586\">\n<p data-start=\"1568\" data-end=\"1586\">Anaphylaxis (rare)</p>\n</li>\n</ul>\n</li>\n</ul>",
