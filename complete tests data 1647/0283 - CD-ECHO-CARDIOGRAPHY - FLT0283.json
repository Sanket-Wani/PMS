  "name": "CD-ECHO-CARDIOGRAPHY",
  "code": "CD ECHO",
  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><strong>Parameter</strong></th>\n<th><strong>Normal Finding</strong></th>\n<th><strong>Abnormal Finding</strong></th>\n<th><strong>Clinical Significance</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>Cardiac Chambers (RA, RV, LA, LV)</strong></td>\n<td>Normal size and wall thickness</td>\n<td>Chamber enlargement, hypertrophy</td>\n<td>Seen in cardiomyopathy, valvular heart disease, pulmonary hypertension, congenital heart disease</td>\n</tr>\n<tr>\n<td><strong>Cardiac Valves (Mitral, Aortic, Tricuspid, Pulmonary)</strong></td>\n<td>Normal opening and closure, no regurgitation or stenosis</td>\n<td>Stenosis (narrowing), regurgitation (backflow), prolapse</td>\n<td>Causes murmurs, heart failure, arrhythmias, infective endocarditis</td>\n</tr>\n<tr>\n<td><strong>Left Ventricular Function (EF%)</strong></td>\n<td>Normal EF = 55&ndash;70%</td>\n<td>Reduced EF (&lt;50%) &rarr; systolic dysfunction; Increased EF (&gt;75%) &rarr; hyperdynamic circulation</td>\n<td>Assesses heart failure, cardiomyopathy, ischemic heart disease</td>\n</tr>\n<tr>\n<td><strong>Interventricular Septum / Interatrial Septum</strong></td>\n<td>Intact</td>\n<td>Defect (ASD, VSD) with abnormal shunt flow</td>\n<td>Congenital heart disease</td>\n</tr>\n<tr>\n<td><strong>Pericardium</strong></td>\n<td>No effusion, normal appearance</td>\n<td>Pericardial effusion, thickening, constriction</td>\n<td>Seen in pericarditis, tamponade</td>\n</tr>\n<tr>\n<td><strong>Pulmonary Artery Pressure (PAP)</strong></td>\n<td>Normal &lt;25 mmHg (at rest)</td>\n<td>Elevated PAP &gt;25 mmHg</td>\n<td>Indicates pulmonary hypertension</td>\n</tr>\n<tr>\n<td><strong>Color Doppler Flow Mapping</strong></td>\n<td>Normal unidirectional laminar flow</td>\n<td>Turbulent flow, abnormal jets</td>\n<td>Suggests regurgitation, stenosis, shunt lesions</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
