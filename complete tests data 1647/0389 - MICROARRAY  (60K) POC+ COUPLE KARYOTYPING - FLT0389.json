  "cost": 0,
  "interpretation": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\"><strong>Result Category</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Description</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Normal POC &amp; Parental Karyotype</span></td>\n<td><span style=\"font-size: 10px;\">No chromosomal abnormality; suggests non-genetic cause of pregnancy loss (though other etiologies may exist).</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Abnormal POC (Aneuploidy/CNV)</span></td>\n<td><span style=\"font-size: 10px;\">Chromosomal abnormality explains pregnancy loss; recurrence risk depends on parental karyotype.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Balanced Parental Rearrangement</span></td>\n<td><span style=\"font-size: 10px;\">Parent carries balanced translocation/inversion; increases recurrence risk; genetic counseling and IVF with PGT may be discussed.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Variant of Uncertain Significance (VUS)</span></td>\n<td><span style=\"font-size: 10px;\">Detected CNV with unclear impact; parental inheritance testing and literature review recommended.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
