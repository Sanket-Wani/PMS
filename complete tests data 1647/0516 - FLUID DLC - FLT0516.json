  "name": "FLUID DLC",
  "code": "1553",
  "cost": 0,
  "interpretation": "<p data-start=\"94\" data-end=\"406\">Fluid DLC is performed on body fluids like pleural, peritoneal (ascitic), pericardial, or cerebrospinal fluid to determine the types and percentages of white blood cells present. This helps differentiate between infectious, inflammatory, or malignant causes of fluid accumulation.</p>\n<table>\n<thead>\n<tr>\n<th>Cell Type</th>\n<th>Normal Range in Fluids</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Neutrophils</td>\n<td>&lt; 25%</td>\n</tr>\n<tr>\n<td>Lymphocytes</td>\n<td>&gt; 50%</td>\n</tr>\n<tr>\n<td>Monocytes/Macrophages</td>\n<td>Variable</td>\n</tr>\n<tr>\n<td>Eosinophils</td>\n<td>&lt; 5%</td>\n</tr>\n<tr>\n<td>Basophils</td>\n<td>Rare</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th>Predominant Cells</th>\n<th>Possible Indication</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Neutrophils</td>\n<td>Acute bacterial infection, empyema, early TB</td>\n</tr>\n<tr>\n<td>Lymphocytes</td>\n<td>Tuberculosis, viral infection, malignancy, chronic inflammation</td>\n</tr>\n<tr>\n<td>Eosinophils</td>\n<td>Parasitic infection, drug reaction, air/blood in cavity</td>\n</tr>\n<tr>\n<td>Macrophages</td>\n<td>Chronic inflammation, resolving infection, malignancy</td>\n</tr>\n<tr>\n<td>Mesothelial Cells</td>\n<td>Reactive/inflammatory changes or malignancy (usually reported separately)</td>\n</tr>\n</tbody>\n</table>\n<p data-start=\"1469\" data-end=\"1495\"><strong data-start=\"1473\" data-end=\"1495\">Example Scenarios:</strong></p>\n<ul data-start=\"1497\" data-end=\"1745\">\n<li data-start=\"1497\" data-end=\"1572\">\n<p data-start=\"1499\" data-end=\"1572\"><strong data-start=\"1499\" data-end=\"1539\">Pleural fluid with &gt; 70% neutrophils</strong> : Suggests <strong data-start=\"1551\" data-end=\"1572\">bacterial empyema</strong></p>\n</li>\n<li data-start=\"1573\" data-end=\"1660\">\n<p data-start=\"1575\" data-end=\"1660\"><strong data-start=\"1575\" data-end=\"1621\">Ascitic fluid with predominant lymphocytes</strong> : Consider <strong data-start=\"1633\" data-end=\"1660\">tuberculous peritonitis</strong></p>\n</li>\n<li data-start=\"1661\" data-end=\"1745\">\n<p data-start=\"1663\" data-end=\"1745\"><strong data-start=\"1663\" data-end=\"1692\">CSF with high lymphocytes</strong> : Could indicate <strong data-start=\"1710\" data-end=\"1745\">viral or tuberculous meningitis</strong></p>\n</li>\n</ul>\n<hr data-start=\"1747\" data-end=\"1750\">\n<h3 data-start=\"1752\" data-end=\"1776\">&nbsp;</h3>\n<div role=\"presentation\">&nbsp;</div>",
