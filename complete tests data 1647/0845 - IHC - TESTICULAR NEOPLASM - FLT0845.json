        "value": "<table style=\"height: 452px; width: 97.4238%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 12.6908%;\"><strong>Marker</strong></th>\n<th style=\"width: 17.3836%;\"><strong>Result</strong></th>\n<th style=\"width: 25.2072%;\"><strong>Staining Pattern</strong></th>\n<th style=\"width: 38.2565%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">PLAP</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Membranous / Cytoplasmic</td>\n<td style=\"width: 38.2565%;\">Marker for Germ Cell Tumor (Seminoma)</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">OCT3/4</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Nuclear</td>\n<td style=\"width: 38.2565%;\">Germ Cell Tumors (Seminoma, EC)</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">SALL4</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Nuclear</td>\n<td style=\"width: 38.2565%;\">Germ Cell Origin</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">CD117 (c-Kit)</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Membranous</td>\n<td style=\"width: 38.2565%;\">Seminoma</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">CK (PanCK)</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Cytoplasmic</td>\n<td style=\"width: 38.2565%;\">Epithelial / Embryonal CA</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">CD30</td>\n<td style=\"width: 17.3836%;\">Positive / Negative</td>\n<td style=\"width: 25.2072%;\">Membranous/Cytoplasmic</td>\n<td style=\"width: 38.2565%;\">Embryonal Carcinoma</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 12.6908%;\">AFP</td>\n<td style=\"width: 17.3836