  "name": "NERVE CONDUCTION VELOCITY (NCV) +SSR UPPER LIMPS",
  "code": "2561",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"2591\" data-end=\"2783\">\n<p data-start=\"2593\" data-end=\"2616\"><span style=\"font-size: 10px;\"><strong data-start=\"2593\" data-end=\"2614\">Normal NCV &amp; SSR:</strong></span></p>\n<ul data-start=\"2619\" data-end=\"2783\">\n<li style=\"font-size: 10px;\" data-start=\"2619\" data-end=\"2717\">\n<p data-start=\"2621\" data-end=\"2717\"><span style=\"font-size: 10px;\">Conduction velocities, latencies, and amplitudes within normal limits; SSR present and normal.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2720\" data-end=\"2783\">\n<p data-start=\"2722\" data-end=\"2783\"><span style=\"font-size: 10px;\">Indicates intact <strong data-start=\"2739\" data-end=\"2782\">peripheral nerve and autonomic function</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2785\" data-end=\"2991\">\n<p data-start=\"2787\" data-end=\"2806\"><span style=\"font-size: 10px;\"><strong data-start=\"2787\" data-end=\"2804\">Abnormal NCV:</strong></span></p>\n<ul data-start=\"2809\" data-end=\"2991\">\n<li style=\"font-size: 10px;\" data-start=\"2809\" data-end=\"2991\">\n<p data-start=\"2811\" data-end=\"2991\"><span style=\"font-size: 10px;\">Slowed conduction velocity, prolonged latencies, or reduced amplitudes may indicate <strong data-start=\"2895\" data-end=\"2940\">demyelinating neuropathy or axonal injury</strong> (e.g., entrapment neuropathies, polyneuropathies).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2993\" data-end=\"3155\">\n<p data-start=\"2995\" data-end=\"3014\"><span style=\"font-size: 10px;\"><strong data-start=\"2995\" data-end=\"3012\">Abnormal SSR:</strong></span></p>\n<ul data-start=\"3017\" data-end=\"3155\">\n<li style=\"font-size: 10px;\" data-start=\"3017\" data-end=\"3155\">\n<p data-start=\"3019\" data-end=\"3155\"><span style=\"font-size: 10px;\">Prolonged latency or absent response suggests <strong data-start=\"3065\" data-end=\"3090\">autonomic dysfunction</strong>, seen in <strong data-start=\"3100\" data-end=\"3154\">diabetes, neuropathies, or small fiber involvement</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3157\" data-end=\"3224\">\n<p data-start=\"3159\" data-end=\"3224\"><span style=\"font-size: 10px;\">Must correlate with <strong data-start=\"3179\" data-end=\"3224\">clinical findings and EMG (if performed).</strong></span></p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": null,
