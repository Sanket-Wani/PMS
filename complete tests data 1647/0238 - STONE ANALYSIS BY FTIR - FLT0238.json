  "name": "STONE ANALYSIS BY FTIR",
  "code": "1210",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1551\" data-end=\"1704\">\n<p data-start=\"1553\" data-end=\"1599\"><span style=\"font-size: 8px;\"><strong data-start=\"1553\" data-end=\"1597\">Calcium Oxalate Stones (Mono/Dihydrate):</strong></span></p>\n<ul data-start=\"1602\" data-end=\"1704\">\n<li style=\"font-size: 8px;\" data-start=\"1602\" data-end=\"1632\">\n<p data-start=\"1604\" data-end=\"1632\"><span style=\"font-size: 8px;\">Most common type (70&ndash;80%).</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1635\" data-end=\"1704\">\n<p data-start=\"1637\" data-end=\"1704\"><span style=\"font-size: 8px;\">Linked to <strong data-start=\"1647\" data-end=\"1703\">low fluid intake, hyperoxaluria, metabolic disorders</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1706\" data-end=\"1843\">\n<p data-start=\"1708\" data-end=\"1731\"><span style=\"font-size: 8px;\"><strong data-start=\"1708\" data-end=\"1729\">Uric Acid Stones:</strong></span></p>\n<ul data-start=\"1734\" data-end=\"1843\">\n<li style=\"font-size: 8px;\" data-start=\"1734\" data-end=\"1793\">\n<p data-start=\"1736\" data-end=\"1793\"><span style=\"font-size: 8px;\">Often in <strong data-start=\"1745\" data-end=\"1790\">gout, metabolic syndrome, or acidic urine</strong>.</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1796\" data-end=\"1843\">\n<p data-start=\"1798\" data-end=\"1843\"><span style=\"font-size: 8px;\">May dissolve with <strong data-start=\"1816\" data-end=\"1842\">urinary alkalinization</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1845\" data-end=\"2018\">\n<p data-start=\"1847\" data-end=\"1900\"><span style=\"font-size: 8px;\"><strong data-start=\"1847\" data-end=\"1898\">Struvite Stones (Magnesium-Ammonium-Phosphate):</strong></span></p>\n<ul data-start=\"1903\" data-end=\"2018\">\n<li style=\"font-size: 8px;\" data-start=\"1903\" data-end=\"1960\">\n<p data-start=\"1905\" data-end=\"1960\"><span style=\"font-size: 8px;\">Associated with <strong data-start=\"1921\" data-end=\"1957\">UTIs (urease-producing bacteria)</strong>.</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1963\" data-end=\"2018\">\n<p data-start=\"1965\" data-end=\"2018\"><span style=\"font-size: 8px;\">Often form staghorn calculi &rarr; need infection control.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"2020\" data-end=\"2149\">\n<p data-start=\"2022\" data-end=\"2043\"><span style=\"font-size: 8px;\"><strong data-start=\"2022\" data-end=\"2041\">Cystine Stones:</strong></span></p>\n<ul data-start=\"2046\" data-end=\"2149\">\n<li style=\"font-size: 8px;\" data-start=\"2046\" data-end=\"2086\">\n<p data-start=\"2048\" data-end=\"2086\"><span style=\"font-size: 8px;\">Rare, due to <strong data-start=\"2061\" data-end=\"2083\">genetic cystinuria</strong>.</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"2089\" data-end=\"2149\">\n<p data-start=\"2091\" data-end=\"2149\"><span style=\"font-size: 8px;\">Typically recurrent and hard; need specialized management.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
