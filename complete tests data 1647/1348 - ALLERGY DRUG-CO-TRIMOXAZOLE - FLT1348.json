  "interpretation": "<ul>\n<li data-start=\"1317\" data-end=\"1410\">\n<p data-start=\"1319\" data-end=\"1348\"><span style=\"font-size: 10px;\"><strong data-start=\"1319\" data-end=\"1346\">Negative (&lt;0.35 kUA/L):</strong></span></p>\n<ul data-start=\"1351\" data-end=\"1410\">\n<li style=\"font-size: 10px;\" data-start=\"1351\" data-end=\"1410\">\n<p data-start=\"1353\" data-end=\"1410\"><span style=\"font-size: 10px;\">No sensitization detected; unlikely IgE-mediated allergy.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1412\" data-end=\"1518\">\n<p data-start=\"1414\" data-end=\"1452\"><span style=\"font-size: 10px;\"><strong data-start=\"1414\" data-end=\"1450\">Low/Equivocal (0.35&ndash;0.70 kUA/L):</strong></span></p>\n<ul data-start=\"1455\" data-end=\"1518\">\n<li style=\"font-size: 10px;\" data-start=\"1455\" data-end=\"1518\">\n<p data-start=\"1457\" data-end=\"1518\"><span style=\"font-size: 10px;\">Possible mild sensitization; correlate with clinical history.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1520\" data-end=\"1744\">\n<p data-start=\"1522\" data-end=\"1551\"><span style=\"font-size: 10px;\"><strong data-start=\"1522\" data-end=\"1549\">Positive (&gt;0.70 kUA/L):</strong></span></p>\n<ul data-start=\"1554\" data-end=\"1744\">\n<li style=\"font-size: 10px;\" data-start=\"1554\" data-end=\"1648\">\n<p data-start=\"1556\" data-end=\"1648\"><span style=\"font-size: 10px;\">Indicates <strong data-start=\"1566\" data-end=\"1583\">sensitization</strong>; may correlate with clinical allergy (urticaria, anaphylaxis).</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1651\" data-end=\"1744\">\n<p data-start=\"1653\" data-end=\"1744\"><span style=\"font-size: 10px;\">Requires correlation with <strong data-start=\"1679\" data-end=\"1743\">skin prick/intradermal testing and clinical reaction history</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1746\" data-end=\"1904\">\n<p data-start=\"1748\" data-end=\"1785\"><span style=\"font-size: 10px;\"><strong data-start=\"1748\" data-end=\"1783\">Strongly Positive (&gt;3.5 kUA/L):</strong></span></p>\n<ul data-start=\"1788\" data-end=\"1904\">\n<li style=\"font-size: 10px;\" data-start=\"1788\" data-end=\"1904\">\n<p data-start=\"1790\" data-end=\"1904\"><span style=\"font-size: 10px;\">High probability of clinical reactivity; consider <strong data-start=\"1840\" data-end=\"1871\">allergy specialist referral</strong> for confirmation and management.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
