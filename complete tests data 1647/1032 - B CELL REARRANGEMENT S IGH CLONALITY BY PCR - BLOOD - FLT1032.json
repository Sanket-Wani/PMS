  "interpretation": "<ul data-start=\"668\" data-end=\"982\">\n<li data-start=\"668\" data-end=\"899\">\n<p data-start=\"670\" data-end=\"786\"><span style=\"font-size: 10px;\"><strong data-start=\"670\" data-end=\"680\">Clonal</strong> IGH rearrangement indicates the presence of a <strong data-start=\"727\" data-end=\"759\">monoclonal B-cell population</strong>, commonly associated with:</span></p>\n<ul data-start=\"789\" data-end=\"899\">\n<li style=\"font-size: 10px;\" data-start=\"789\" data-end=\"820\">\n<p data-start=\"791\" data-end=\"820\"><span style=\"font-size: 10px;\">B-cell Non-Hodgkin&rsquo;s Lymphoma</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"823\" data-end=\"859\">\n<p data-start=\"825\" data-end=\"859\"><span style=\"font-size: 10px;\">Chronic Lymphocytic Leukemia (CLL)</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"862\" data-end=\"899\">\n<p data-start=\"864\" data-end=\"899\"><span style=\"font-size: 10px;\">Other lymphoproliferative disorders</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"901\" data-end=\"982\">\n<p data-start=\"903\" data-end=\"982\"><span style=\"font-size: 10px;\"><strong data-start=\"903\" data-end=\"917\">Polyclonal</strong> result suggests a <strong data-start=\"936\" data-end=\"981\">reactive or benign lymphoid proliferation</strong>.</span></p>\n</li>\n</ul>\n<p data-start=\"984\" data-end=\"1004\"><span style=\"font-size: 10px;\"><strong data-start=\"987\" data-end=\"1004\">Clinical Use:</strong></span></p>\n<ul data-start=\"1005\" data-end=\"1188\">\n<li style=\"font-size: 10px;\" data-start=\"1005\" data-end=\"1056\">\n<p data-start=\"1007\" data-end=\"1056\"><span style=\"font-size: 10px;\">Helps in the <strong data-start=\"1020\" data-end=\"1056\">diagnosis of B-cell malignancies</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1057\" data-end=\"1115\">\n<p data-start=\"1059\" data-end=\"1115\"><span style=\"font-size: 10px;\">Monitors <strong data-start=\"1068\" data-end=\"1102\">minimal residual disease (MRD)</strong> post-therapy</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1116\" data-end=\"1188\">\n<p data-start=\"1118\" data-end=\"1188\"><span style=\"font-size: 10px;\">Differentiates between <strong data-start=\"1141\" data-end=\"1188\">reactive vs neoplastic lymphoid populations</strong></span></p>\n</li>\n</ul>",
