  "name": "HIV ANTIBODY (ELISA) CARD",
  "code": "2771",
  "cost": 0,
  "interpretation": "<ul class=\"marker:text-textOff list-disc\">\n<li>\n<p class=\"my-0\"><span style=\"font-size: 11px;\"><strong>Negative:</strong></span></p>\n<ul class=\"marker:text-textOff list-disc\">\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\">No HIV-1 or HIV-2 antibodies were detected in the specimen at the time of testing.</span></p>\n</li>\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\">A negative result means that the person is likely not infected with HIV, provided the last potential exposure was outside the test&rsquo;s window period (usually 3&ndash;12 weeks)<span class=\"whitespace-nowrap\">.</span></span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\"><strong>Positive:</strong></span></p>\n<ul class=\"marker:text-textOff list-disc\">\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\">Antibodies to HIV-1 and/or HIV-2 detected. This is a presumptive positive result; confirmatory testing (e.g., immunoblot, PCR) is required for diagnosis<span class=\"whitespace-nowrap\">.</span></span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\"><strong>Indeterminate:</strong></span></p>\n<ul class=\"marker:text-textOff list-disc\">\n<li style=\"font-size: 11px;\">\n<p class=\"my-0\"><span style=\"font-size: 11px;\">Result is unclear. May occur very early after infection or due to technical issues. Repeat testing or additional confirmatory testing is recommended</span></p>\n</li>\n</ul>\n</li>\n</ul>",
