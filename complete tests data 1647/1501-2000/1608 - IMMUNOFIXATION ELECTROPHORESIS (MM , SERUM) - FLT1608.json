      "type": "textEditor",
      "data": {
        "value": "<table style=\"border-collapse: collapse; width: 100.057%;\" border=\"1\"><colgroup><col style=\"width: 99.7312%;\"></colgroup>\n<tbody>\n<tr>\n<td>Immunofixation- Qualitative, Serum</td>\n</tr>\n</tbody>\n</table>\n<table style=\"border-collapse: collapse; width: 100.057%; height: 200.833px;\" border=\"1\"><colgroup><col style=\"width: 49.8656%;\"><col style=\"width: 49.8656%;\"></colgroup>\n<tbody>\n<tr style=\"height: 33.4722px;\">\n<td>Investigation</td>\n<td>Observed Value</td>\n</tr>\n<tr style=\"height: 33.4722px;\">\n<td>Electrophoretic Zone&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr style=\"height: 33.4722px;\">\n<td>IgG&nbsp;</td>\n<td>Present</td>\n</tr>\n<tr style=\"height: 33.4722px;\">\n<td>IgM</td>\n<td>Absent</td>\n</tr>\n<tr style=\"height: 33.4722px;\">\n<td>IgA</td>\n<td>Present</td>\n</tr>\n<tr style=\"height: 33.4722px;\">\n<td>Kappa</td>\n<td>Present</td>\n</tr>\n<tr>\n<td>Lambda</td>\n<td>Absent</td>\n</tr>\n<tr>\n<td>M-Band&nbsp;</td>\n<td>Present</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Impression</strong>&mdash; IgG,IgA, Kappa&amp; M-band.</p>",
