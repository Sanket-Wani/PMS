  "interpretation": "<ul>\n<li data-start=\"1048\" data-end=\"1136\">\n<p data-start=\"1050\" data-end=\"1081\"><span style=\"font-size: 10px;\"><strong data-start=\"1050\" data-end=\"1079\">Normal (2.1 &ndash; 6.4 mg/dL):</strong></span></p>\n<ul data-start=\"1084\" data-end=\"1136\">\n<li style=\"font-size: 10px;\" data-start=\"1084\" data-end=\"1136\">\n<p data-start=\"1086\" data-end=\"1136\"><span style=\"font-size: 10px;\">Adequate Vitamin A transport and protein status.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1138\" data-end=\"1346\">\n<p data-start=\"1140\" data-end=\"1154\"><span style=\"font-size: 10px;\"><strong data-start=\"1140\" data-end=\"1152\">Low RBP:</strong></span></p>\n<ul data-start=\"1157\" data-end=\"1346\">\n<li style=\"font-size: 10px;\" data-start=\"1157\" data-end=\"1346\">\n<p data-start=\"1159\" data-end=\"1174\"><span style=\"font-size: 10px;\">May indicate:</span></p>\n<ul data-start=\"1179\" data-end=\"1346\">\n<li style=\"font-size: 10px;\" data-start=\"1179\" data-end=\"1207\">\n<p data-start=\"1181\" data-end=\"1207\"><span style=\"font-size: 10px;\"><strong data-start=\"1181\" data-end=\"1205\">Vitamin A deficiency</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1212\" data-end=\"1248\">\n<p data-start=\"1214\" data-end=\"1248\"><span style=\"font-size: 10px;\"><strong data-start=\"1214\" data-end=\"1246\">Protein-calorie malnutrition</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1253\" data-end=\"1294\">\n<p data-start=\"1255\" data-end=\"1294\"><span style=\"font-size: 10px;\"><strong data-start=\"1255\" data-end=\"1272\">Liver disease</strong> (reduced synthesis)</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1299\" data-end=\"1346\">\n<p data-start=\"1301\" data-end=\"1346\"><span style=\"font-size: 10px;\"><strong data-start=\"1301\" data-end=\"1344\">Renal protein loss (nephrotic syndrome)</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1348\" data-end=\"1533\">\n<p data-start=\"1350\" data-end=\"1369\"><span style=\"font-size: 10px;\"><strong data-start=\"1350\" data-end=\"1367\">Elevated RBP:</strong></span></p>\n<ul data-start=\"1372\" data-end=\"1533\">\n<li style=\"font-size: 10px;\" data-start=\"1372\" data-end=\"1533\">\n<p data-start=\"1374\" data-end=\"1391\"><span style=\"font-size: 10px;\">Can be seen in:</span></p>\n<ul data-start=\"1396\" data-end=\"1533\">\n<li style=\"font-size: 10px;\" data-start=\"1396\" data-end=\"1445\">\n<p data-start=\"1398\" data-end=\"1445\"><span style=\"font-size: 10px;\"><strong data-start=\"1398\" data-end=\"1443\">Chronic renal disease (reduced clearance)</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1450\" data-end=\"1476\">\n<p data-start=\"1452\" data-end=\"1476\"><span style=\"font-size: 10px;\"><strong data-start=\"1452\" data-end=\"1474\">Hypervitaminosis A</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1481\" data-end=\"1533\">\n<p data-start=\"1483\" data-end=\"1533\"><span style=\"font-size: 10px;\"><strong data-start=\"1483\" data-end=\"1531\">Certain metabolic or inflammatory conditions</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1535\" data-end=\"1643\">\n<p data-start=\"1537\" data-end=\"1643\"><span style=\"font-size: 10px;\">Should be interpreted with <strong data-start=\"1564\" data-end=\"1615\">serum Vitamin A (retinol) and prealbumin levels</strong> for nutritional assessment.</span></p>\n</li>\n</ul>",
