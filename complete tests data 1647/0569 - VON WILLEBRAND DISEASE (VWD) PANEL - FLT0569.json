  "name": "VON WILLEBRAND DISEASE (VWD) PANEL",
  "code": "1632",
  "cost": 0,
  "interpretation": "<table style=\"width: 84.5424%; height: 200px;\">\n<thead>\n<tr style=\"height: 34px;\">\n<th style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\"><strong>Finding</strong></span></th>\n<th style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\"><strong>Possible Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\">&darr; VWF:Ag &amp; &darr; VWF Activity</span></td>\n<td style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\">Suggestive of VWD Type 1 or Type 3</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\">&darr; VWF Activity with Normal VWF:Ag</span></td>\n<td style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\">Suggestive of VWD Type 2 (Qualitative defect)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\">&darr; Factor VIII</span></td>\n<td style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\">May occur in VWD or Hemophilia A</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\">Abnormal Multimer Pattern</span></td>\n<td style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\">Further subtyping of VWD (e.g., Type 2A, 2B)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.7436%;\"><span style=\"font-size: 10px;\">Ratio (VWF Activity/Antigen) &lt; 0.7</span></td>\n<td style=\"width: 56.4598%;\"><span style=\"font-size: 10px;\">Suggests Type 2 VWD</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"2888\" data-end=\"2901\"><span style=\"font-size: 10px;\"><strong data-start=\"2892\" data-end=\"2900\">Note</strong>:</span></h3>\n<ul data-start=\"2902\" data-end=\"3112\">\n<li style=\"font-size: 10px;\" data-start=\"2902\" data-end=\"3027\">\n<p data-start=\"2904\" data-end=\"3027\"><span style=\"font-size: 10px;\">Results may be affected by <strong data-start=\"2931\" data-end=\"2941\">stress</strong>, <strong data-start=\"2943\" data-end=\"2955\">exercise</strong>, <strong data-start=\"2957\" data-end=\"2970\">pregnancy</strong>, or <strong data-start=\"2975\" data-end=\"3026\">blood group (Group O may have lower VWF levels)</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3028\" data-end=\"3112\">\n<p data-start=\"3030\" data-end=\"3112\"><span style=\"font-size: 10px;\">For accurate subtyping, <strong data-start=\"3054\" data-end=\"3070\">VWF multimer</strong> and <strong data-start=\"3075\" data-end=\"3094\">genetic testing</strong> may be indicated.</span></p>\n</li>\n</ul>",
