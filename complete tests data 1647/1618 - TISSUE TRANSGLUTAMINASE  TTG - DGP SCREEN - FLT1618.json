      "data": {
        "value": "<table class=\"border-borderMain my-[1em] w-full table-auto border\" style=\"height: 189px; width: 96.4134%;\">\n<thead class=\"bg-offset\">\n<tr style=\"height: 33px;\">\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\" style=\"width: 53.2276%;\">Parameter</th>\n<th style=\"width: 4.31575%;\">Result</th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\" style=\"width: 5.42235%;\">Unit</th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\" style=\"width: 37.0712%;\">Normal/Reference Range</th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 38px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 53.2276%;\">tTG IgA (Tissue Transglutaminase IgA)</td>\n<td style=\"width: 4.31575%;\">&nbsp;</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 5.42235%;\">U/mL</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 37.0712%;\">&lt;12 U/mL (Negative)</td>\n</tr>\n<tr style=\"height: 38px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 53.2276%;\">tTG IgG (if IgA deficiency)*</td>\n<td style=\"width: 4.31575%;\">&nbsp;</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 5.42235%;\">U/mL</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 37.0712%;\">&lt;12 U/mL (Negative)</td>\n</tr>\n<tr style=\"height: 38px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 53.2276%;\">DGP IgA (Deamidated Gliadin Peptide)</td>\n<td style=\"width: 4.31575%;\">&nbsp;</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 5.42235%;\">U/mL</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 37.0712%;\">&lt;20 U/mL (Negative)</td>\n</tr>\n<tr style=\"height: 41px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 53.2276%;\">DGP IgG</td>\n<td style=\"width: 4.31575%;\">&nbsp;</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 5.42235%;\">U/mL</td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 37.0712%;\">&lt;20 U/mL (Negative)</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
