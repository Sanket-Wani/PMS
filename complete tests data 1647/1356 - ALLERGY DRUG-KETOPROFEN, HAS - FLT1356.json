{
  "_id": "6a86ccf2ba46c74c6d45f217",
  "lab": "6a7f5796eda1a5feaff0b458",
  "name": "ALLERGY DRUG-KETOPROFEN, HAS",
  "code": "2630",
  "cost": 0,
  "interpretation": "<ul class=\"marker:text-textOff list-disc\">\n<li>\n<p class=\"my-0\"><span style=\"font-size: 10px;\">The test features&nbsp;<em>application of ketoprofen on skin under occlusion</em>, followed by controlled&nbsp;<em>UV-A light exposure</em>&nbsp;to provoke a response.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Reactions are assessed visually and graded on erythema, infiltration, papules, or vesicle formation.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">A 1-hour occlusion method has been shown effective for ketoprofen allergy testing, simplifying the traditional 24-hour exposure without compromising reliability.</span></p>\n</li>\n<li style=\"font-size: 10px;\">\n<p class=\"my-0\"><span style=\"font-size: 10px;\">Clinical correlation and patient history are essential to interpret results fully.</span></p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "skin biopsy sample",
  "department": "6414fd49f02dc1ebb6a097f7",
  "isActive": true,
  "isOnboardedTest": false,
  "testCategory": [
    {
      "type": "textEditor",
      "data": {
        "value": "<table class=\"border-borderMain my-[1em] w-full table-auto border\" style=\"width: 100.054%; height: 450.4px;\">\n<thead class=\"bg-offset\">\n<tr style=\"height: 34px;\">\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Section</strong></span></th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\"><strong>Details / Description</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 52.8px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Sample Site / Test Site</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Typically skin site on the back where photopatch applied</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Test Substance / Allergen</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Ketoprofen 1% w/v solution (or other concentration if specified)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Occlusion Time</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">1 hour (or 24 hours for standard test)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>UV Irradiation</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">UVA exposure dose of 5 J/cm&sup2; (usually applied after occlusion)</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Reading / Result Timing</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Read after 48-72 hours post-irradiation</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Reaction Grading</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Negative, + (mild erythema), ++ (moderate infiltration/papules), +++ (vesicles/bullae)</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Positive reaction indicates ketoprofen photoallergy (photo-contact allergy); Negative indicates no reaction</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 19.7561%;\"><span style=\"font-size: 10px;\"><strong>Comments</strong></span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\" style=\"width: 76.3957%;\"><span style=\"font-size: 10px;\">Recommendations for avoidance of ketoprofen and sun exposure; possible cross-sensitization with other chemicals noted</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
        "field": "textEditor"
      },
      "_id": "6883a842b999cd54a340bd4a"
    }
