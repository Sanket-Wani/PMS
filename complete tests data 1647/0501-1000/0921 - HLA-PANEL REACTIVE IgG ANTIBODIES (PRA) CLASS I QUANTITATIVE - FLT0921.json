  "name": "HLA-PANEL REACTIVE IgG ANTIBODIES (PRA) CLASS I QUANTITATIVE",
  "code": "2021",
  "cost": 0,
  "interpretation": "<ul data-start=\"636\" data-end=\"967\">\n<li data-start=\"636\" data-end=\"755\">\n<p data-start=\"638\" data-end=\"755\"><span style=\"font-size: 9px;\">PRA (%) indicates the proportion of a random donor population against which a recipient has preformed HLA antibodies.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"756\" data-end=\"866\">\n<p data-start=\"758\" data-end=\"866\"><span style=\"font-size: 9px;\"><strong data-start=\"758\" data-end=\"774\">Higher PRA %</strong> suggests greater sensitization and reduced probability of finding a compatible organ donor.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"867\" data-end=\"967\">\n<p data-start=\"869\" data-end=\"967\"><span style=\"font-size: 9px;\">This test is critical in <strong data-start=\"894\" data-end=\"919\">organ transplantation</strong> settings to assess <strong data-start=\"939\" data-end=\"966\">allograft compatibility</strong>.</span></p>\n</li>\n</ul>\n<h3 data-start=\"974\" data-end=\"998\"><span style=\"font-size: 9px;\"><strong data-start=\"981\" data-end=\"998\">Clinical Use:</strong></span></h3>\n<ul data-start=\"1000\" data-end=\"1210\">\n<li style=\"font-size: 9px;\" data-start=\"1000\" data-end=\"1063\">\n<p data-start=\"1002\" data-end=\"1063\"><span style=\"font-size: 9px;\">Assessment of <strong data-start=\"1016\" data-end=\"1037\">HLA sensitization</strong> in transplant candidates.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1064\" data-end=\"1137\">\n<p data-start=\"1066\" data-end=\"1137\"><span style=\"font-size: 9px;\">Helps guide <strong data-start=\"1078\" data-end=\"1136\">organ donor selection and immunosuppression strategies</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1138\" data-end=\"1210\">\n<p data-start=\"1140\" data-end=\"1210\"><span style=\"font-size: 9px;\">Monitoring <strong data-start=\"1151\" data-end=\"1210\">antibody formation post-transfusion or post-transplant.</strong></span></p>\n</li>\n</ul>",
