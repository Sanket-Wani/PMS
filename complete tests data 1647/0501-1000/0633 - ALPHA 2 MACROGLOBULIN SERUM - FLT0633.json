  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1007\" data-end=\"1070\">\n<p data-start=\"1009\" data-end=\"1038\"><span style=\"font-size: 10px;\"><strong data-start=\"1009\" data-end=\"1036\">Normal (1.3 &ndash; 3.0 g/L):</strong></span></p>\n<ul data-start=\"1041\" data-end=\"1070\">\n<li style=\"font-size: 10px;\" data-start=\"1041\" data-end=\"1070\">\n<p data-start=\"1043\" data-end=\"1070\"><span style=\"font-size: 10px;\">Typical for healthy adults.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1072\" data-end=\"1288\">\n<p data-start=\"1074\" data-end=\"1093\"><span style=\"font-size: 10px;\"><strong data-start=\"1074\" data-end=\"1091\">Elevated A2M:</strong></span></p>\n<ul data-start=\"1096\" data-end=\"1288\">\n<li style=\"font-size: 10px;\" data-start=\"1096\" data-end=\"1288\">\n<p data-start=\"1098\" data-end=\"1115\"><span style=\"font-size: 10px;\">Can be seen in:</span></p>\n<ul data-start=\"1120\" data-end=\"1288\">\n<li style=\"font-size: 10px;\" data-start=\"1120\" data-end=\"1180\">\n<p data-start=\"1122\" data-end=\"1180\"><span style=\"font-size: 10px;\"><strong data-start=\"1122\" data-end=\"1144\">Nephrotic syndrome</strong> (due to loss of smaller proteins)</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1185\" data-end=\"1223\">\n<p data-start=\"1187\" data-end=\"1223\"><span style=\"font-size: 10px;\"><strong data-start=\"1187\" data-end=\"1200\">Pregnancy</strong> (physiological rise)</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1228\" data-end=\"1288\">\n<p data-start=\"1230\" data-end=\"1288\"><span style=\"font-size: 10px;\"><strong data-start=\"1230\" data-end=\"1286\">Diabetes, liver regeneration, or inflammatory states</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1290\" data-end=\"1466\">\n<p data-start=\"1292\" data-end=\"1306\"><span style=\"font-size: 10px;\"><strong data-start=\"1292\" data-end=\"1304\">Low A2M:</strong></span></p>\n<ul data-start=\"1309\" data-end=\"1466\">\n<li style=\"font-size: 10px;\" data-start=\"1309\" data-end=\"1466\">\n<p data-start=\"1311\" data-end=\"1326\"><span style=\"font-size: 10px;\">May indicate:</span></p>\n<ul data-start=\"1331\" data-end=\"1466\">\n<li style=\"font-size: 10px;\" data-start=\"1331\" data-end=\"1388\">\n<p data-start=\"1333\" data-end=\"1388\"><span style=\"font-size: 10px;\"><strong data-start=\"1333\" data-end=\"1386\">Severe liver disease (cirrhosis, hepatic failure)</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1393\" data-end=\"1427\">\n<p data-start=\"1395\" data-end=\"1427\"><span style=\"font-size: 10px;\"><strong data-start=\"1395\" data-end=\"1425\">Protein-losing enteropathy</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1432\" data-end=\"1466\">\n<p data-start=\"1434\" data-end=\"1466\"><span style=\"font-size: 10px;\"><strong data-start=\"1434\" data-end=\"1466\">Sepsis or severe proteolysis</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1468\" data-end=\"1556\">\n<p data-start=\"1470\" data-end=\"1556\"><span style=\"font-size: 10px;\">Should be interpreted along with <strong data-start=\"1503\" data-end=\"1555\">liver function tests, albumin, and renal profile</strong>.</span></p>\n</li>\n</ul>",
