  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive</span></td>\n<td><span style=\"font-size: 10px;\">Suggests epithelial origin; seen in adenocarcinomas (e.g., breast, pancreas, ovary)</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative</span></td>\n<td><span style=\"font-size: 10px;\">May indicate non-epithelial tumor or loss of MUC1 expression</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"2459\" data-end=\"2474\"><span style=\"font-size: 10px;\"><strong data-start=\"2463\" data-end=\"2474\">Remarks</strong></span></h3>\n<ul data-start=\"2476\" data-end=\"2878\">\n<li style=\"font-size: 10px;\" data-start=\"2476\" data-end=\"2589\">\n<p data-start=\"2478\" data-end=\"2589\"><span style=\"font-size: 10px;\">MUC1 is a <strong data-start=\"2488\" data-end=\"2504\">glycoprotein</strong> expressed on epithelial surfaces and <strong data-start=\"2542\" data-end=\"2586\">overexpressed in various adenocarcinomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2590\" data-end=\"2711\">\n<p data-start=\"2592\" data-end=\"2711\"><span style=\"font-size: 10px;\">Its presence can support <strong data-start=\"2617\" data-end=\"2630\">diagnosis</strong>, <strong data-start=\"2632\" data-end=\"2657\">prognostic evaluation</strong>, and <strong data-start=\"2663\" data-end=\"2689\">differential diagnosis</strong> in tumor subtyping.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2712\" data-end=\"2878\">\n<p data-start=\"2714\" data-end=\"2878\"><span style=\"font-size: 10px;\">Interpretation should be correlated with <strong data-start=\"2755\" data-end=\"2767\">clinical</strong>, <strong data-start=\"2769\" data-end=\"2783\">radiologic</strong>, and <strong data-start=\"2789\" data-end=\"2819\">histopathological findings</strong>, as well as other <strong data-start=\"2838\" data-end=\"2853\">IHC markers</strong> (e.g., CK7, EMA, CA125).</span></p>\n</li>\n</ul>",
