  "name": "IHC - SPINDLE CELL TUMOUR",
  "code": "1953",
  "cost": 0,
  "interpretation": "<ul data-start=\"1789\" data-end=\"2052\">\n<li data-start=\"1789\" data-end=\"2052\">\n<p data-start=\"1791\" data-end=\"1881\">Based on IHC marker pattern, the diagnosis is <strong data-start=\"1837\" data-end=\"1867\">correlated with morphology</strong> to determine:</p>\n<ul data-start=\"1884\" data-end=\"2052\">\n<li data-start=\"1884\" data-end=\"1909\">\n<p data-start=\"1886\" data-end=\"1909\"><strong data-start=\"1886\" data-end=\"1909\">Benign vs Malignant</strong></p>\n</li>\n<li data-start=\"1912\" data-end=\"1972\">\n<p data-start=\"1914\" data-end=\"1972\"><strong data-start=\"1914\" data-end=\"1930\">Tumor origin</strong> (neural, smooth muscle, epithelial, etc.)</p>\n</li>\n<li data-start=\"1975\" data-end=\"2052\">\n<p data-start=\"1977\" data-end=\"2052\"><strong data-start=\"1977\" data-end=\"1997\">Specific subtype</strong> (e.g., fibrosarcoma, leiomyosarcoma, synovial sarcoma)</p>\n</li>\n</ul>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "ffpe tissue block",
  "department": "67631e5624f8fa88510fdb6d",
  "isActive": true,
  "isOnboardedTest": false,
  "testCategory": [
    {
      "type": "textEditor",
      "data": {
        "value": "<table style=\"height: 374px; width: 97.3149%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 27.0717%;\"><strong>IHC Marker</strong></th>\n<th style=\"width: 26.2724%;\"><strong>Expression Pattern</strong></th>\n<th style=\"width: 41.7669%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>Vimentin</strong></td>\n<td style=\"width: 26.2724%;\">Positive in mesenchymal cells</td>\n<td style=\"width: 41.7669%;\">Confirms mesenchymal origin</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>Desmin</strong></td>\n<td style=\"width: 26.2724%;\">Muscle marker</td>\n<td style=\"width: 41.7669%;\">Positive in leiomyosarcoma, rhabdomyosarcoma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>SMA (&alpha;-Smooth Muscle Actin)</strong></td>\n<td style=\"width: 26.2724%;\">Muscle/myofibroblastic marker</td>\n<td style=\"width: 41.7669%;\">Suggests smooth muscle or myofibroblastic origin</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>S100</strong></td>\n<td style=\"width: 26.2724%;\">Nerve sheath/melanocytic cells</td>\n<td style=\"width: 41.7669%;\">Positive in schwannoma, melanoma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>CD34</strong></td>\n<td style=\"width: 26.2724%;\">Vascular marker</td>\n<td style=\"width: 41.7669%;\">Seen in solitary fibrous tumors</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>CD99</strong></td>\n<td style=\"width: 26.2724%;\">Ewing sarcoma/PNET marker</td>\n<td style=\"width: 41.7669%;\">May show positivity in some sarcomas</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>Cytokeratin (Pan-CK)</strong></td>\n<td style=\"width: 26.2724%;\">Epithelial marker</td>\n<td style=\"width: 41.7669%;\">Rules out carcinoma if negative</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>Bcl-2</strong></td>\n<td style=\"width: 26.2724%;\">Anti-apoptotic marker</td>\n<td style=\"width: 41.7669%;\">Can be positive in synovial sarcoma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 27.0717%;\"><strong>STAT6</strong></td>\n<td style=\"width: 26.2724%;\">Solitary fibrous tumor marker</td>\n<td style=\"width: 41.7669%;\">Strong nuclear positivity supports SFT</td>\n</tr>\n<tr style=\"height: 43px;\">\n<td style=\"width: 27.0717%;\"><strong>Myogenin</strong> or <strong>MyoD1</strong></td>\n<td style=\"width: 26.2724%;\">Skeletal muscle marker</td>\n<td style=\"width: 41.7669%;\">Suggestive of rhabdomyosarcoma</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
        "field": "textEditor"
      },
