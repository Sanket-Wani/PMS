  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive</span></td>\n<td><span style=\"font-size: 10px;\">Suggestive of lymphoid precursor origin &ndash; e.g., <strong>Acute Lymphoblastic Leukemia (ALL)</strong>, <strong>Lymphoblastic Lymphoma</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative</span></td>\n<td><span style=\"font-size: 10px;\">Not consistent with TdT-expressing neoplasm</span></td>\n</tr>\n</tbody>\n</table>\n<h3 data-start=\"2546\" data-end=\"2561\"><span style=\"font-size: 10px;\"><strong data-start=\"2550\" data-end=\"2561\">Remarks</strong></span></h3>\n<ul data-start=\"2563\" data-end=\"2803\">\n<li style=\"font-size: 10px;\" data-start=\"2563\" data-end=\"2674\">\n<p data-start=\"2565\" data-end=\"2674\"><span style=\"font-size: 10px;\">TdT is a <strong data-start=\"2574\" data-end=\"2611\">marker of immature lymphoid cells</strong>, seen in <strong data-start=\"2621\" data-end=\"2671\">precursor B-cell or T-cell leukemias/lymphomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2675\" data-end=\"2803\">\n<p data-start=\"2677\" data-end=\"2803\"><span style=\"font-size: 10px;\">Interpretation should be correlated with <strong data-start=\"2718\" data-end=\"2732\">morphology</strong>, <strong data-start=\"2734\" data-end=\"2779\">other IHC markers (e.g., CD3, CD20, CD34)</strong>, and <strong data-start=\"2785\" data-end=\"2802\">clinical data</strong>.</span></p>\n</li>\n</ul>",
