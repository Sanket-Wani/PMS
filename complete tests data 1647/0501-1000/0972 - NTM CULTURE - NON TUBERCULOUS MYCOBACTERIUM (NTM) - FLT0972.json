  "interpretation": "<ul data-start=\"990\" data-end=\"1367\">\n<li data-start=\"990\" data-end=\"1118\">\n<p data-start=\"992\" data-end=\"1118\"><span style=\"font-size: 8px;\"><strong data-start=\"992\" data-end=\"1030\">Non-Tuberculous Mycobacteria (NTM)</strong> are a group of mycobacterial species <em data-start=\"1068\" data-end=\"1080\">other than</em> <em data-start=\"1081\" data-end=\"1109\">Mycobacterium tuberculosis</em> complex.</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1119\" data-end=\"1262\">\n<p data-start=\"1121\" data-end=\"1262\"><span style=\"font-size: 8px;\">Isolation may indicate <strong data-start=\"1144\" data-end=\"1170\">chronic lung infection</strong>, <strong data-start=\"1172\" data-end=\"1202\">skin/soft tissue infection</strong>, or <strong data-start=\"1207\" data-end=\"1231\">disseminated disease</strong> in immunocompromised patients.</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1263\" data-end=\"1367\">\n<p data-start=\"1265\" data-end=\"1298\"><span style=\"font-size: 8px;\">Clinical significance depends on:</span></p>\n<ul data-start=\"1301\" data-end=\"1367\">\n<li style=\"font-size: 8px;\" data-start=\"1301\" data-end=\"1311\">\n<p data-start=\"1303\" data-end=\"1311\"><span style=\"font-size: 8px;\">Symptoms</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1314\" data-end=\"1337\">\n<p data-start=\"1316\" data-end=\"1337\"><span style=\"font-size: 8px;\">Radiological findings</span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1340\" data-end=\"1367\">\n<p data-start=\"1342\" data-end=\"1367\"><span style=\"font-size: 8px;\">Repeat culture positivity</span></p>\n</li>\n</ul>\n</li>\n</ul>\n<p data-start=\"1369\" data-end=\"1393\"><span style=\"font-size: 8px;\">Common species isolated:</span></p>\n<ul data-start=\"1394\" data-end=\"1502\">\n<li style=\"font-size: 8px;\" data-start=\"1394\" data-end=\"1446\">\n<p data-start=\"1396\" data-end=\"1446\"><span style=\"font-size: 8px;\"><em data-start=\"1396\" data-end=\"1446\">Mycobacterium avium-intracellulare complex (MAC)</em></span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1447\" data-end=\"1474\">\n<p data-start=\"1449\" data-end=\"1474\"><span style=\"font-size: 8px;\"><em data-start=\"1449\" data-end=\"1474\">Mycobacterium abscessus</em></span></p>\n</li>\n<li style=\"font-size: 8px;\" data-start=\"1475\" data-end=\"1502\">\n<p data-start=\"1477\" data-end=\"1502\"><span style=\"font-size: 8px;\"><em data-start=\"1477\" data-end=\"1502\">Mycobacterium fortuitum</em></span></p>\n</li>\n</ul>",
