      "type": "textEditor",
      "data": {
        "value": "<p><strong>PROTEIN ELECTROPHORESIS (24 HOUR URINE)</strong><br><br><strong>SAMPLE TYPE: </strong>24 HOUR URINE<br><strong>METHOD: </strong>GEL ELECTROPHORESIS - HIGH RESOLUTION<br>&nbsp;</p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p><strong>Investigation&nbsp;&nbsp;</strong></p>\n</td>\n<td>\n<p><strong>Observed Value&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong></p>\n</td>\n<td>\n<p><strong>Unit</strong></p>\n</td>\n<td>\n<p><strong>Biological Ref. Interval</strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong>Total Proteins</strong></p>\n</td>\n<td>\n<p>&nbsp;<strong>783.30&nbsp; &nbsp;</strong></p>\n</td>\n<td>\n<p>mg/24 hrs</p>\n</td>\n<td>\n<p>28-141</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p><br><strong>ELECTROPHORETIC ZONES- RELATIVE CONCENTRATION (%)</strong><br><br></p>\n<table style=\"height: 255.816px; width: 58.1275%;\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"height: 42px;\">\n<td style=\"width: 34.5352%;\">\n<p>Albumin</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>&nbsp; &nbsp; &nbsp; &nbsp;91.40</p>\n</td>\n</tr>\n<tr style=\"height: 42px;\">\n<td style=\"width: 34.5352%;\">\n<p>Alpha-1</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>&nbsp; &nbsp; &nbsp; &nbsp; -</p>\n</td>\n</tr>\n<tr style=\"height: 42px;\">\n<td style=\"width: 34.5352%;\">\n<p>Alpha-2</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>&nbsp; &nbsp; &nbsp; &nbsp; -</p>\n</td>\n</tr>\n<tr style=\"height: 42px;\">\n<td style=\"width: 34.5352%;\">\n<p>Beta</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>&nbsp; &nbsp; &nbsp; &nbsp;8.60</p>\n</td>\n</tr>\n<tr style=\"height: 42px;\">\n<td style=\"width: 34.5352%;\">\n<p>Gamma</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>&nbsp; &nbsp; &nbsp; &nbsp; -</p>\n</td>\n</tr>\n<tr style=\"height: 45px;\">\n<td style=\"width: 34.5352%;\">\n<p>M-Spike</p>\n</td>\n<td style=\"width: 65.1832%;\">\n<p>Seen Comment</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>",
