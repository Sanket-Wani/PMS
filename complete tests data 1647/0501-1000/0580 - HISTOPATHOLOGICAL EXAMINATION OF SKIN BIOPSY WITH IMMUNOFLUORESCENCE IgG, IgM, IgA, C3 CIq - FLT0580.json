  "interpretation": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\"><strong>Finding</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Possible Implication</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Linear IgG and/or C3 along BMZ</span></td>\n<td><span style=\"font-size: 10px;\">Bullous Pemphigoid / Linear IgA Disease</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Intercellular IgG (fish-net pattern)</span></td>\n<td><span style=\"font-size: 10px;\">Pemphigus Vulgaris / Pemphigus Foliaceus</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Granular IgA in Dermal Papillae</span></td>\n<td><span style=\"font-size: 10px;\">Dermatitis Herpetiformis</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Lupus Band (IgG, IgM, C3, C1q along BMZ)</span></td>\n<td><span style=\"font-size: 10px;\">Cutaneous or Systemic Lupus Erythematosus</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative DIF</span></td>\n<td><span style=\"font-size: 10px;\">No immune complex deposits detected; does not exclude all dermatoses -correlate clinically and with serology.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
