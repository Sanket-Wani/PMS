  "name": "IHC - GLIAL FIBRILLARY ACIDIC PROTEIN (GFAP)",
  "code": "1904",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"885\" data-end=\"1126\">\n<p data-start=\"887\" data-end=\"905\"><strong data-start=\"887\" data-end=\"904\">GFAP Positive</strong>:</p>\n<ul data-start=\"908\" data-end=\"1126\">\n<li data-start=\"908\" data-end=\"955\">\n<p data-start=\"910\" data-end=\"955\">Suggests <strong data-start=\"919\" data-end=\"955\">astrocytic/glial differentiation</strong></p>\n</li>\n<li data-start=\"958\" data-end=\"1027\">\n<p data-start=\"960\" data-end=\"1027\">Supports diagnosis of <strong data-start=\"982\" data-end=\"993\">gliomas</strong> (e.g., astrocytoma, glioblastoma)</p>\n</li>\n<li data-start=\"1030\" data-end=\"1126\">\n<p data-start=\"1032\" data-end=\"1126\">May also be seen in <strong data-start=\"1052\" data-end=\"1066\">ependymoma</strong>, <strong data-start=\"1068\" data-end=\"1089\">oligodendroglioma</strong> (variable), and <strong data-start=\"1106\" data-end=\"1126\">reactive gliosis</strong></p>\n</li>\n</ul>\n</li>\n<li data-start=\"1128\" data-end=\"1235\">\n<p data-start=\"1130\" data-end=\"1148\"><strong data-start=\"1130\" data-end=\"1147\">GFAP Negative</strong>:</p>\n<ul data-start=\"1151\" data-end=\"1235\">\n<li data-start=\"1151\" data-end=\"1182\">\n<p data-start=\"1153\" data-end=\"1182\">Suggests <strong data-start=\"1162\" data-end=\"1182\">non-glial origin</strong></p>\n</li>\n<li data-start=\"1185\" data-end=\"1235\">\n<p data-start=\"1187\" data-end=\"1235\">Rules out glial tumors in differential diagnosis</p>\n</li>\n</ul>\n</li>\n</ul>",
