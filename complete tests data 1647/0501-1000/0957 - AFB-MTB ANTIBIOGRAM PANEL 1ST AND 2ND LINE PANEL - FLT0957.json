        "value": "<p><strong>AFB-MTB ANTIBIOGRAM PANEL 1ST AND 2ND LINE PANEL 10 DRUGS</strong></p>\n<p><strong>Culture medium used&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; : </strong>Modified Middlebrook 7H9 Broth</p>\n<p><strong>Temperature Maintained&nbsp; &nbsp; &nbsp; &nbsp; :</strong>35&deg; C</p>\n<p><strong>Method&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; :</strong> Automated Bactec Mgit 960 System</p>\n<p><strong>Specimen&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; :</strong> Mycobacterium tuberculosis complex</p>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<strong>&nbsp; &nbsp; &nbsp; &nbsp;1st Line Drug Susceptibility</strong></p>\n<table style=\"border-collapse: collapse; width: 99.9991%;\" border=\"1\"><colgroup><col style=\"width: 32.3928%;\"><col style=\"width: 36.613%;\"><col style=\"width: 31.0241%;\"></colgroup>\n<tbody>\n<tr>\n<td><strong>Antitubercular Drug&nbsp;</strong></td>\n<td><strong>Critical Concentration (ug/ml)</strong></td>\n<td><strong>&nbsp;Interpretation</strong></td>\n</tr>\n<tr>\n<td>STREPTOMYCIN</td>\n<td>1</td>\n<td>Susceptible</td>\n</tr>\n<tr>\n<td>ISONIAZID</td>\n<td>0.1</td>\n<td>Susceptible</td>\n</tr>\n<tr>\n<td>RIFAMPICIN&nbsp;</td>\n<td>5</td>\n<td>Susceptible</td>\n</tr>\n<tr>\n<td>ETHAMBUTOL</td>\n<td>1</td>\n<td>Susceptible</td>\n</tr>\n<tr>\n<td>PYRAZINAMIDE</td>\n<td>100</td>\n<td>Susceptible</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <strong>&nbsp; 2nd Line Drug Susceptibility</strong></p>\n<table style=\"border-collapse: collapse; width: 100.028%; height: 168.066px;\" border=\"1\"><colgroup><col style=\"width: 33.2555%;\"><col style=\"width: 33.2555%;\"><col style=\"width: 33.2555%;\"></colgroup>\n<tbody>\n<tr style=\"height: 33.6133px;\">\n<td><strong>Antitubercular Drug&nbsp;&nbsp;</strong></td>\n<td><strong>Critical Concentration (ug/ml)</strong></td>\n<td><strong>Interpretation</strong></td>\n</tr>\n<tr style=\"height: 33.6133px;\">\n<td><strong>KANAMYCIN</strong></td>\n<td>2.5</td>\n<td>Susceptible</td>\n</tr>\n<tr style=\"height: 33.6133px;\">\n<td><strong>ETHIONAMIDE</strong></td>\n<td>5</td>\n<td>Susceptible</td>\n</tr>\n<tr style=\"height: 33.6133px;\">\n<td><strong>PAS (Para Amino Salicylic acid)</strong></td>\n<td>4</td>\n<td>Susceptible</td>\n</tr>\n<tr style=\"height: 33.6133px;\">\n<td><strong>OFLOXACIN</strong></td>\n<td>2</td>\n<td>Susceptible</td>\n</tr>\n<tr>\n<td><strong>CAPREOMYCIN</strong></td>\n<td>2.5</td>\n<td>Susceptible</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
