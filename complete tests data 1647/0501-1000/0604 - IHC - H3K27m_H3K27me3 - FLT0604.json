        "value": "<table style=\"height: 103px; width: 96.2003%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 15.6792%;\"><strong>IHC Marker</strong></th>\n<th style=\"width: 20.7688%;\"><strong>Result</strong></th>\n<th style=\"width: 58.7117%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 15.6792%;\">H3K27me3</td>\n<td style=\"width: 20.7688%;\">Retained / Lost</td>\n<td style=\"width: 58.7117%;\">Loss indicates epigenetic dysregulation (e.g., MPNST)</td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 15.6792%;\">H3K27M</td>\n<td style=\"width: 20.7688%;\">Positive / Negative</td>\n<td style=\"width: 58.7117%;\">Positive indicates H3K27M mutation (e.g., DMG)</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
