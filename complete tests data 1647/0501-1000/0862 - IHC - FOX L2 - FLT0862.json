      "data": {
        "value": "<p><strong><span style=\"font-size: 10px;\">Histopathology Reference</span></strong></p>\n<table style=\"width: 91.513%;\">\n<thead>\n<tr>\n<th style=\"width: 100%;\"><span style=\"font-size: 10px;\"><strong>Diagnosis</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 100%;\"><span style=\"font-size: 10px;\">e.g., Spindle cell neoplasm / Sex cord-stromal tumor suspected</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><strong><span style=\"font-size: 10px;\">IHC Interpretation &ndash; FOX L2:</span></strong></p>\n<table style=\"width: 91.7842%;\">\n<thead>\n<tr>\n<th style=\"width: 7.62496%;\"><span style=\"font-size: 10px;\"><strong>Marker</strong></span></th>\n<th style=\"width: 12.5671%;\"><span style=\"font-size: 10px;\"><strong>Staining Result</strong></span></th>\n<th style=\"width: 12.0023%;\"><span style=\"font-size: 10px;\"><strong>Localization</strong></span></th>\n<th style=\"width: 13.9791%;\"><span style=\"font-size: 10px;\"><strong>Intensity</strong></span></th>\n<th style=\"width: 15.2499%;\"><span style=\"font-size: 10px;\"><strong>% of Positive Cells</strong></span></th>\n<th style=\"width: 38.6896%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 7.62496%;\"><span style=\"font-size: 10px;\">FOX L2</span></td>\n<td style=\"width: 12.5671%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 12.0023%;\"><span style=\"font-size: 10px;\">Nuclear</span></td>\n<td style=\"width: 13.9791%;\"><span style=\"font-size: 10px;\">Weak/Mod/Strong</span></td>\n<td style=\"width: 15.2499%;\"><span style=\"font-size: 10px;\">e.g., 80%</span></td>\n<td style=\"width: 38.6896%;\"><span style=\"font-size: 10px;\">Consistent with adult granulosa cell tumor / Not consistent</span></td>\n</tr>\n</tbody>\n</table>\n<p><strong><span style=\"font-size: 10px;\">Final Impression:</span></strong></p>\n<table style=\"width: 92.1909%;\">\n<thead>\n<tr>\n<th style=\"width: 100%;\"><span style=\"font-size: 10px;\"><strong>Conclusion</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 100%;\"><span style=\"font-size: 10px;\">e.g., Positive FOX L2 expression supports the diagnosis of adult-type granulosa cell tumor. Please correlate clinically and with other IHC markers.</span></td>\n</tr>\n</tbody>\n</table>\n<p><strong><span style=\"font-size: 10px;\">Remarks (if any)</span></strong></p>\n<table style=\"width: 92.3265%;\">\n<thead>\n<tr>\n<th style=\"width: 100%;\"><span style=\"font-size: 10px;\"><strong>Notes</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 100%;\"><span style=\"font-size: 10px;\">Additional IHC markers may be advised for definitive diagnosis if needed.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
