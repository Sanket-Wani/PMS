  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Finding</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Candida species isolated</span></td>\n<td><span style=\"font-size: 10px;\">Suggests fungal infection; treat as per sensitivity report</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">No growth</span></td>\n<td><span style=\"font-size: 10px;\">No yeast growth; possible non-candidal etiology or prior antifungal use</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Fluconazole resistance</span></td>\n<td><span style=\"font-size: 10px;\">Consider alternative antifungal (e.g., Amphotericin B, Echinocandins)</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Sensitive to first-line antifungals</span></td>\n<td><span style=\"font-size: 10px;\">Suitable for standard treatment</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
