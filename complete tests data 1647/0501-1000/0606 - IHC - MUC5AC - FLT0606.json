  "name": "IHC - MUC5AC",
  "code": "1703",
  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 11px;\"><strong>Result</strong></span></th>\n<th><span style=\"font-size: 11px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 11px;\">Positive</span></td>\n<td><span style=\"font-size: 11px;\">Suggests mucinous/gastrointestinal epithelial origin; supports diagnosis of mucinous tumors</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 11px;\">Negative</span></td>\n<td><span style=\"font-size: 11px;\">No significant MUC5AC expression; may rule out mucinous differentiation</span></td>\n</tr>\n</tbody>\n</table>\n<h3 data-start=\"2512\" data-end=\"2527\"><span style=\"font-size: 11px;\"><strong data-start=\"2516\" data-end=\"2527\">Remarks</strong></span></h3>\n<ul data-start=\"2529\" data-end=\"2875\">\n<li style=\"font-size: 11px;\" data-start=\"2529\" data-end=\"2595\">\n<p data-start=\"2531\" data-end=\"2595\"><span style=\"font-size: 11px;\">MUC5AC is <strong data-start=\"2541\" data-end=\"2594\">normally expressed in gastric foveolar epithelium</strong>.</span></p>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"2596\" data-end=\"2734\">\n<p data-start=\"2598\" data-end=\"2734\"><span style=\"font-size: 11px;\">Positive in <strong data-start=\"2610\" data-end=\"2637\">gastric adenocarcinomas</strong>, <strong data-start=\"2639\" data-end=\"2676\">pancreatic ductal adenocarcinomas</strong>, and some <strong data-start=\"2687\" data-end=\"2733\">colorectal and ovarian mucinous carcinomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 11px;\" data-start=\"2735\" data-end=\"2875\">\n<p data-start=\"2737\" data-end=\"2875\"><span style=\"font-size: 11px;\">Should be interpreted along with <strong data-start=\"2770\" data-end=\"2815\">clinical, radiological, histopathological</strong>, and <strong data-start=\"2821\" data-end=\"2842\">other IHC markers</strong> like MUC2, CDX2, CK7, CK20, etc.</span></p>\n</li>\n</ul>",
