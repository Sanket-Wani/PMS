        "value": "<h3 data-start=\"397\" data-end=\"421\"><strong data-start=\"401\" data-end=\"421\">Patient Details:</strong></h3>\n<ul data-start=\"422\" data-end=\"577\">\n<li data-start=\"422\" data-end=\"435\">\n<p data-start=\"424\" data-end=\"435\"><strong data-start=\"424\" data-end=\"432\">Name</strong>:</p>\n</li>\n<li data-start=\"436\" data-end=\"452\">\n<p data-start=\"438\" data-end=\"452\"><strong data-start=\"438\" data-end=\"449\">Age/Sex</strong>:</p>\n</li>\n<li data-start=\"453\" data-end=\"474\">\n<p data-start=\"455\" data-end=\"474\"><strong data-start=\"455\" data-end=\"471\">UHID/Ref. ID</strong>:</p>\n</li>\n<li data-start=\"475\" data-end=\"548\">\n<p data-start=\"477\" data-end=\"548\"><strong data-start=\"477\" data-end=\"500\">Clinical Indication</strong>: (e.g., liver lesion, renal mass, lymph node)</p>\n</li>\n<li data-start=\"549\" data-end=\"577\">\n<p data-start=\"551\" data-end=\"577\"><strong data-start=\"551\" data-end=\"574\">Referring Physician</strong>:</p>\n</li>\n</ul>\n<h3 data-start=\"584\" data-end=\"610\"><strong data-start=\"588\" data-end=\"610\">Procedure Details:</strong></h3>\n<ul data-start=\"611\" data-end=\"922\">\n<li data-start=\"611\" data-end=\"644\">\n<p data-start=\"613\" data-end=\"644\"><strong data-start=\"613\" data-end=\"641\">Date &amp; Time of Procedure</strong>:</p>\n</li>\n<li data-start=\"645\" data-end=\"720\">\n<p data-start=\"647\" data-end=\"720\"><strong data-start=\"647\" data-end=\"665\">Type of Biopsy</strong>: Tru-cut/Core Needle / Fine Needle Aspiration (FNAC)</p>\n</li>\n<li data-start=\"721\" data-end=\"756\">\n<p data-start=\"723\" data-end=\"756\"><strong data-start=\"723\" data-end=\"735\">Guidance</strong>: Ultrasound-guided</p>\n</li>\n<li data-start=\"757\" data-end=\"805\">\n<p data-start=\"759\" data-end=\"805\"><strong data-start=\"759\" data-end=\"774\">Needle Size</strong>: e.g., 18G/20G biopsy needle</p>\n</li>\n<li data-start=\"806\" data-end=\"850\">\n<p data-start=\"808\" data-end=\"850\"><strong data-start=\"808\" data-end=\"828\">Number of Passes</strong>: (e.g., 2&ndash;3 passes)</p>\n</li>\n<li data-start=\"851\" data-end=\"922\">\n<p data-start=\"853\" data-end=\"922\"><strong data-start=\"853\" data-end=\"872\">Sample Adequacy</strong>: Adequate/Inadequate (as per onsite evaluation)</p>\n</li>\n</ul>\n<h3 data-start=\"929\" data-end=\"960\"><strong data-start=\"933\" data-end=\"960\">Findings on Ultrasound:</strong></h3>\n<ul data-start=\"961\" data-end=\"1157\">\n<li data-start=\"961\" data-end=\"1046\">\n<p data-start=\"963\" data-end=\"1046\"><strong data-start=\"963\" data-end=\"986\">Target Organ/Lesion</strong>: (e.g., Hypoechoic lesion in right lobe of liver, 2.5 cm)</p>\n</li>\n<li data-start=\"1047\" data-end=\"1100\">\n<p data-start=\"1049\" data-end=\"1100\"><strong data-start=\"1049\" data-end=\"1061\">Approach</strong>: (e.g., Subcostal/right intercostal)</p>\n</li>\n<li data-start=\"1101\" data-end=\"1157\">\n<p data-start=\"1103\" data-end=\"1157\"><strong data-start=\"1103\" data-end=\"1129\">Surrounding Structures</strong>: No significant abnormality</p>\n</li>\n</ul>\n<h3 data-start=\"1164\" data-end=\"1186\"><strong data-start=\"1168\" data-end=\"1185\">Complications</strong>:</h3>\n<ul data-start=\"1187\" data-end=\"1238\">\n<li data-start=\"1187\" data-end=\"1204\">\n<p data-start=\"1189\" data-end=\"1204\">None observed</p>\n</li>\n<li data-start=\"1205\" data-end=\"1238\">\n<p data-start=\"1207\" data-end=\"1238\">Patient stable post-procedure</p>\n</li>\n</ul>\n<h3 data-start=\"1245\" data-end=\"1269\"><strong data-start=\"1249\" data-end=\"1268\">Sample Sent For</strong>:</h3>\n<ul data-start=\"1270\" data-end=\"1407\">\n<li data-start=\"1270\" data-end=\"1298\">\n<p data-start=\"1272\" data-end=\"1298\"><strong data-start=\"1272\" data-end=\"1296\">Histopathology (HPE)</strong></p>\n</li>\n<li data-start=\"1299\" data-end=\"1322\">\n<p data-start=\"1301\" data-end=\"1322\"><strong data-start=\"1301\" data-end=\"1320\">Cytology (FNAC)</strong></p>\n</li>\n<li data-start=\"1323\" data-end=\"1357\">\n<p data-start=\"1325\" data-end=\"1357\"><strong data-start=\"1325\" data-end=\"1355\">Microbiology (if required)</strong></p>\n</li>\n<li data-start=\"1358\" data-end=\"1407\">\n<p data-start=\"1360\" data-end=\"1407\"><strong data-start=\"1360\" data-end=\"1390\">Immunohistochemistry (IHC)</strong> (if indicated)</p>\n</li>\n</ul>\n<h3 data-start=\"1414\" data-end=\"1450\"><strong data-start=\"1418\" data-end=\"1449\">Post-Procedure Instructions</strong>:</h3>\n<ul data-start=\"1451\" data-end=\"1617\">\n<li data-start=\"1451\" data-end=\"1501\">\n<p data-start=\"1453\" data-end=\"1501\">Observation for 1&ndash;2 hours for bleeding or pain</p>\n</li>\n<li data-start=\"1502\" data-end=\"1548\">\n<p data-start=\"1504\" data-end=\"1548\">Avoid strenuous activities for 24&ndash;48 hours</p>\n</li>\n<li data-start=\"1549\" data-end=\"1617\">\n<p data-start=\"1551\" data-end=\"1617\">Report immediately in case of fever, pain, or excessive bleeding</p>\n</li>\n</ul>\n<p>&nbsp;</p>",
        "field": "textEditor"
      },
