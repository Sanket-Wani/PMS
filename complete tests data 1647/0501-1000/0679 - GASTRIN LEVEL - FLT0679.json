  "name": "GASTRIN LEVEL",
  "code": "1762",
  "cost": 0,
  "interpretation": "<p><strong data-start=\"45\" data-end=\"56\">Gastrin</strong> is a hormone secreted by <strong data-start=\"82\" data-end=\"115\">G-cells in the stomach antrum</strong> that stimulates acid production by the stomach. Measuring gastrin levels is useful for evaluating conditions associated with <strong data-start=\"241\" data-end=\"264\">acid hypersecretion</strong>, <strong data-start=\"266\" data-end=\"283\">hyposecretion</strong>, and <strong data-start=\"289\" data-end=\"317\">gastrin-producing tumors</strong>.</p>\n<p data-start=\"461\" data-end=\"501\"><strong data-start=\"465\" data-end=\"501\">Clinical Indications for Testing</strong></p>\n<ul data-start=\"502\" data-end=\"750\">\n<li data-start=\"502\" data-end=\"552\">\n<p data-start=\"504\" data-end=\"552\">Suspected <strong data-start=\"514\" data-end=\"550\">Zollinger-Ellison Syndrome (ZES)</strong></p>\n</li>\n<li data-start=\"553\" data-end=\"620\">\n<p data-start=\"555\" data-end=\"620\">Unexplained <strong data-start=\"567\" data-end=\"584\">peptic ulcers</strong>, especially recurrent or multiple</p>\n</li>\n<li data-start=\"621\" data-end=\"694\">\n<p data-start=\"623\" data-end=\"694\">Evaluation of <strong data-start=\"637\" data-end=\"667\">chronic atrophic gastritis</strong> or <strong data-start=\"671\" data-end=\"692\">pernicious anemia</strong></p>\n</li>\n<li data-start=\"695\" data-end=\"750\">\n<p data-start=\"697\" data-end=\"750\">Diagnosis of <strong data-start=\"710\" data-end=\"724\">gastrinoma</strong> (gastrin-producing tumor)</p>\n</li>\n</ul>\n<p>&nbsp;</p>\n<p>Causes of Elevated Gastrin</p>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th><strong>Condition</strong></th>\n<th><strong>Typical Gastrin Level</strong></th>\n<th><strong>Gastric Acid Output</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>Zollinger-Ellison syndrome</strong></td>\n<td>Often &gt;1000 pg/mL</td>\n<td><strong>High</strong></td>\n</tr>\n<tr>\n<td><strong>Pernicious anemia / Atrophic gastritis</strong></td>\n<td>Moderately high (200&ndash;1000+)</td>\n<td><strong>Low or absent</strong></td>\n</tr>\n<tr>\n<td><strong>PPI (Proton Pump Inhibitor) use</strong></td>\n<td>Mild to moderate increase</td>\n<td><strong>Variable</strong></td>\n</tr>\n<tr>\n<td><strong>G-cell hyperplasia</strong></td>\n<td>Mild to moderate</td>\n<td><strong>Normal or high</strong></td>\n</tr>\n<tr>\n<td><strong>Chronic kidney disease</strong></td>\n<td>Mild elevation</td>\n<td><strong>Normal</strong></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
