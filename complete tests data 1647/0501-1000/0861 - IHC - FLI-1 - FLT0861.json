  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive</span></td>\n<td><span style=\"font-size: 10px;\">Supports diagnosis of <strong>Ewing's Sarcoma</strong>, <strong>vascular tumors</strong>, or <strong>lymphoblastic lymphoma</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative</span></td>\n<td><span style=\"font-size: 10px;\">Does not support FLI-1 expressing tumors; consider alternate IHC markers</span></td>\n</tr>\n</tbody>\n</table>\n<h3 data-start=\"1553\" data-end=\"1569\"><span style=\"font-size: 10px;\"><strong data-start=\"1557\" data-end=\"1569\">Comments</strong></span></h3>\n<ul data-start=\"1570\" data-end=\"1852\">\n<li style=\"font-size: 10px;\" data-start=\"1570\" data-end=\"1710\">\n<p data-start=\"1572\" data-end=\"1710\"><span style=\"font-size: 10px;\"><strong data-start=\"1572\" data-end=\"1581\">FLI-1</strong> is a <strong data-start=\"1587\" data-end=\"1619\">nuclear transcription factor</strong> expressed in <strong data-start=\"1633\" data-end=\"1652\">Ewing's sarcoma</strong>, <strong data-start=\"1654\" data-end=\"1670\">angiosarcoma</strong>, and <strong data-start=\"1676\" data-end=\"1709\">T-cell lymphoblastic lymphoma</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1711\" data-end=\"1852\">\n<p data-start=\"1713\" data-end=\"1852\"><span style=\"font-size: 10px;\">Interpretation should be done in conjunction with <strong data-start=\"1763\" data-end=\"1784\">clinical findings</strong>, <strong data-start=\"1786\" data-end=\"1800\">morphology</strong>, and other <strong data-start=\"1812\" data-end=\"1827\">IHC markers</strong></span></p>\n</li>\n</ul>",
