  "name": "OCULAR FLUID CULTURE & SENSITIVITY",
  "code": "2210",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"640\" data-end=\"712\">\n<p data-start=\"642\" data-end=\"712\"><span style=\"font-size: 9px;\">Used for detecting <strong data-start=\"661\" data-end=\"695\">bacterial or fungal infections</strong> in ocular fluid.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"713\" data-end=\"814\">\n<p data-start=\"715\" data-end=\"814\"><span style=\"font-size: 9px;\">Helps <strong data-start=\"721\" data-end=\"743\">identify pathogens</strong> responsible for endophthalmitis, uveitis, or postoperative infections.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"815\" data-end=\"902\">\n<p data-start=\"817\" data-end=\"902\"><span style=\"font-size: 9px;\">Guides appropriate <strong data-start=\"836\" data-end=\"872\">antibiotic or antifungal therapy</strong> based on sensitivity results.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"903\" data-end=\"998\">\n<p data-start=\"905\" data-end=\"998\"><span style=\"font-size: 9px;\">\"No Growth\" typically indicates <strong data-start=\"937\" data-end=\"960\">no active infection</strong>; positive culture confirms infection.</span></p>\n</li>\n</ul>",
