  "name": "IHC - Ber-Ep4 (EPCAM)",
  "code": "1982",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1367\" data-end=\"1624\">\n<p data-start=\"1369\" data-end=\"1392\"><span style=\"font-size: 10px;\"><strong data-start=\"1369\" data-end=\"1390\">Ber-EP4 Positive:</strong></span></p>\n<ul data-start=\"1395\" data-end=\"1624\">\n<li style=\"font-size: 10px;\" data-start=\"1395\" data-end=\"1539\">\n<p data-start=\"1397\" data-end=\"1539\"><span style=\"font-size: 10px;\">Typically indicates <strong data-start=\"1417\" data-end=\"1447\">epithelial origin of cells</strong>, useful for distinguishing <strong data-start=\"1475\" data-end=\"1489\">carcinomas</strong> from <strong data-start=\"1495\" data-end=\"1536\">mesothelioma, lymphomas, and sarcomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1542\" data-end=\"1624\">\n<p data-start=\"1544\" data-end=\"1624\"><span style=\"font-size: 10px;\">Often used in panels for identifying <strong data-start=\"1581\" data-end=\"1623\">adenocarcinoma vs. mesothelial lesions</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1626\" data-end=\"1746\">\n<p data-start=\"1628\" data-end=\"1651\"><span style=\"font-size: 10px;\"><strong data-start=\"1628\" data-end=\"1649\">Ber-EP4 Negative:</strong></span></p>\n<ul data-start=\"1654\" data-end=\"1746\">\n<li style=\"font-size: 10px;\" data-start=\"1654\" data-end=\"1746\">\n<p data-start=\"1656\" data-end=\"1746\"><span style=\"font-size: 10px;\">May favor <strong data-start=\"1666\" data-end=\"1719\">mesothelial, hematopoietic, or sarcomatous origin</strong> (depending on morphology).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1748\" data-end=\"1882\">\n<p data-start=\"1750\" data-end=\"1777\"><span style=\"font-size: 10px;\"><strong data-start=\"1750\" data-end=\"1775\">Clinical Correlation:</strong></span></p>\n<ul data-start=\"1780\" data-end=\"1882\">\n<li style=\"font-size: 10px;\" data-start=\"1780\" data-end=\"1882\">\n<p data-start=\"1782\" data-end=\"1882\"><span style=\"font-size: 10px;\">Must be interpreted along with <strong data-start=\"1813\" data-end=\"1858\">H&amp;E morphology and a panel of IHC markers</strong> for accurate diagnosis.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
