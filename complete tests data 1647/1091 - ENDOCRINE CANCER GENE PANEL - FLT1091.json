      "data": {
        "value": "<p>&nbsp;</p>\n<table style=\"height: 372.125px; width: 88.9332%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 17.7912%;\"><strong>Gene</strong></th>\n<th style=\"width: 78.5878%;\"><strong>Associated Cancer(s)</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>RET</strong></td>\n<td style=\"width: 78.5878%;\">Medullary Thyroid Carcinoma (MEN2)</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>MEN1</strong></td>\n<td style=\"width: 78.5878%;\">Parathyroid, Pituitary, Pancreatic tumors</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>VHL</strong></td>\n<td style=\"width: 78.5878%;\">Pheochromocytoma, Hemangioblastoma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>SDHB</strong></td>\n<td style=\"width: 78.5878%;\">Pheochromocytoma/Paraganglioma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>SDHD</strong></td>\n<td style=\"width: 78.5878%;\">Head/Neck Paraganglioma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>MAX</strong></td>\n<td style=\"width: 78.5878%;\">Hereditary Pheochromocytoma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>TMEM127</strong></td>\n<td style=\"width: 78.5878%;\">Adrenal tumors</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>PTEN</strong></td>\n<td style=\"width: 78.5878%;\">Cowden Syndrome (Thyroid, Breast, Endometrial)</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 17.7912%;\"><strong>TP53</strong></td>\n<td style=\"width: 78.5878%;\">Li-Fraumeni Syndrome</td>\n</tr>\n<tr style=\"height: 41px;\">\n<td style=\"width: 17.7912%;\"><strong>CDC73</strong></td>\n<td style=\"width: 78.5878%;\">Parathyroid carcinoma</td>\n</tr>\n</tbody>\n</table>\n<p><strong data-start=\"1405\" data-end=\"1425\">Genetic Findings</strong>:</p>\n<table style=\"height: 159px; width: 89.2598%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 5.9807%;\"><strong>Gene</strong></th>\n<th style=\"width: 34.3928%;\"><strong>Variant</strong></th>\n<th style=\"width: 12.6677%;\"><strong>Zygosity</strong></th>\n<th style=\"width: 15.376%;\"><strong>Pathogenicity</strong></th>\n<th style=\"width: 22.8074%;\"><strong>Clinical Significance</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 41px;\">\n<td style=\"width: 5.9807%;\">RET</td>\n<td style=\"width: 34.3928%;\">c.1900T&gt;C (p.Cys634Arg)</td>\n<td style=\"width: 12.6677%;\">Heterozygous</td>\n<td style=\"width: 15.376%;\">Pathogenic</td>\n<td style=\"width: 22.8074%;\">Associated with MEN2A</td>\n</tr>\n<tr style=\"height: 41px;\">\n<td style=\"width: 5.9807%;\">MEN1</td>\n<td style=\"width: 34.3928%;\">Not Detected</td>\n<td style=\"width: 12.6677%;\">-</td>\n<td style=\"width: 15.376%;\">-</td>\n<td style=\"width: 22.8074%;\">-</td>\n</tr>\n<tr style=\"height: 43px;\">\n<td style=\"width: 5.9807%;\">SDHB</td>\n<td style=\"width: 34.3928%;\">VUS (variant of uncertain significance)</td>\n<td style=\"width: 12.6677%;\">Heterozygous</td>\n<td style=\"width: 15.376%;\">VUS</td>\n<td style=\"width: 22.8074%;\">Needs further evaluation</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
