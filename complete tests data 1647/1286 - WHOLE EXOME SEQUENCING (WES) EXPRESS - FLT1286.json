    {
      "type": "textEditor",
      "data": {
        "value": "<table style=\"width: 96.3353%; height: 402.375px;\">\n<thead>\n<tr style=\"height: 33.7083px;\">\n<th style=\"width: 33.531%;\"><strong>Parameter / Component</strong></th>\n<th style=\"width: 66.3777%;\"><strong>Details</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Gene Coverage</strong></td>\n<td style=\"width: 66.3777%;\">~20,000 protein-coding genes (Exome)</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Variants Analyzed</strong></td>\n<td style=\"width: 66.3777%;\">SNVs, Indels, CNVs (if applicable)</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Zygosity</strong></td>\n<td style=\"width: 66.3777%;\">Homozygous / Heterozygous / Hemizygous</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Pathogenic Variants Identified</strong></td>\n<td style=\"width: 66.3777%;\">Yes / No</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Variant Classification</strong></td>\n<td style=\"width: 66.3777%;\">Based on ACMG guidelines: Pathogenic / Likely Pathogenic / VUS / Benign</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Associated Disorder(s)</strong></td>\n<td style=\"width: 66.3777%;\">Based on identified gene(s)</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Inheritance Pattern</strong></td>\n<td style=\"width: 66.3777%;\">Autosomal dominant / Autosomal recessive / X-linked</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Clinical Correlation</strong></td>\n<td style=\"width: 66.3777%;\">Done based on phenotype &amp; family history</td>\n</tr>\n<tr style=\"height: 53.2917px;\">\n<td style=\"width: 33.531%;\"><strong>Genetic Counseling Recommended</strong></td>\n<td style=\"width: 66.3777%;\">Yes / No</td>\n</tr>\n<tr style=\"height: 45.7083px;\">\n<td style=\"width: 33.531%;\"><strong>Turnaround Time (Express)</strong></td>\n<td style=\"width: 66.3777%;\">7&ndash;10 working days</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
