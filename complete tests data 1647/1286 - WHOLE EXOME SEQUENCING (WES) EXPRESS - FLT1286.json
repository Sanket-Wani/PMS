  "cost": 0,
  "interpretation": "<ul data-start=\"1528\" data-end=\"1897\">\n<li data-start=\"1528\" data-end=\"1671\">\n<p data-start=\"1530\" data-end=\"1671\">Whole Exome Sequencing helps in identifying causative mutations in Mendelian disorders, rare syndromes, and unexplained developmental delays.</p>\n</li>\n<li data-start=\"1672\" data-end=\"1773\">\n<p data-start=\"1674\" data-end=\"1773\"><strong data-start=\"1674\" data-end=\"1718\">Variants of Uncertain Significance (VUS)</strong> may need family studies or reclassification over time.</p>\n</li>\n<li data-start=\"1774\" data-end=\"1897\">\n<p data-start=\"1776\" data-end=\"1897\">Negative result does not rule out all genetic conditions (non-coding variants, mosaicism, epigenetics, etc. not covered).</p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "edta wb",
  "department": "6414fd22f02dc1ebb6a097ef",
