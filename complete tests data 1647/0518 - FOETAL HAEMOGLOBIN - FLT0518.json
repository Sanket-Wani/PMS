  "code": "1555",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"101\" data-end=\"158\">\n<p data-start=\"103\" data-end=\"158\"><strong data-start=\"103\" data-end=\"110\">HbF</strong> is the main hemoglobin in fetuses and newborns.</p>\n</li>\n<li data-start=\"159\" data-end=\"211\">\n<p data-start=\"161\" data-end=\"211\">Composed of <strong data-start=\"173\" data-end=\"210\">2 alpha and 2 gamma chains.</strong></p>\n</li>\n<li data-start=\"212\" data-end=\"270\">\n<p data-start=\"214\" data-end=\"270\">Normally replaced by adult hemoglobin (HbA) after birth.</p>\n</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th><strong>Age Group</strong></th>\n<th><strong>Normal HbF %</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>Newborns (at birth)</strong></td>\n<td>50&ndash;90%</td>\n</tr>\n<tr>\n<td><strong>6 months</strong></td>\n<td>&lt; 5%</td>\n</tr>\n<tr>\n<td><strong>Children/Adults</strong></td>\n<td>&lt; 1&ndash;2%</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th><strong>Elevated HbF (%)</strong></th>\n<th><strong>Possible Causes</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>1&ndash;10%</strong></td>\n<td>Trait conditions, stress erythropoiesis</td>\n</tr>\n<tr>\n<td><strong>&gt;10&ndash;30%</strong></td>\n<td><strong>&beta;-thalassemia intermedia</strong>, hereditary persistence of fetal hemoglobin (HPFH)</td>\n</tr>\n<tr>\n<td><strong>&gt;30&ndash;90%</strong></td>\n<td><strong>&beta;-thalassemia major</strong>, HPFH (homozygous), certain leukemias</td>\n</tr>\n<tr>\n<td><strong>Mild elevation in adults</strong></td>\n<td>Can be seen in bone marrow stress, pregnancy, aplastic anemia</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p data-start=\"1371\" data-end=\"1419\"><strong data-start=\"1375\" data-end=\"1419\">Conditions Associated with Elevated HbF:</strong></p>\n<ul data-start=\"1421\" data-end=\"1776\">\n<li data-start=\"1421\" data-end=\"1457\">\n<p data-start=\"1423\" data-end=\"1457\"><strong data-start=\"1423\" data-end=\"1457\">&beta;-Thalassemia major/intermedia</strong></p>\n</li>\n<li data-start=\"1458\" data-end=\"1513\">\n<p data-start=\"1460\" data-end=\"1513\"><strong data-start=\"1460\" data-end=\"1513\">Hereditary Persistence of Fetal Hemoglobin (HPFH)</strong></p>\n</li>\n<li data-start=\"1514\" data-end=\"1564\">\n<p data-start=\"1516\" data-end=\"1564\"><strong data-start=\"1516\" data-end=\"1539\">Sickle Cell Disease</strong> (especially Sickle/HPFH)</p>\n</li>\n<li data-start=\"1565\" data-end=\"1626\">\n<p data-start=\"1567\" data-end=\"1626\"><strong data-start=\"1567\" data-end=\"1580\">Leukemias</strong> (e.g., juvenile chronic myelogenous leukemia)</p>\n</li>\n<li data-start=\"1627\" data-end=\"1658\">\n<p data-start=\"1629\" data-end=\"1658\"><strong data-start=\"1629\" data-end=\"1658\">Myelodysplastic syndromes</strong></p>\n</li>\n<li data-start=\"1659\" data-end=\"1709\">\n<p data-start=\"1661\" data-end=\"1709\"><strong data-start=\"1661\" data-end=\"1680\">Aplastic anemia</strong> (post-therapy or congenital)</p>\n</li>\n<li data-start=\"1710\" data-end=\"1725\">\n<p data-start=\"1712\" data-end=\"1725\"><strong data-start=\"1712\" data-end=\"1725\">Pregnancy</strong></p>\n</li>\n<li data-start=\"1726\" data-end=\"1776\">\n<p data-start=\"1728\" data-end=\"1776\"><strong data-start=\"1728\" data-end=\"1776\">Hypoxia, high altitude, or chronic hemolysis</strong></p>\n</li>\n</ul>\n<h3 data-start=\"1783\" data-end=\"1804\">&nbsp;</h3>",
