  "interpretation": "<ul data-start=\"1738\" data-end=\"2113\">\n<li data-start=\"1738\" data-end=\"1843\">\n<p data-start=\"1740\" data-end=\"1843\"><strong data-start=\"1740\" data-end=\"1770\">igh-resolution HLA typing</strong> identifies specific <strong data-start=\"1791\" data-end=\"1814\">HLA allele subtypes</strong> (4-digit typing or greater).</p>\n</li>\n<li data-start=\"1844\" data-end=\"2113\">\n<p data-start=\"1846\" data-end=\"1859\">Critical for:</p>\n<ul data-start=\"1862\" data-end=\"2113\">\n<li data-start=\"1862\" data-end=\"1920\">\n<p data-start=\"1864\" data-end=\"1920\"><strong data-start=\"1864\" data-end=\"1905\">Organ and bone marrow transplantation</strong> (HLA matching)</p>\n</li>\n<li data-start=\"1923\" data-end=\"1997\">\n<p data-start=\"1925\" data-end=\"1997\"><strong data-start=\"1925\" data-end=\"1956\">Disease association studies</strong> (e.g., ankylosing spondylitis &ndash; HLA-B27)</p>\n</li>\n<li data-start=\"2000\" data-end=\"2071\">\n<p data-start=\"2002\" data-end=\"2071\"><strong data-start=\"2002\" data-end=\"2032\">Adverse drug reaction risk</strong> (e.g., HLA-B*15:02 with carbamazepine)</p>\n</li>\n<li data-start=\"2074\" data-end=\"2113\">\n<p data-start=\"2076\" data-end=\"2113\"><strong data-start=\"2076\" data-end=\"2113\">Autoimmune disease susceptibility</strong></p>\n</li>\n</ul>\n</li>\n</ul>",
