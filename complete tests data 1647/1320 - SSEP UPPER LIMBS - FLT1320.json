        "value": "<table style=\"height: 176px; width: 99.3963%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 31.4577%;\"><strong>Parameter</strong></th>\n<th style=\"width: 7.65675%;\"><strong>Right</strong></th>\n<th style=\"width: 5.95972%;\"><strong>Left</strong></th>\n<th style=\"width: 19.1475%;\"><strong>Normal Range</strong></th>\n<th style=\"width: 28.0658%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 35px;\">\n<td style=\"width: 31.4577%;\">N9 (Erb&rsquo;s Point) Latency</td>\n<td style=\"width: 7.65675%;\">&nbsp;</td>\n<td style=\"width: 5.95972%;\">&nbsp;</td>\n<td style=\"width: 19.1475%;\">~9 ms</td>\n<td style=\"width: 28.0658%;\">Brachial plexus response</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 31.4577%;\">N13 (Cervical Spine) Latency</td>\n<td style=\"width: 7.65675%;\">&nbsp;</td>\n<td style=\"width: 5.95972%;\">&nbsp;</td>\n<td style=\"width: 19.1475%;\">~13 ms</td>\n<td style=\"width: 28.0658%;\">Cervical cord conduction</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 31.4577%;\">N20 (Cortical) Latency</td>\n<td style=\"width: 7.65675%;\">&nbsp;</td>\n<td style=\"width: 5.95972%;\">&nbsp;</td>\n<td style=\"width: 19.1475%;\">~20 ms</td>\n<td style=\"width: 28.0658%;\">Cortical sensory response</td>\n</tr>\n<tr style=\"height: 37px;\">\n<td style=\"width: 31.4577%;\">Interpeak N13&ndash;N20</td>\n<td style=\"width: 7.65675%;\">&nbsp;</td>\n<td style=\"width: 5.95972%;\">&nbsp;</td>\n<td style=\"width: 19.1475%;\">~7 ms</td>\n<td style=\"width: 28.0658%;\">Central conduction time</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
