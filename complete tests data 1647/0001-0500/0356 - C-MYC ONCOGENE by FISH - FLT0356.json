  "name": "C-MYC ONCOGENE by FISH",
  "code": "1400",
  "cost": 0,
  "interpretation": "<ul data-start=\"2013\" data-end=\"2572\">\n<li data-start=\"2013\" data-end=\"2264\">\n<p data-start=\"2015\" data-end=\"2068\"><span style=\"font-size: 10px;\"><strong data-start=\"2015\" data-end=\"2066\">Positive for C-MYC Rearrangement/Amplification:</strong></span></p>\n<ul data-start=\"2071\" data-end=\"2264\">\n<li style=\"font-size: 10px;\" data-start=\"2071\" data-end=\"2190\">\n<p data-start=\"2073\" data-end=\"2190\"><span style=\"font-size: 10px;\">Suggestive of <strong data-start=\"2087\" data-end=\"2168\">aggressive B-cell lymphomas (e.g., Burkitt lymphoma, Double/Triple-hit DLBCL)</strong> or other neoplasms.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2193\" data-end=\"2264\">\n<p data-start=\"2195\" data-end=\"2264\"><span style=\"font-size: 10px;\">May indicate need for <strong data-start=\"2217\" data-end=\"2263\">intensive chemotherapy or targeted therapy</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2266\" data-end=\"2425\">\n<p data-start=\"2268\" data-end=\"2283\"><span style=\"font-size: 10px;\"><strong data-start=\"2268\" data-end=\"2281\">Negative:</strong></span></p>\n<ul data-start=\"2286\" data-end=\"2425\">\n<li style=\"font-size: 10px;\" data-start=\"2286\" data-end=\"2342\">\n<p data-start=\"2288\" data-end=\"2342\"><span style=\"font-size: 10px;\">No evidence of C-MYC rearrangement or amplification.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2345\" data-end=\"2425\">\n<p data-start=\"2347\" data-end=\"2425\"><span style=\"font-size: 10px;\">Does not exclude lymphoma; interpret with morphology and other genetic panels.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2427\" data-end=\"2572\">\n<p data-start=\"2429\" data-end=\"2463\"><span style=\"font-size: 10px;\"><strong data-start=\"2429\" data-end=\"2461\">Borderline / Mosaic Results:</strong></span></p>\n<ul data-start=\"2466\" data-end=\"2572\">\n<li style=\"font-size: 10px;\" data-start=\"2466\" data-end=\"2572\">\n<p data-start=\"2468\" data-end=\"2572\"><span style=\"font-size: 10px;\">If near threshold, recommend <strong data-start=\"2497\" data-end=\"2571\">repeat FISH or additional molecular testing (NGS, IHC for MYC protein)</strong>.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
