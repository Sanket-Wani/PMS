      "data": {
        "value": "<table style=\"height: 380.083px; width: 99.492%;\">\n<thead>\n<tr style=\"height: 33.7083px;\">\n<th style=\"width: 13.6211%;\"><strong>Panel</strong></th>\n<th style=\"width: 22.4347%;\"><strong>Marker / Antigen</strong></th>\n<th style=\"width: 26.7843%;\"><strong>Result</strong> (Expression)</th>\n<th style=\"width: 37.2004%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\"><strong>WBC Panel</strong></td>\n<td style=\"width: 22.4347%;\">CD45</td>\n<td style=\"width: 26.7843%;\">Positive (Pan-leukocyte)</td>\n<td style=\"width: 37.2004%;\">Confirms leukocyte lineage</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD34</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Stem/progenitor cell marker</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD13, CD33</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Myeloid markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD117, HLA-DR</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Early myeloid markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD19, CD10</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">B-lineage markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD3, CD4, CD8</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">T-lineage markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD14, CD64</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Monocytic markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD7, CD56</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Aberrant expression / NK markers</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 13.6211%;\"><strong>RBC Panel</strong></td>\n<td style=\"width: 22.4347%;\">Glycophorin A</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Erythroid lineage marker</td>\n</tr>\n<tr style=\"height: 43px;\">\n<td style=\"width: 13.6211%;\">&nbsp;</td>\n<td style=\"width: 22.4347%;\">CD71</td>\n<td style=\"width: 26.7843%;\">+/-</td>\n<td style=\"width: 37.2004%;\">Immature erythroid cell marker</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
