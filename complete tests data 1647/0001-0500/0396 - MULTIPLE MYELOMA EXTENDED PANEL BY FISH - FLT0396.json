        "value": "<table style=\"height: 271px; width: 94.3892%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 28.1673%;\"><strong>Chromosomal Abnormality</strong></th>\n<th style=\"width: 13.8756%;\"><strong>Gene / Locus</strong></th>\n<th style=\"width: 20.8074%;\"><strong>Result</strong></th>\n<th style=\"width: 30.6221%;\"><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">t(4;14)(p16;q32)</td>\n<td style=\"width: 13.8756%;\">FGFR3/IGH</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">Associated with high-risk MM</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">t(14;16)(q32;q23)</td>\n<td style=\"width: 13.8756%;\">IGH/MAF</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">Poor prognosis</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">t(11;14)(q13;q32)</td>\n<td style=\"width: 13.8756%;\">CCND1/IGH</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">May respond to BCL2 inhibitors</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">del(13q14.3)</td>\n<td style=\"width: 13.8756%;\">RB1 / D13S319</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">Poor risk marker</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">del(17p13)</td>\n<td style=\"width: 13.8756%;\">TP53</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">High-risk myeloma</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 28.1673%;\">1q21 Gain (Gain of 1q)</td>\n<td style=\"width: 13.8756%;\">CKS1B</td>\n<td style=\"width: 20.8074%;\">Detected / Not Detected</td>\n<td style=\"width: 30.6221%;\">Associated with aggressive disease</td>\n</tr>\n<tr style=\"height: 39px;\">\n<td style