  "cost": 0,
  "interpretation": "<table><thead><tr><th><div><span style=\"font-size: 10px;\">APTT Test Result</span></div></th><th><div><span style=\"font-size: 10px;\">Interpretation</span></div></th></tr></thead><tbody><tr><td><div><span style=\"font-size: 10px;\">Prolonged APTT</span></div></td><td><div><span style=\"font-size: 10px;\">Indication of a clotting factor deficiency, including but not limited to deficiencies in factors VIII, IX, XI, and XII; presence of a lupus anticoagulant; presence of an inhibitor to a clotting factor; liver disease; or use of certain medications such as heparin</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Shortened APTT</span></div></td><td><div><span style=\"font-size: 10px;\">May indicate hypercoagulability, which can occur in some genetic disorders or as a side effect of certain medications such as estrogen therapy</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Normal APTT</span></div></td><td><div><span style=\"font-size: 10px;\">Indicates normal clotting function</span></div></td></tr></tbody></table>",
