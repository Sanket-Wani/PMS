  "code": "1190",
  "cost": 0,
  "interpretation": "<ul data-start=\"1407\" data-end=\"1905\">\n<li data-start=\"1407\" data-end=\"1513\">\n<p data-start=\"1409\" data-end=\"1428\"><span style=\"font-size: 9px;\"><strong data-start=\"1409\" data-end=\"1426\">Normal Ratio:</strong></span></p>\n<ul data-start=\"1431\" data-end=\"1513\">\n<li style=\"font-size: 9px;\" data-start=\"1431\" data-end=\"1474\">\n<p data-start=\"1433\" data-end=\"1474\"><span style=\"font-size: 9px;\"><strong data-start=\"1433\" data-end=\"1448\">&lt;0.20 mg/mg</strong> in adults (spot urine).</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1477\" data-end=\"1513\">\n<p data-start=\"1479\" data-end=\"1513\"><span style=\"font-size: 9px;\">Suggests normal calcium excretion.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1515\" data-end=\"1803\">\n<p data-start=\"1517\" data-end=\"1552\"><span style=\"font-size: 9px;\"><strong data-start=\"1517\" data-end=\"1550\">Elevated Ratio (&gt;0.20 mg/mg):</strong></span></p>\n<ul data-start=\"1555\" data-end=\"1803\">\n<li style=\"font-size: 9px;\" data-start=\"1555\" data-end=\"1733\">\n<p data-start=\"1557\" data-end=\"1608\"><span style=\"font-size: 9px;\">May indicate <strong data-start=\"1570\" data-end=\"1588\">hypercalciuria</strong>, associated with:</span></p>\n<ul data-start=\"1613\" data-end=\"1733\">\n<li style=\"font-size: 9px;\" data-start=\"1613\" data-end=\"1648\">\n<p data-start=\"1615\" data-end=\"1648\"><span style=\"font-size: 9px;\">Nephrolithiasis (kidney stones)</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1653\" data-end=\"1676\">\n<p data-start=\"1655\" data-end=\"1676\"><span style=\"font-size: 9px;\">Hyperparathyroidism</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1681\" data-end=\"1701\">\n<p data-start=\"1683\" data-end=\"1701\"><span style=\"font-size: 9px;\">Vitamin D excess</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1706\" data-end=\"1733\">\n<p data-start=\"1708\" data-end=\"1733\"><span style=\"font-size: 9px;\">Renal tubular disorders</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1736\" data-end=\"1803\">\n<p data-start=\"1738\" data-end=\"1803\"><span style=\"font-size: 9px;\">Consider confirming with <strong data-start=\"1763\" data-end=\"1790\">24-hour urinary calcium</strong> measurement.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1805\" data-end=\"1905\">\n<p data-start=\"1807\" data-end=\"1823\"><span style=\"font-size: 9px;\"><strong data-start=\"1807\" data-end=\"1821\">Low Ratio:</strong></span></p>\n<ul data-start=\"1826\" data-end=\"1905\">\n<li style=\"font-size: 9px;\" data-start=\"1826\" data-end=\"1905\">\n<p data-start=\"1828\" data-end=\"1905\"><span style=\"font-size: 9px;\">Typically not clinically significant unless part of broader renal evaluation.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
