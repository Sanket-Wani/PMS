  "name": "AMNIOCENTESIS + PND KARYOTYPING",
  "code": "1395",
  "cost": 0,
  "interpretation": "<ol data-start=\"2277\" data-end=\"2907\">\n<li data-start=\"2277\" data-end=\"2437\">\n<p data-start=\"2280\" data-end=\"2303\"><span style=\"font-size: 10px;\"><strong data-start=\"2280\" data-end=\"2301\">Normal Karyotype:</strong></span></p>\n<ul data-start=\"2307\" data-end=\"2437\">\n<li style=\"font-size: 10px;\" data-start=\"2307\" data-end=\"2388\">\n<p data-start=\"2309\" data-end=\"2388\"><span style=\"font-size: 10px;\">46,XX (female) or 46,XY (male) without numerical or structural abnormalities.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2392\" data-end=\"2437\">\n<p data-start=\"2394\" data-end=\"2437\"><span style=\"font-size: 10px;\">Indicates no major chromosomal abnormality.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2439\" data-end=\"2714\">\n<p data-start=\"2442\" data-end=\"2467\"><span style=\"font-size: 10px;\"><strong data-start=\"2442\" data-end=\"2465\">Abnormal Karyotype:</strong></span></p>\n<ul data-start=\"2471\" data-end=\"2714\">\n<li style=\"font-size: 10px;\" data-start=\"2471\" data-end=\"2554\">\n<p data-start=\"2473\" data-end=\"2554\"><span style=\"font-size: 10px;\">Numerical abnormalities (e.g., Trisomy 21, Trisomy 18, Trisomy 13, Monosomy X).</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2558\" data-end=\"2629\">\n<p data-start=\"2560\" data-end=\"2629\"><span style=\"font-size: 10px;\">Structural changes (e.g., translocations, deletions, duplications).</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2633\" data-end=\"2714\">\n<p data-start=\"2635\" data-end=\"2714\"><span style=\"font-size: 10px;\">Requires genetic counseling and correlation with ultrasound/maternal screening.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2716\" data-end=\"2907\">\n<p data-start=\"2719\" data-end=\"2740\"><span style=\"font-size: 10px;\"><strong data-start=\"2719\" data-end=\"2738\">Clinical Notes:</strong></span></p>\n<ul data-start=\"2744\" data-end=\"2907\">\n<li style=\"font-size: 10px;\" data-start=\"2744\" data-end=\"2831\">\n<p data-start=\"2746\" data-end=\"2831\"><span style=\"font-size: 10px;\">Negative result does not exclude all genetic disorders (e.g., single gene defects).</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2835\" data-end=\"2907\">\n<p data-start=\"2837\" data-end=\"2907\"><span style=\"font-size: 10px;\">Consider additional testing (FISH/microarray) if clinically indicated.</span></p>\n</li>\n</ul>\n</li>\n</ol>",
