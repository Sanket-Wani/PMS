        "value": "<table class=\"cke_show_border\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td><strong>Sample Type&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong></td>\n<td>: Amniotic fluid</td>\n</tr>\n<tr>\n<td><strong>Clinical Indication</strong></td>\n<td>: Risk for Trisomy 21 (1:148) in Quadruple Marker Test</td>\n</tr>\n<tr>\n<td><strong>Culture Type</strong></td>\n<td>: Long term culture</td>\n</tr>\n<tr>\n<td><strong>Medium</strong></td>\n<td>: Amniomax</td>\n</tr>\n<tr>\n<td><strong>Banding Technique</strong></td>\n<td>: GTG</td>\n</tr>\n<tr>\n<td><strong>Banding Resolution</strong></td>\n<td>: 400-550</td>\n</tr>\n<tr>\n<td><strong>Metaphases Counted</strong></td>\n<td>: 20</td>\n</tr>\n<tr>\n<td><strong>Metaphases Analysed</strong></td>\n<td>: 20</td>\n</tr>\n<tr>\n<td><strong>Metaphase karyotyped</strong></td>\n<td>: 10</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><strong>RESULT</strong></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><strong>Karyotype</strong></td>\n<td>: <strong>46,NN</strong></td>\n</tr>\n<tr>\n<td><strong>Diagnosis</strong></td>\n<td>: Normal Karyotype&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p><u>Note: As per the Pre-Conception and Pre-Natal Diagnostic Techniques (PCPNDT) Act, 1994, sex of the fetus is not revealed.</u><br><br></p>\n<p><strong>Interpretation:&nbsp;</strong><br>All the analysed metaphases in the given specimen showed&nbsp;a normal karyotype without apparent numerical or structural abnormality.</p>",
