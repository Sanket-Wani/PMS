  "name": "Absolute Eosinophils Count (AEC)",
  "code": "AEC",
  "cost": 0,
  "interpretation": "<p><span style=\"font-size: 10px;\">The Absolute Eosinophil Count (AEC) test is a blood test that measures the number of eosinophils, a type of white blood cell, present in the blood.</span></p><table><thead><tr><th><div><span style=\"font-size: 10px;\">AEC Result</span></div></th><th><div><span style=\"font-size: 10px;\">Interpretation</span></div></th></tr></thead><tbody><tr><td><div><span style=\"font-size: 10px;\">Less than 30 eosinophils/mcL</span></div></td><td><div><span style=\"font-size: 10px;\">Normal</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">30-350 eosinophils/mcL</span></div></td><td><div><span style=\"font-size: 10px;\">Normal range</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">350-500 eosinophils/mcL</span></div></td><td><div><span style=\"font-size: 10px;\">Mildly elevated, possible indication of allergic reaction or infection caused by parasites</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Above 500 eosinophils/mcL</span></div></td><td><div><span style=\"font-size: 10px;\">Significantly elevated, possible indication of autoimmune diseases or certain types of cancer</span></div></td></tr></tbody></table><p><span style=\"font-size: 10px;\"></span><br></p>",
