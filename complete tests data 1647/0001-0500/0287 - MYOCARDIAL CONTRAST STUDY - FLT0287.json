      "type": "textEditor",
      "data": {
        "value": "<p data-start=\"618\" data-end=\"637\"><strong data-start=\"622\" data-end=\"635\">Findings:</strong></p>\n<ul data-start=\"638\" data-end=\"945\">\n<li data-start=\"638\" data-end=\"716\">\n<p data-start=\"640\" data-end=\"716\"><strong data-start=\"640\" data-end=\"670\">Left Ventricular Function:</strong> Normal chamber size, preserved wall motion.</p>\n</li>\n<li data-start=\"717\" data-end=\"791\">\n<p data-start=\"719\" data-end=\"791\"><strong data-start=\"719\" data-end=\"739\">Contrast Uptake:</strong> Homogeneous myocardial perfusion in all segments.</p>\n</li>\n<li data-start=\"792\" data-end=\"828\">\n<p data-start=\"794\" data-end=\"828\"><strong data-start=\"794\" data-end=\"821\">Ejection Fraction (EF):</strong> 65%.</p>\n</li>\n<li data-start=\"829\" data-end=\"870\">\n<p data-start=\"831\" data-end=\"870\"><strong data-start=\"831\" data-end=\"853\">Perfusion Defects:</strong> None detected.</p>\n</li>\n<li data-start=\"871\" data-end=\"945\">\n<p data-start=\"873\" data-end=\"945\"><strong data-start=\"873\" data-end=\"883\">Other:</strong> No thrombus or abnormal intracardiac contrast distribution.</p>\n</li>\n</ul>\n<p data-start=\"952\" data-end=\"973\"><strong data-start=\"956\" data-end=\"971\">Impression:</strong></p>\n<ul data-start=\"974\" data-end=\"1127\">\n<li data-start=\"974\" data-end=\"1024\">\n<p data-start=\"976\" data-end=\"1024\">Normal myocardial perfusion and contractility.</p>\n</li>\n<li data-start=\"1025\" data-end=\"1077\">\n<p data-start=\"1027\" data-end=\"1077\">No evidence of scarred or non-viable myocardium.</p>\n</li>\n<li data-start=\"1078\" data-end=\"1127\">\n<p data-start=\"1080\" data-end=\"1127\">Preserved left ventricular systolic function.</p>\n</li>\n</ul>",
        "field": "textEditor"
      },
