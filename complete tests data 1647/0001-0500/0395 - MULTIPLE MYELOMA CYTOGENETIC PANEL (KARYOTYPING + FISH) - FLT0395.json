  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>Category</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Finding</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">Cytogenetic Risk</span></td>\n<td><span style=\"font-size: 10px;\">Standard / Intermediate / High Risk (based on FISH and Karyotype)</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Prognosis</span></td>\n<td><span style=\"font-size: 10px;\">Favorable / Unfavorable depending on abnormalities</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Clinical Notes</span></td>\n<td><span style=\"font-size: 10px;\">Correlate with clinical, biochemical, and pathological findings</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"3307\" data-end=\"3322\"><span style=\"font-size: 10px;\"><strong data-start=\"3311\" data-end=\"3322\">Remarks</strong></span></h3>\n<ul data-start=\"3324\" data-end=\"3656\">\n<li style=\"font-size: 10px;\" data-start=\"3324\" data-end=\"3415\">\n<p data-start=\"3326\" data-end=\"3415\"><span style=\"font-size: 10px;\"><strong data-start=\"3326\" data-end=\"3334\">FISH</strong> enhances sensitivity in detecting clinically relevant chromosomal abnormalities.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3416\" data-end=\"3551\">\n<p data-start=\"3418\" data-end=\"3551\"><span style=\"font-size: 10px;\">Findings should be integrated with <strong data-start=\"3453\" data-end=\"3479\">bone marrow morphology</strong>, <strong data-start=\"3481\" data-end=\"3501\">M-protein levels</strong>, <strong data-start=\"3503\" data-end=\"3524\">immunophenotyping</strong>, and <strong data-start=\"3530\" data-end=\"3550\">clinical staging</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3552\" data-end=\"3656\">\n<p data-start=\"3554\" data-end=\"3656\"><span style=\"font-size: 10px;\">Abnormal results guide risk-adapted therapy (e.g., transplant eligibility, maintenance, novel agents).</span></p>\n</li>\n</ul>",
