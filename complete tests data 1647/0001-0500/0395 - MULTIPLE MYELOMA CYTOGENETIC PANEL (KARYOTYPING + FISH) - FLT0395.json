      "data": {
        "value": "<p><strong>Karyotyping Results</strong></p>\n<table style=\"width: 78.4978%;\">\n<thead>\n<tr>\n<th style=\"width: 37.0837%;\"><span style=\"font-size: 10px;\"><strong>Karyotype</strong></span></th>\n<th style=\"width: 63.1159%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 37.0837%;\"><span style=\"font-size: 10px;\">Normal Male/Female Karyotype</span></td>\n<td style=\"width: 63.1159%;\"><span style=\"font-size: 10px;\">No structural or numerical chromosomal abnormalities</span></td>\n</tr>\n<tr>\n<td style=\"width: 37.0837%;\"><span style=\"font-size: 10px;\">Abnormal Karyotype</span></td>\n<td style=\"width: 63.1159%;\"><span style=\"font-size: 10px;\">e.g., del(13q), +1q, complex karyotype, etc.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"1597\" data-end=\"1626\"><span style=\"font-size: 10px;\"><strong data-start=\"1604\" data-end=\"1626\">FISH Panel Results</strong></span></h3>\n<table style=\"width: 77.9555%;\">\n<thead>\n<tr>\n<th style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>Probe Target</strong></span></th>\n<th style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\"><strong>Result</strong> (Positive/Negative)</span></th>\n<th style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\"><strong>% Abnormal Cells</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>t(11;14)(q13;q32) &ndash; CCND1/IGH</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>t(4;14)(p16;q32) &ndash; FGFR3/IGH</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>t(14;16)(q32;q23) &ndash; IGH/MAF</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>Deletion 17p13 &ndash; TP53</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>1q21 Gain &ndash; CKS1B</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n<tr>\n<td style=\"width: 39.4929%;\"><span style=\"font-size: 10px;\"><strong>13q14 Deletion &ndash; RB1/LAMP1</strong></span></td>\n<td style=\"width: 34.3735%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n<td style=\"width: 26.0848%;\"><span style=\"font-size: 10px;\">___%</span></td>\n</tr>\n</tbody>\n</table>\n<div class=\"_tableContainer_80l1q_1\">\n<div class=\"_tableWrapper_80l1q_14 group flex w-fit flex-col-reverse\" tabindex=\"-1\">&nbsp;</div>\n</div>",
