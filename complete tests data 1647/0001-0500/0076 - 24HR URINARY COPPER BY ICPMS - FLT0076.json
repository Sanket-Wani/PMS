  "name": "24HR URINARY COPPER BY ICPMS",
  "code": "1065",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1096\" data-end=\"1169\">\n<p data-start=\"1098\" data-end=\"1128\"><span style=\"font-size: 10px;\"><strong data-start=\"1098\" data-end=\"1126\">Normal Copper Excretion:</strong></span></p>\n<ul data-start=\"1131\" data-end=\"1169\">\n<li style=\"font-size: 10px;\" data-start=\"1131\" data-end=\"1169\">\n<p data-start=\"1133\" data-end=\"1169\"><span style=\"font-size: 10px;\">15 &ndash; 60 &micro;g/24 hrs in healthy adults.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1171\" data-end=\"1420\">\n<p data-start=\"1173\" data-end=\"1212\"><span style=\"font-size: 10px;\"><strong data-start=\"1173\" data-end=\"1210\">Elevated Levels (&gt;100 &micro;g/24 hrs):</strong></span></p>\n<ul data-start=\"1215\" data-end=\"1420\">\n<li style=\"font-size: 10px;\" data-start=\"1215\" data-end=\"1320\">\n<p data-start=\"1217\" data-end=\"1320\"><span style=\"font-size: 10px;\">May indicate <strong data-start=\"1230\" data-end=\"1317\">Wilson&rsquo;s disease, cholestatic liver disease, copper toxicity, or excessive exposure</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1323\" data-end=\"1420\">\n<p data-start=\"1325\" data-end=\"1420\"><span style=\"font-size: 10px;\">Should be correlated with <strong data-start=\"1351\" data-end=\"1419\">serum ceruloplasmin, liver function tests, and clinical findings</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1422\" data-end=\"1528\">\n<p data-start=\"1424\" data-end=\"1441\"><span style=\"font-size: 10px;\"><strong data-start=\"1424\" data-end=\"1439\">Low Levels:</strong></span></p>\n<ul data-start=\"1444\" data-end=\"1528\">\n<li style=\"font-size: 10px;\" data-start=\"1444\" data-end=\"1528\">\n<p data-start=\"1446\" data-end=\"1528\"><span style=\"font-size: 10px;\">May be seen in <strong data-start=\"1461\" data-end=\"1527\">malnutrition, malabsorption, or excessive zinc supplementation</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1530\" data-end=\"1632\">\n<p data-start=\"1532\" data-end=\"1560\"><span style=\"font-size: 10px;\"><strong data-start=\"1532\" data-end=\"1558\">Creatinine Correction:</strong></span></p>\n<ul data-start=\"1563\" data-end=\"1632\">\n<li style=\"font-size: 10px;\" data-start=\"1563\" data-end=\"1632\">\n<p data-start=\"1565\" data-end=\"1632\"><span style=\"font-size: 10px;\">Ensures proper 24-hour urine collection and helps validate results.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
