  "interpretation": "<table class=\"border-borderMain my-[1em] w-full table-auto border\">\n<thead class=\"bg-offset\">\n<tr>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><span style=\"font-size: 10px;\">Analyte</span></th>\n<th class=\"border-borderMain px-sm py-sm dark:border-borderMainDark break-normal border text-left align-top\"><span style=\"font-size: 10px;\">Interpretation</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">VLCFA results within reference limits</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">No laboratory evidence of a peroxisomal disorder</span></td>\n</tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">&uarr; C26:0 or &uarr; ratios (C24:0/C22:0, C26:0/C22:0)</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">Suggestive of peroxisomal disorder (e.g., X-linked adrenoleukodystrophy, Zellweger spectrum)&nbsp;</span></td>\n</tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">&uarr; Phytanic/Pristanic acid</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">May indicate Refsum disease or other rare peroxisomal disorders&nbsp;</span></td>\n</tr>\n<tr>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">Mildly increased VLCFA</span></td>\n<td class=\"border-borderMain px-sm dark:border-borderMainDark min-w-[48px] break-normal border\"><span style=\"font-size: 10px;\">May occur in heterozygous carriers or with improper fasting</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
