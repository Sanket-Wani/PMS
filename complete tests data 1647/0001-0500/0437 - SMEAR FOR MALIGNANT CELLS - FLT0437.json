    {
      "type": "textEditor",
      "data": {
        "value": "<p><span style=\"font-size: 10px;\"><strong>Microscopic Examination</strong></span></p>\n<table style=\"width: 83.3785%;\">\n<thead>\n<tr>\n<th style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\"><strong>Observation</strong></span></th>\n<th style=\"width: 69.077%;\"><span style=\"font-size: 10px;\"><strong>Findings</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Cellularity</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Low / Moderate / High</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Background</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Clean / Proteinaceous / Inflammatory</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Mesothelial Cells</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Present / Reactive / Atypical</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Inflammatory Cells</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Neutrophils / Lymphocytes / Mixed</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Malignant Cells</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Present / Not Seen</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Cell Arrangement</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Clusters / Sheets / Isolated Cells</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Nuclear Features</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Enlarged nuclei, Hyperchromasia, Pleomorphism</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Cytoplasmic Features</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Vacuolated / Dense / Mucinous</span></td>\n</tr>\n<tr>\n<td style=\"width: 30.8642%;\"><span style=\"font-size: 10px;\">Conclusion</span></td>\n<td style=\"width: 69.077%;\"><span style=\"font-size: 10px;\">Suggestive / Not Suggestive of Malignancy</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><span style=\"font-size: 10px;\"><strong>Final Impression</strong></span></p>\n<table style=\"width: 83.9208%;\">\n<thead>\n<tr>\n<th style=\"width: 28.4895%;\"><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n<th style=\"width: 71.7067%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 28.4895%;\"><span style=\"font-size: 10px;\">Malignant Cells Seen</span></td>\n<td style=\"width: 71.7067%;\"><span style=\"font-size: 10px;\">Positive for malignancy &ndash; suggestive of metastatic involvement</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.4895%;\"><span style=\"font-size: 10px;\">No Malignant Cells Seen</span></td>\n<td style=\"width: 71.7067%;\"><span style=\"font-size: 10px;\">Negative &ndash; no evidence of malignancy</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.4895%;\"><span style=\"font-size: 10px;\">Atypical Cells Present</span></td>\n<td style=\"width: 71.7067%;\"><span style=\"font-size: 10px;\">Suspicious &ndash; Correlation with clinical &amp; IHC advised</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
