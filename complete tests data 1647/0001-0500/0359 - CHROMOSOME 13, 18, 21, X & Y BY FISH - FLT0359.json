  "interpretation": "<ul>\n<li data-start=\"1169\" data-end=\"1307\">\n<p data-start=\"1171\" data-end=\"1307\"><span style=\"font-size: 9px;\"><strong data-start=\"1171\" data-end=\"1202\">Trisomy 13 (Patau syndrome)</strong>, <strong data-start=\"1204\" data-end=\"1237\">Trisomy 18 (Edwards syndrome)</strong>, and <strong data-start=\"1243\" data-end=\"1273\">Trisomy 21 (Down syndrome)</strong> are common aneuploidies screened.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1308\" data-end=\"1409\">\n<p data-start=\"1310\" data-end=\"1409\"><span style=\"font-size: 9px;\"><strong data-start=\"1310\" data-end=\"1341\">Sex chromosome aneuploidies</strong> such as Turner (45,X), Klinefelter (47,XXY) can also be identified.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1410\" data-end=\"1475\">\n<p data-start=\"1412\" data-end=\"1475\"><span style=\"font-size: 9px;\">FISH provides rapid prenatal or postnatal aneuploidy detection.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1476\" data-end=\"1553\">\n<p data-start=\"1478\" data-end=\"1553\"><span style=\"font-size: 9px;\">Confirmation with <strong data-start=\"1496\" data-end=\"1511\">karyotyping</strong> or <strong data-start=\"1515\" data-end=\"1536\">molecular testing</strong> may be required.</span></p>\n</li>\n</ul>",
