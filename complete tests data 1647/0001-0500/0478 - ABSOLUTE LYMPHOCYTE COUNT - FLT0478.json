  "name": "ABSOLUTE LYMPHOCYTE COUNT",
  "code": "1524",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"962\" data-end=\"1152\">\n<p data-start=\"964\" data-end=\"992\"><span style=\"font-size: 10px;\"><strong data-start=\"964\" data-end=\"990\">Lymphocytosis (&uarr; ALC):</strong></span></p>\n<ul data-start=\"995\" data-end=\"1152\">\n<li style=\"font-size: 10px;\" data-start=\"995\" data-end=\"1022\">\n<p data-start=\"997\" data-end=\"1022\"><span style=\"font-size: 10px;\">Adults: &gt;4,800 cells/&micro;L</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1025\" data-end=\"1152\">\n<p data-start=\"1027\" data-end=\"1152\"><span style=\"font-size: 10px;\">May indicate <strong data-start=\"1040\" data-end=\"1151\">viral infections (EBV, CMV, hepatitis), chronic lymphocytic leukemia (CLL), pertussis, autoimmune disorders</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1154\" data-end=\"1327\">\n<p data-start=\"1156\" data-end=\"1186\"><span style=\"font-size: 10px;\"><strong data-start=\"1156\" data-end=\"1184\">Lymphocytopenia (&darr; ALC):</strong></span></p>\n<ul data-start=\"1189\" data-end=\"1327\">\n<li style=\"font-size: 10px;\" data-start=\"1189\" data-end=\"1216\">\n<p data-start=\"1191\" data-end=\"1216\"><span style=\"font-size: 10px;\">Adults: &lt;1,000 cells/&micro;L</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1219\" data-end=\"1327\">\n<p data-start=\"1221\" data-end=\"1327\"><span style=\"font-size: 10px;\">May occur in <strong data-start=\"1234\" data-end=\"1326\">HIV infection, bone marrow suppression, chemotherapy, severe stress, autoimmune diseases</strong>.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1329\" data-end=\"1431\">\n<p data-start=\"1331\" data-end=\"1431\"><span style=\"font-size: 10px;\">Should be correlated with <strong data-start=\"1357\" data-end=\"1430\">clinical context, differential count, and other hematology parameters</strong>.</span></p>\n</li>\n</ul>",
