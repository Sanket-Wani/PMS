      "data": {
        "value": "<p><span style=\"font-size: 9px;\"><strong>CYTOLOGY LBC (LBC)</strong></span></p>\n<p><br><span style=\"font-size: 9px;\"><strong>SPECIMEN: PAP SMEAR - Liquid Based Cytology (LBC)</strong></span></p>\n<p><br><span style=\"font-size: 9px;\"><strong>Clinical Notes &ndash;</strong></span></p>\n<p><br><span style=\"font-size: 9px;\"><strong>Gross Examination: Specimen received in PreservCyt solution vial</strong></span></p>\n<p><br><span style=\"font-size: 9px;\"><strong>MICROSCOPIC EXAMINATION</strong></span></p>\n<table style=\"border-collapse: collapse; width: 99%;\" border=\"1\">\n<thead>\n<tr>\n<th><span style=\"font-size: 9px;\"><strong>Parameter</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Result</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Specimen Adequacy</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Adequate</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Atrophy</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Absent</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Repair</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Nil</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Inflammation</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Marked</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Parabasal Cells</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Few</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Clue Cells</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Seen</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Endometrial Cells</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Seen</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Epithelial Cell Abnormalities</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Detected</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Squamous Cells Abnormalities</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Detected</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Glandular Cells Abnormalities</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Detected</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Trichomonas Vaginalis</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Seen</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Fungal organisms</strong></span></td>\n<td><span style=\"font-size: 9px;\"><strong>Not Seen</strong></span></td>\n</tr>\n</tbody>\n</table>\n<p><span style=\"font-size: 9px;\"><strong>IMPRESSION: SUGGESTIVE OF INFLAMMATORY SMEAR (NEGATIVE FOR INTRAEPITHELIAL</strong></span><br><span style=\"font-size: 9px;\"><strong>LESION/MALIGNANCY)</strong></span></p>",
