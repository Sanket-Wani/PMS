  "interpretation": "<div class=\"_tableContainer_80l1q_1\">\n<div class=\"_tableWrapper_80l1q_14 group flex w-fit flex-col-reverse\" tabindex=\"-1\">\n<table class=\"w-fit min-w-(--thread-content-width)\" data-start=\"1371\" data-end=\"1981\">\n<thead data-start=\"1371\" data-end=\"1499\">\n<tr data-start=\"1371\" data-end=\"1499\">\n<th data-start=\"1371\" data-end=\"1389\" data-col-size=\"sm\">Result</th>\n<th data-start=\"1389\" data-end=\"1499\" data-col-size=\"lg\">Interpretation &amp; Clinical Significance</th>\n</tr>\n</thead>\n<tbody data-start=\"1630\" data-end=\"1981\">\n<tr data-start=\"1630\" data-end=\"1817\">\n<td data-start=\"1630\" data-end=\"1650\" data-col-size=\"sm\">Positive</td>\n<td data-col-size=\"lg\" data-start=\"1650\" data-end=\"1817\">GATA-3 expression detected. Supports origin from breast, urothelial, salivary gland, or some T-cell neoplasms. Correlate with morphology and other markers.</td>\n</tr>\n<tr data-start=\"1818\" data-end=\"1981\">\n<td data-start=\"1818\" data-end=\"1838\" data-col-size=\"sm\">Negative</td>\n<td data-col-size=\"lg\" data-start=\"1838\" data-end=\"1981\">GATA-3 not detected. Less likely to be of GATA-3 expressing lineage (e.g., breast or urothelial origin). Further IHC work-up may be needed.</td>\n</tr>\n</tbody>\n</table>\n<div class=\"sticky end-(--thread-content-margin) h-0 self-end select-none\">\n<div class=\"absolute end-0 flex items-end\">&nbsp;</div>\n</div>\n</div>\n</div>",
