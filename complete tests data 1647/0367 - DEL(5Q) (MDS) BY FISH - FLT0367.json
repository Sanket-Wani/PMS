  "interpretation": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\"><strong>Result Category</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Description</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative (Normal 5q)</span></td>\n<td><span style=\"font-size: 10px;\">Two signals in &gt;95% nuclei; no deletion detected.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive (Del(5q))</span></td>\n<td><span style=\"font-size: 10px;\">One signal (deletion) in &ge;5% nuclei; consistent with MDS or related myeloid neoplasm.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Mosaic/Low-Level Clone</span></td>\n<td><span style=\"font-size: 10px;\">Deletion in &lt;5% of cells; correlate with bone marrow findings, morphology, and karyotype.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
