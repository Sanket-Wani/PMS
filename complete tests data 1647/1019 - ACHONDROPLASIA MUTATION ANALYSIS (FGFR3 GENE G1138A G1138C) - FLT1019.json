  "name": "ACHONDROPLASIA MUTATION ANALYSIS (FGFR3 GENE G1138A G1138C)",
  "code": "2258",
  "cost": 0,
  "interpretation": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\"><strong>Result Category</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Description</strong></span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive - Heterozygous (G1138A or G1138C)</span></td>\n<td><span style=\"font-size: 10px;\">Confirms achondroplasia diagnosis; usually associated with short-limbed dwarfism, normal intelligence, normal life expectancy.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Positive - Homozygous</span></td>\n<td><span style=\"font-size: 10px;\">Typically results in perinatal lethal skeletal dysplasia; urgent genetic counseling needed.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Negative</span></td>\n<td><span style=\"font-size: 10px;\">No G1138A/C variants detected; does not exclude other FGFR3-related skeletal dysplasias (further testing may be needed).</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">Variant of Uncertain Significance (VUS)</span></td>\n<td><span style=\"font-size: 10px;\">Rare or novel FGFR3 change; clinical correlation and possibly parental studies recommended.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
