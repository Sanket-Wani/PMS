  "interpretation": "<table style=\"border-collapse: collapse; width: 71.7262%;\" border=\"1\"><colgroup><col style=\"width: 50.023%;\"><col style=\"width: 50.023%;\"></colgroup>\n<tbody>\n<tr>\n<td><strong>Reference Group</strong></td>\n<td><strong>&nbsp;Reference Range in pg/mL</strong></td>\n</tr>\n<tr>\n<td>Adult</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>Males</td>\n<td>&nbsp;250.00 - 990.00</td>\n</tr>\n<tr>\n<td>Females</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td>Prememopausal</td>\n<td>&nbsp;24.00 - 368.00</td>\n</tr>\n<tr>\n<td>Postmenopausal</td>\n<td>&nbsp;10.00 - 181.00</td>\n</tr>\n<tr>\n<td>Children</td>\n<td>Not Established</td>\n</tr>\n</tbody>\n</table>\n<p><strong>Clinical Use</strong></p>\n<ul>\n<li>Assess Pseudohermaphroditism</li>\n<li>Diagnose 5a-reductase deficiency</li>\n<li>Assess efficacy of drugs that inhibit 5a -reductase</li>\n</ul>\n<p><strong>Increased Levels</strong></p>\n<ul>\n<li>Hirsutism</li>\n<li>Chronic anovulatory syndrome</li>\n<li>High 5a -reductase activity</li>\n</ul>\n<p><strong>Decreased Levels</strong></p>\n<ul>\n<li>Hypogonadism</li>\n<li>5a -reductase deficiency</li>\n</ul>",
