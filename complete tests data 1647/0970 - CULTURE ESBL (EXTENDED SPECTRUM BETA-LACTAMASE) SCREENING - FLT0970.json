        "value": "<table style=\"width: 88.6659%;\">\n<thead>\n<tr>\n<th style=\"width: 29.577%;\"><span style=\"font-size: 10px;\"><strong>Organism Isolated</strong></span></th>\n<th style=\"width: 70.5552%;\"><span style=\"font-size: 10px;\">e.g., <em>Escherichia coli</em> / <em>Klebsiella pneumoniae</em></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 29.577%;\"><span style=\"font-size: 10px;\"><strong>Colony Morphology</strong></span></td>\n<td style=\"width: 70.5552%;\"><span style=\"font-size: 10px;\">e.g., Lactose fermenting colonies on MacConkey agar</span></td>\n</tr>\n<tr>\n<td style=\"width: 29.577%;\"><span style=\"font-size: 10px;\"><strong>Gram Stain</strong></span></td>\n<td style=\"width: 70.5552%;\"><span style=\"font-size: 10px;\">e.g., Gram-negative bacilli</span></td>\n</tr>\n<tr>\n<td style=\"width: 29.577%;\"><span style=\"font-size: 10px;\"><strong>Growth Media</strong></span></td>\n<td style=\"width: 70.5552%;\"><span style=\"font-size: 10px;\">Blood agar, MacConkey agar, etc.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><span style=\"font-size: 10px;\"><strong>Antibiotic Susceptibility Test (AST)</strong></span></p>\n<table style=\"width: 88.2592%;\">\n<thead>\n<tr>\n<th style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\"><strong>Antibiotic</strong></span></th>\n<th style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\"><strong>Zone (mm)</strong></span></th>\n<th style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\"><strong>Interpretation (S/I/R)</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Cefotaxime (CTX)</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Ceftazidime (CAZ)</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Ceftriaxone (CRO)</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Cefepime (FEP)</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Amoxicillin-Clavulanate</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n<tr>\n<td style=\"width: 38.1463%;\"><span style=\"font-size: 10px;\">Imipenem / Meropenem</span></td>\n<td style=\"width: 21.1223%;\"><span style=\"font-size: 10px;\">XX</span></td>\n<td style=\"width: 40.6683%;\"><span style=\"font-size: 10px;\">S / I / R</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><span style=\"font-size: 10px;\">&nbsp;<strong>ESBL Screening (Phenotypic Confirmation)</strong></span></p>\n<table style=\"width: 88.8015%;\">\n<thead>\n<tr>\n<th style=\"width: 12.3045%;\"><span style=\"font-size: 10px;\"><strong>Test Organism</strong></span></th>\n<th style=\"width: 27.8249%;\"><span style=\"font-size: 10px;\"><strong>Screening Result</strong></span></th>\n<th style=\"width: 24.4691%;\"><span style=\"font-size: 10px;\"><strong>Confirmation Method</strong></span></th>\n<th style=\"width: 16.4992%;\"><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n<th style=\"width: 19.016%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 12.3045%;\"><span style=\"font-size: 10px;\">e.g., <em>E. coli</em></span></td>\n<td style=\"width: 27.8249%;\"><span style=\"font-size: 10px;\">Suspected (CTX &le;27 mm, CAZ &le;22 mm)</span></td>\n<td style=\"width: 24.4691%;\"><span style=\"font-size: 10px;\">CDT (CTX vs CTX+Clavulanic acid)</span></td>\n<td style=\"width: 16.4992%;\"><span style=\"font-size: 10px;\">&ge;5 mm increase in zone</span></td>\n<td style=\"width: 19.016%;\"><span style=\"font-size: 10px;\"><strong>ESBL Producer &ndash; Positive</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 12.3045%;\">&nbsp;</td>\n<td style=\"width: 27.8249%;\">&nbsp;</td>\n<td style=\"width: 24.4691%;\">&nbsp;</td>\n<td style=\"width: 16.4992%;\"><span style=\"font-size: 10px;\">No significant difference</span></td>\n<td style=\"width: 19.016%;\"><span style=\"font-size: 10px;\"><strong>ESBL Negative</strong></span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><span style=\"font-size: 10px;\"><strong>Final Interpretation:</strong></span></p>\n<p><span style=\"font-size: 10px;\">ESBL-producing gram-negative bacilli isolated.</span><br data-start=\"2942\" data-end=\"2945\"><span style=\"font-size: 10px;\">These organisms exhibit resistance to extended-spectrum cephalosporins and may require treatment with carbapenems or other advanced agents.</span><br data-start=\"3094\" data-end=\"3097\"><span style=\"font-size: 10px;\">Infection control measures and antimicrobial stewardship are advised.</span></p>",
