      "data": {
        "value": "<p><strong>&nbsp;</strong></p>\n<div>\n<table class=\"cke_show_border\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td><strong>Sample Type&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</strong></td>\n<td>: Peripheral Blood</td>\n</tr>\n<tr>\n<td><strong>Clinical Indication</strong></td>\n<td>: Not provided</td>\n</tr>\n<tr>\n<td><strong>Culture Type</strong></td>\n<td>: 72 Hrs PHA Stimulated</td>\n</tr>\n<tr>\n<td><strong>Medium</strong></td>\n<td>: RPMI 1640</td>\n</tr>\n<tr>\n<td><strong>Banding Technique</strong></td>\n<td>: GTG</td>\n</tr>\n<tr>\n<td><strong>Banding Resolution</strong></td>\n<td>: 400-550</td>\n</tr>\n<tr>\n<td><strong>Metaphases Counted</strong></td>\n<td>: 20</td>\n</tr>\n<tr>\n<td><strong>Metaphases Analysed</strong></td>\n<td>: 20</td>\n</tr>\n<tr>\n<td><strong>Metaphase karyotyped</strong></td>\n<td>: 05</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><strong>RESULT</strong></td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><strong>Karyotype</strong></td>\n<td>: <strong>46, XX</strong></td>\n</tr>\n<tr>\n<td><strong>Diagnosis</strong></td>\n<td>: Normal Female Karyotype&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</td>\n</tr>\n</tbody>\n</table>\n&nbsp;<br><strong>Interpretation:&nbsp;</strong><br>The chromosomes had a normal G-Banding patterns without apparent structural abnormality or rearrangement<br><br><strong>Note:</strong>&nbsp;The following possibilities, although rare, cannot be rule out:<br>a) Low level mosaicism and microdeletion<br>b) Very subtle rearrangement<br>c) Genetic disorder</div>",
