  "interpretation": "<ul>\n<li data-start=\"2032\" data-end=\"2217\">\n<p data-start=\"2034\" data-end=\"2065\"><span style=\"font-size: 10px;\"><strong data-start=\"2034\" data-end=\"2063\">MET Amplified (Positive):</strong></span></p>\n<ul data-start=\"2068\" data-end=\"2217\">\n<li style=\"font-size: 10px;\" data-start=\"2068\" data-end=\"2149\">\n<p data-start=\"2070\" data-end=\"2149\"><span style=\"font-size: 10px;\"><strong data-start=\"2070\" data-end=\"2096\">&ge;5 MET copies per cell</strong> OR <strong data-start=\"2100\" data-end=\"2123\">MET/CEP7 ratio &ge;2.0</strong> confirms amplification.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2152\" data-end=\"2217\">\n<p data-start=\"2154\" data-end=\"2217\"><span style=\"font-size: 10px;\">Indicates eligibility for <strong data-start=\"2180\" data-end=\"2205\">MET inhibitor therapy</strong> in NSCLC.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2219\" data-end=\"2387\">\n<p data-start=\"2221\" data-end=\"2252\"><span style=\"font-size: 10px;\"><strong data-start=\"2221\" data-end=\"2250\">Not Amplified (Negative):</strong></span></p>\n<ul data-start=\"2255\" data-end=\"2387\">\n<li style=\"font-size: 10px;\" data-start=\"2255\" data-end=\"2307\">\n<p data-start=\"2257\" data-end=\"2307\"><span style=\"font-size: 10px;\">No significant increase in MET gene copy number.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2310\" data-end=\"2387\">\n<p data-start=\"2312\" data-end=\"2387\"><span style=\"font-size: 10px;\">Standard treatment pathway unless other actionable mutations are present.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2389\" data-end=\"2494\">\n<p data-start=\"2391\" data-end=\"2420\"><span style=\"font-size: 10px;\"><strong data-start=\"2391\" data-end=\"2418\">Equivocal (Borderline):</strong></span></p>\n<ul data-start=\"2423\" data-end=\"2494\">\n<li style=\"font-size: 10px;\" data-start=\"2423\" data-end=\"2494\">\n<p data-start=\"2425\" data-end=\"2494\"><span style=\"font-size: 10px;\">If results are near threshold, repeat testing or confirm via <strong data-start=\"2486\" data-end=\"2493\">NGS</strong>.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
