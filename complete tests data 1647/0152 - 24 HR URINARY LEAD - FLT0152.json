  "interpretation": "<ul data-start=\"1170\" data-end=\"1709\">\n<li data-start=\"1170\" data-end=\"1248\">\n<p data-start=\"1172\" data-end=\"1200\"><span style=\"font-size: 10px;\"><strong data-start=\"1172\" data-end=\"1198\">Normal Lead Excretion:</strong></span></p>\n<ul data-start=\"1203\" data-end=\"1248\">\n<li style=\"font-size: 10px;\" data-start=\"1203\" data-end=\"1248\">\n<p data-start=\"1205\" data-end=\"1248\"><span style=\"font-size: 10px;\">&lt;40 &micro;g/24 hrs in non-exposed individuals.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1250\" data-end=\"1468\">\n<p data-start=\"1252\" data-end=\"1288\"><span style=\"font-size: 10px;\"><strong data-start=\"1252\" data-end=\"1286\">Elevated Lead (&gt;80 &micro;g/24 hrs):</strong></span></p>\n<ul data-start=\"1291\" data-end=\"1468\">\n<li style=\"font-size: 10px;\" data-start=\"1291\" data-end=\"1359\">\n<p data-start=\"1293\" data-end=\"1359\"><span style=\"font-size: 10px;\">Indicates <strong data-start=\"1303\" data-end=\"1327\">significant exposure</strong> (occupational/environmental).</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1362\" data-end=\"1468\">\n<p data-start=\"1364\" data-end=\"1468\"><span style=\"font-size: 10px;\">May require <strong data-start=\"1376\" data-end=\"1445\">clinical evaluation, removal from exposure, and chelation therapy</strong> (as per guidelines).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1470\" data-end=\"1594\">\n<p data-start=\"1472\" data-end=\"1500\"><span style=\"font-size: 10px;\"><strong data-start=\"1472\" data-end=\"1498\">Creatinine Correction:</strong></span></p>\n<ul data-start=\"1503\" data-end=\"1594\">\n<li style=\"font-size: 10px;\" data-start=\"1503\" data-end=\"1594\">\n<p data-start=\"1505\" data-end=\"1594\"><span style=\"font-size: 10px;\">Ensures validity of 24-hour collection; results can also be expressed as &micro;g/g creatinine.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1596\" data-end=\"1709\">\n<p data-start=\"1598\" data-end=\"1626\"><span style=\"font-size: 10px;\">Should be correlated with:</span></p>\n<ul data-start=\"1629\" data-end=\"1709\">\n<li style=\"font-size: 10px;\" data-start=\"1629\" data-end=\"1660\">\n<p data-start=\"1631\" data-end=\"1660\"><span style=\"font-size: 10px;\"><strong data-start=\"1631\" data-end=\"1658\">Blood Lead Levels (BLL)</strong></span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1663\" data-end=\"1709\">\n<p data-start=\"1665\" data-end=\"1709\"><span style=\"font-size: 10px;\">Clinical symptoms (neurologic, renal, GI).</span></p>\n</li>\n</ul>\n</li>\n</ul>",
