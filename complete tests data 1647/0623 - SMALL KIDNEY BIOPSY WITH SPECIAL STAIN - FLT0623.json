  "interpretation": "<ul data-start=\"1130\" data-end=\"1362\">\n<li data-start=\"1130\" data-end=\"1213\">\n<p data-start=\"1132\" data-end=\"1213\"><span style=\"font-size: 9px;\">This test is used to diagnose <strong data-start=\"1162\" data-end=\"1212\">glomerular, tubular, or interstitial pathology</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1214\" data-end=\"1362\">\n<p data-start=\"1216\" data-end=\"1245\"><span style=\"font-size: 9px;\">Special stains help identify:</span></p>\n<ul data-start=\"1248\" data-end=\"1362\">\n<li style=\"font-size: 9px;\" data-start=\"1248\" data-end=\"1296\">\n<p data-start=\"1250\" data-end=\"1296\"><span style=\"font-size: 9px;\"><strong data-start=\"1250\" data-end=\"1282\">Basement membrane thickening</strong> (PAS, Silver)</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1299\" data-end=\"1325\">\n<p data-start=\"1301\" data-end=\"1325\"><span style=\"font-size: 9px;\"><strong data-start=\"1301\" data-end=\"1313\">Fibrosis</strong> (Trichrome)</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1328\" data-end=\"1362\">\n<p data-start=\"1330\" data-end=\"1362\"><span style=\"font-size: 9px;\"><strong data-start=\"1330\" data-end=\"1350\">Amyloid deposits</strong> (Congo Red)</span></p>\n</li>\n</ul>\n</li>\n</ul>\n<h3 data-start=\"1369\" data-end=\"1397\"><span style=\"font-size: 9px;\"><strong data-start=\"1376\" data-end=\"1397\">Clinical Utility:</strong></span></h3>\n<ul data-start=\"1399\" data-end=\"1651\">\n<li style=\"font-size: 9px;\" data-start=\"1399\" data-end=\"1581\">\n<p data-start=\"1401\" data-end=\"1426\"><span style=\"font-size: 9px;\">Essential for evaluating:</span></p>\n<ul data-start=\"1429\" data-end=\"1581\">\n<li style=\"font-size: 9px;\" data-start=\"1429\" data-end=\"1463\">\n<p data-start=\"1431\" data-end=\"1463\"><span style=\"font-size: 9px;\"><strong data-start=\"1431\" data-end=\"1463\">Nephrotic/Nephritic syndrome</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1466\" data-end=\"1501\">\n<p data-start=\"1468\" data-end=\"1501\"><span style=\"font-size: 9px;\"><strong data-start=\"1468\" data-end=\"1501\">Unexplained renal dysfunction</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1504\" data-end=\"1581\">\n<p data-start=\"1506\" data-end=\"1581\"><span style=\"font-size: 9px;\"><strong data-start=\"1506\" data-end=\"1544\">Systemic diseases affecting kidney</strong> (e.g., lupus, diabetes, amyloidosis)</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1582\" data-end=\"1651\">\n<p data-start=\"1584\" data-end=\"1651\"><span style=\"font-size: 9px;\">Special stains <strong data-start=\"1599\" data-end=\"1630\">enhance diagnostic accuracy</strong> of glomerulopathies.</span></p>\n</li>\n</ul>",
