  "name": "AMNIOCENTESIS + FISH CHROMOSOME 13,21,18, XY",
  "code": "1451",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1343\" data-end=\"1473\">\n<p data-start=\"1345\" data-end=\"1473\">This FISH analysis provides <strong data-start=\"1373\" data-end=\"1403\">rapid aneuploidy screening</strong> for common trisomies (13, 18, 21) and sex chromosome abnormalities.</p>\n</li>\n<li data-start=\"1474\" data-end=\"1635\">\n<p data-start=\"1476\" data-end=\"1635\">It does <strong data-start=\"1484\" data-end=\"1559\">not replace conventional karyotyping or chromosomal microarray analysis</strong> for detection of other structural or numerical chromosomal abnormalities.</p>\n</li>\n<li data-start=\"1636\" data-end=\"1710\">\n<p data-start=\"1638\" data-end=\"1710\">Clinical correlation and follow-up genetic counseling are recommended.</p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "body fluid",
  "department": "6414fc22f02dc1ebb6a097ab",
  "isActive": true,
  "isOnboardedTest": false,
  "testCategory": [
    {
      "type": "textEditor",
      "data": {
        "value": "<table class=\"cke_show_border\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td><strong>FISH investigation for</strong></td>\n<td>: Aneuploidy detection of&nbsp;chromosomes 13, 18, 21, X&amp;Y.</td>\n</tr>\n<tr>\n<td><strong>Clinical indication</strong></td>\n<td>: Risk for Trisomy 21 with NT (1:137) in dual marker</td>\n</tr>\n<tr>\n<td><strong>Gestational age</strong></td>\n<td>: 18+ weeks</td>\n</tr>\n<tr>\n<td><strong>Specimen Type</strong></td>\n<td>: Amniotic fluid</td>\n</tr>\n<tr>\n<td><strong>Method</strong></td>\n<td>: Fluorescence in situ Hybridization (FISH)</td>\n</tr>\n<tr>\n<td><strong>Probes used</strong></td>\n<td>: DNA probe kit for chromosome 13, 18, 21, X &amp; Y</td>\n</tr>\n<tr>\n<td><strong>Analysis Method</strong></td>\n<td>: Manual</td>\n</tr>\n</tbody>\n</table>\n<p><br><strong>RESULTS:</strong></p>\n<ul>\n<li data-start=\"768\" data-end=\"830\">\n<p data-start=\"770\" data-end=\"830\"><strong data-start=\"770\" data-end=\"788\">Chromosome 13:</strong> Two signals detected - Normal disomy 13</p>\n</li>\n<li data-start=\"831\" data-end=\"893\">\n<p data-start=\"833\" data-end=\"893\"><strong data-start=\"833\" data-end=\"851\">Chromosome 18:</strong> Two signals detected - Normal disomy 18</p>\n</li>\n<li data-start=\"894\" data-end=\"956\">\n<p data-start=\"896\" data-end=\"956\"><strong data-start=\"896\" data-end=\"914\">Chromosome 21:</strong> Two signals detected - Normal disomy 21</p>\n</li>\n<li data-start=\"957\" data-end=\"1078\">\n<p data-start=\"959\" data-end=\"981\"><strong data-start=\"959\" data-end=\"979\">Sex Chromosomes:</strong></p>\n<ul data-start=\"984\" data-end=\"1078\">\n<li data-start=\"984\" data-end=\"1005\">\n<p data-start=\"986\" data-end=\"1005\"><strong data-start=\"986\" data-end=\"992\">X:</strong> One signal</p>\n</li>\n<li data-start=\"1008\" data-end=\"1078\">\n<p data-start=\"1010\" data-end=\"1078\"><strong data-start=\"1010\" data-end=\"1016\">Y:</strong> One signal<br data-start=\"1027\" data-end=\"1030\">Consistent with&nbsp;<strong data-start=\"1050\" data-end=\"1076\">male (46,XY) karyotype</strong></p>\n</li>\n</ul>\n</li>\n</ul>",
