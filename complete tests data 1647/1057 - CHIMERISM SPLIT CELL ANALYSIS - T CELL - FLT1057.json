  "name": "CHIMERISM SPLIT CELL ANALYSIS - T CELL",
  "code": "2297",
  "cost": 0,
  "interpretation": "<ol data-start=\"1755\" data-end=\"2313\">\n<li data-start=\"1755\" data-end=\"1901\">\n<p data-start=\"1758\" data-end=\"1783\"><span style=\"font-size: 10px;\"><strong data-start=\"1758\" data-end=\"1781\">Complete Chimerism:</strong></span></p>\n<ul data-start=\"1787\" data-end=\"1901\">\n<li style=\"font-size: 10px;\" data-start=\"1787\" data-end=\"1829\">\n<p data-start=\"1789\" data-end=\"1829\"><span style=\"font-size: 10px;\">Donor Cells &ge;95%, Recipient Cells &le;5%.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1833\" data-end=\"1901\">\n<p data-start=\"1835\" data-end=\"1901\"><span style=\"font-size: 10px;\">Suggests full donor engraftment (desired outcome post-transplant).</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1903\" data-end=\"2055\">\n<p data-start=\"1906\" data-end=\"1928\"><span style=\"font-size: 10px;\"><strong data-start=\"1906\" data-end=\"1926\">Mixed Chimerism:</strong></span></p>\n<ul data-start=\"1932\" data-end=\"2055\">\n<li style=\"font-size: 10px;\" data-start=\"1932\" data-end=\"1977\">\n<p data-start=\"1934\" data-end=\"1977\"><span style=\"font-size: 10px;\">Donor Cells 5&ndash;95%, Recipient Cells 5&ndash;95%.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1981\" data-end=\"2055\">\n<p data-start=\"1983\" data-end=\"2055\"><span style=\"font-size: 10px;\">May indicate early engraftment, graft instability, or impending relapse.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2057\" data-end=\"2203\">\n<p data-start=\"2060\" data-end=\"2095\"><span style=\"font-size: 10px;\"><strong data-start=\"2060\" data-end=\"2093\">Recipient Dominant Chimerism:</strong></span></p>\n<ul data-start=\"2099\" data-end=\"2203\">\n<li style=\"font-size: 10px;\" data-start=\"2099\" data-end=\"2124\">\n<p data-start=\"2101\" data-end=\"2124\"><span style=\"font-size: 10px;\">Recipient Cells &gt;50%.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2128\" data-end=\"2203\">\n<p data-start=\"2130\" data-end=\"2203\"><span style=\"font-size: 10px;\">Suggests graft failure or disease relapse; requires clinical correlation.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2205\" data-end=\"2313\">\n<p data-start=\"2208\" data-end=\"2231\"><span style=\"font-size: 10px;\"><strong data-start=\"2208\" data-end=\"2229\">Trend Monitoring:</strong></span></p>\n<ul data-start=\"2235\" data-end=\"2313\">\n<li style=\"font-size: 10px;\" data-start=\"2235\" data-end=\"2313\">\n<p data-start=\"2237\" data-end=\"2313\"><span style=\"font-size: 10px;\">Serial testing is recommended to track engraftment and detect early relapse.</span></p>\n</li>\n</ul>\n</li>\n</ol>",
