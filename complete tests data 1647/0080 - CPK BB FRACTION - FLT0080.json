  "cost": 0,
  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 9px;\"><strong>CPK-BB Result</strong></span></th>\n<th><span style=\"font-size: 9px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Within Normal Limits</strong></span></td>\n<td><span style=\"font-size: 9px;\">No significant brain or lung injury; normal enzyme distribution.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Mildly Elevated</strong></span></td>\n<td><span style=\"font-size: 9px;\">May suggest minor neurological stress, mild cerebral trauma, or early CNS disease. Clinical correlation needed.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>Significantly Elevated</strong></span></td>\n<td><span style=\"font-size: 9px;\">Indicates possible <strong>acute brain injury</strong>, such as stroke, trauma, brain tumor, seizure, or <strong>lung carcinoma</strong>. Further evaluation and imaging advised.</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 9px;\"><strong>High CPK Total with Low BB%</strong></span></td>\n<td><span style=\"font-size: 9px;\">Likely due to muscle or cardiac injury (CPK-MM or MB dominance), not CNS-related.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
