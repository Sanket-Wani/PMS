        "value": "<table style=\"width: 100.054%; height: 617.2px;\">\n<thead>\n<tr style=\"height: 54.4px;\">\n<th style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\"><strong>Marker</strong></span></th>\n<th style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\"><strong>Result</strong> (Positive/Negative)</span></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 52.8px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD45</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD19</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD20</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive / Dim / Negative</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD5</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD23</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD10</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Negative / Positive</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">CD79b</span></td>\n<td style=\"width: 45.1884%;\"><span style=\"font-size: 10px;\">Positive / Dim</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 54.7862%;\"><span style=\"font-size: 10px;\">FMC-7</span></td>\n<td style=\"width: 4