  "name": "FACIAL NERVE WITH BLINK REFLEX",
  "code": "2551",
  "cost": 0,
  "interpretation": "<ul data-start=\"1870\" data-end=\"2238\">\n<li data-start=\"1870\" data-end=\"2038\">\n<p data-start=\"1872\" data-end=\"2038\"><strong data-start=\"1872\" data-end=\"1888\">Normal Study</strong>: Facial nerve latency and amplitude are within normal limits; blink reflex latencies (R1, R2) are bilaterally symmetrical and within reference range.</p>\n</li>\n<li data-start=\"2042\" data-end=\"2238\">\n<p data-start=\"2044\" data-end=\"2075\"><strong data-start=\"2044\" data-end=\"2062\">Abnormal Study</strong> (example):</p>\n<ul data-start=\"2078\" data-end=\"2238\">\n<li data-start=\"2078\" data-end=\"2238\">\n<p data-start=\"2080\" data-end=\"2238\">Prolonged R1 and R2 latency on right stimulation suggests <strong data-start=\"2138\" data-end=\"2178\">right-sided facial nerve involvement</strong>, possibly due to <strong data-start=\"2196\" data-end=\"2212\">Bell&rsquo;s palsy</strong> or <strong data-start=\"2216\" data-end=\"2237\">facial neuropathy</strong>.</p>\n</li>\n</ul>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": null,
  "department": "672b3eace681c385cc85aac5",
  "isActive": true,
  "isOnboardedTest": false,
