    {
      "type": "textEditor",
      "data": {
        "value": "<p><strong>I. Facial Nerve Conduction Study:</strong></p>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th><strong>Parameter</strong></th>\n<th><strong>Right Side</strong></th>\n<th><strong>Left Side</strong></th>\n<th><strong>Normal Range</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Latency (ms)</td>\n<td>X.XX</td>\n<td>X.XX</td>\n<td>2.0 &ndash; 4.0 ms</td>\n</tr>\n<tr>\n<td>Amplitude (mV)</td>\n<td>X.XX</td>\n<td>X.XX</td>\n<td>&gt; 0.5 mV</td>\n</tr>\n<tr>\n<td>Conduction Velocity (m/s)</td>\n<td>X.XX</td>\n<td>X.XX</td>\n<td>&gt; 50 m/s</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p><strong>II. Blink Reflex Study:</strong></p>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th><strong>Stimulation</strong></th>\n<th><strong>Response</strong></th>\n<th><strong>Latency (ms)</strong></th>\n<th><strong>Normal Limit</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Right Supraorbital N.</td>\n<td>R1</td>\n<td>X.XX</td>\n<td>&le; 13 ms</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>R2 (ipsilateral)</td>\n<td>X.XX</td>\n<td>&le; 40 ms</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>R2 (contralateral)</td>\n<td>X.XX</td>\n<td>&le; 40 ms</td>\n</tr>\n<tr>\n<td>Left Supraorbital N.</td>\n<td>L1</td>\n<td>X.XX</td>\n<td>&le; 13 ms</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>L2 (ipsilateral)</td>\n<td>X.XX</td>\n<td>&le; 40 ms</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>L2 (contralateral)</td>\n<td>X.XX</td>\n<td>&le; 40 ms</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
