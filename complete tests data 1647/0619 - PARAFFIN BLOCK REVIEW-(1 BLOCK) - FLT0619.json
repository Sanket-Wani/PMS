  "interpretation": "<ul data-start=\"752\" data-end=\"1003\">\n<li data-start=\"752\" data-end=\"841\">\n<p data-start=\"754\" data-end=\"841\"><span style=\"font-size: 9px;\">A paraffin block review involves re-examination of a previously processed tissue block.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"842\" data-end=\"1003\">\n<p data-start=\"844\" data-end=\"856\"><span style=\"font-size: 9px;\">It helps in:</span></p>\n<ul data-start=\"859\" data-end=\"1003\">\n<li style=\"font-size: 9px;\" data-start=\"859\" data-end=\"889\">\n<p data-start=\"861\" data-end=\"889\"><span style=\"font-size: 9px;\"><strong data-start=\"861\" data-end=\"889\">Second opinion diagnosis</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"892\" data-end=\"928\">\n<p data-start=\"894\" data-end=\"928\"><span style=\"font-size: 9px;\"><strong data-start=\"894\" data-end=\"928\">Further IHC or molecular tests</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"931\" data-end=\"969\">\n<p data-start=\"933\" data-end=\"969\"><span style=\"font-size: 9px;\"><strong data-start=\"933\" data-end=\"969\">Tumor classification and staging</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"972\" data-end=\"1003\">\n<p data-start=\"974\" data-end=\"1003\"><span style=\"font-size: 9px;\"><strong data-start=\"974\" data-end=\"1003\">Treatment decision-making</strong></span></p>\n</li>\n</ul>\n</li>\n</ul>\n<p data-start=\"974\" data-end=\"1003\"><span style=\"font-size: 9px;\"><strong data-start=\"1017\" data-end=\"1038\">Clinical Utility:</strong></span></p>\n<ul data-start=\"1040\" data-end=\"1302\">\n<li style=\"font-size: 9px;\" data-start=\"1040\" data-end=\"1095\">\n<p data-start=\"1042\" data-end=\"1095\"><span style=\"font-size: 9px;\">Confirms or revises initial histopathology diagnosis.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1096\" data-end=\"1207\">\n<p data-start=\"1098\" data-end=\"1207\"><span style=\"font-size: 9px;\">Useful in oncology for <strong data-start=\"1121\" data-end=\"1143\">treatment planning</strong>, <strong data-start=\"1145\" data-end=\"1175\">clinical trial eligibility</strong>, or <strong data-start=\"1180\" data-end=\"1206\">referral center review</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1208\" data-end=\"1302\">\n<p data-start=\"1210\" data-end=\"1302\"><span style=\"font-size: 9px;\">Required for <strong data-start=\"1223\" data-end=\"1252\">further specialized tests</strong> like <strong data-start=\"1258\" data-end=\"1265\">IHC</strong>, <strong data-start=\"1267\" data-end=\"1275\">FISH</strong>, or <strong data-start=\"1280\" data-end=\"1301\">molecular studies</strong>.</span></p>\n</li>\n</ul>",
