      "type": "textEditor",
      "data": {
        "value": "<p data-start=\"670\" data-end=\"689\"><strong data-start=\"674\" data-end=\"687\">Findings:</strong></p>\n<ul data-start=\"690\" data-end=\"1151\">\n<li data-start=\"690\" data-end=\"767\">\n<p data-start=\"692\" data-end=\"767\"><strong data-start=\"692\" data-end=\"709\">Resting Echo:</strong> All cardiac chambers normal; no wall motion abnormality</p>\n</li>\n<li data-start=\"768\" data-end=\"876\">\n<p data-start=\"770\" data-end=\"876\"><strong data-start=\"770\" data-end=\"793\">Contrast Perfusion:</strong> Homogeneous contrast uptake in all myocardial segments at rest and during stress</p>\n</li>\n<li data-start=\"877\" data-end=\"953\">\n<p data-start=\"879\" data-end=\"953\"><strong data-start=\"879\" data-end=\"895\">Stress Echo:</strong> Normal augmentation of wall motion with exercise/stress</p>\n</li>\n<li data-start=\"954\" data-end=\"989\">\n<p data-start=\"956\" data-end=\"989\"><strong data-start=\"956\" data-end=\"983\">Ejection Fraction (EF):</strong> 65%</p>\n</li>\n<li data-start=\"990\" data-end=\"1028\">\n<p data-start=\"992\" data-end=\"1028\"><strong data-start=\"992\" data-end=\"1008\">Arrhythmias:</strong> None during study</p>\n</li>\n<li data-start=\"1029\" data-end=\"1091\">\n<p data-start=\"1031\" data-end=\"1091\"><strong data-start=\"1031\" data-end=\"1044\">Symptoms:</strong> No chest pain or undue dyspnea during stress</p>\n</li>\n<li data-start=\"1092\" data-end=\"1151\">\n<p data-start=\"1094\" data-end=\"1151\"><strong data-start=\"1094\" data-end=\"1110\">ECG changes:</strong> No ST-T changes suggestive of ischemia</p>\n</li>\n</ul>\n<p data-start=\"1158\" data-end=\"1179\"><strong data-start=\"1162\" data-end=\"1177\">Impression:</strong></p>\n<ul data-start=\"1180\" data-end=\"1321\">\n<li data-start=\"1180\" data-end=\"1234\">\n<p data-start=\"1182\" data-end=\"1234\">Normal Myocardial Contrast Stress Echocardiography</p>\n</li>\n<li data-start=\"1235\" data-end=\"1272\">\n<p data-start=\"1237\" data-end=\"1272\">No evidence of inducible ischemia</p>\n</li>\n<li data-start=\"1273\" data-end=\"1321\">\n<p data-start=\"1275\" data-end=\"1321\">Preserved left ventricular systolic function</p>\n</li>\n</ul>",
        "field": "textEditor"
      },
