  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"542\" data-end=\"614\">\n<p data-start=\"544\" data-end=\"614\"><span style=\"font-size: 9px;\">Detects <strong data-start=\"552\" data-end=\"587\">Aspirin-specific IgE antibodies</strong> in suspected drug allergy.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"615\" data-end=\"781\">\n<p data-start=\"617\" data-end=\"703\"><span style=\"font-size: 9px;\">Useful for diagnosing <strong data-start=\"639\" data-end=\"676\">Aspirin Hypersensitivity Syndrome</strong>, especially in cases with:</span></p>\n<ul data-start=\"706\" data-end=\"781\">\n<li style=\"font-size: 9px;\" data-start=\"706\" data-end=\"714\">\n<p data-start=\"708\" data-end=\"714\"><span style=\"font-size: 9px;\">Asthma</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"717\" data-end=\"731\">\n<p data-start=\"719\" data-end=\"731\"><span style=\"font-size: 9px;\">Nasal polyps</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"734\" data-end=\"781\">\n<p data-start=\"736\" data-end=\"781\"><span style=\"font-size: 9px;\">Urticaria or angioedema after aspirin intake.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"782\" data-end=\"869\">\n<p data-start=\"784\" data-end=\"869\"><span style=\"font-size: 9px;\">A <strong data-start=\"786\" data-end=\"805\">positive result</strong> indicates sensitization, but clinical correlation is necessary.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"870\" data-end=\"947\">\n<p data-start=\"872\" data-end=\"947\"><span style=\"font-size: 9px;\">May assist in risk assessment prior to <strong data-start=\"911\" data-end=\"946\">aspirin desensitization therapy</strong>.</span></p>\n</li>\n</ul>",
