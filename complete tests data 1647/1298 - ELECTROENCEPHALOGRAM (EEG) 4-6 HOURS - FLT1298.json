      "data": {
        "value": "<table>\n<thead>\n<tr>\n<th>Parameter</th>\n<th>Details</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>EEG Type</td>\n<td>Video EEG / Routine EEG</td>\n</tr>\n<tr>\n<td>Duration</td>\n<td>4&ndash;6 Hours</td>\n</tr>\n<tr>\n<td>State During Recording</td>\n<td>Awake / Sleep / Drowsy / All</td>\n</tr>\n<tr>\n<td>Electrode Placement</td>\n<td>10&ndash;20 International System</td>\n</tr>\n<tr>\n<td>Activation Procedures Used</td>\n<td>Hyperventilation / Photic Stimulation / Sleep Deprivation</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3 data-start=\"1031\" data-end=\"1056\"><strong data-start=\"1035\" data-end=\"1056\">EEG Observations:</strong></h3>\n<ul data-start=\"1058\" data-end=\"1698\">\n<li data-start=\"1058\" data-end=\"1174\">\n<p data-start=\"1060\" data-end=\"1174\"><strong data-start=\"1060\" data-end=\"1084\">Background Activity:</strong><br data-start=\"1084\" data-end=\"1087\">(e.g., Normal alpha rhythm 8&ndash;13 Hz, symmetrical, reactive to eye opening and closure)</p>\n</li>\n<li data-start=\"1176\" data-end=\"1294\">\n<p data-start=\"1178\" data-end=\"1294\"><strong data-start=\"1178\" data-end=\"1197\">Sleep Patterns:</strong><br data-start=\"1197\" data-end=\"1200\">(e.g., Normal sleep architecture with presence of vertex sharp waves, spindles, K-complexes)</p>\n</li>\n<li data-start=\"1296\" data-end=\"1404\">\n<p data-start=\"1298\" data-end=\"1404\"><strong data-start=\"1298\" data-end=\"1322\">Focal Abnormalities:</strong><br data-start=\"1322\" data-end=\"1325\">(e.g., Sharp waves/spikes in temporal region, slowing in left frontal region)</p>\n</li>\n<li data-start=\"1406\" data-end=\"1512\">\n<p data-start=\"1408\" data-end=\"1512\"><strong data-start=\"1408\" data-end=\"1438\">Generalized Abnormalities:</strong><br data-start=\"1438\" data-end=\"1441\">(e.g., Generalized spike and wave discharges / diffuse delta slowing)</p>\n</li>\n<li data-start=\"1514\" data-end=\"1630\">\n<p data-start=\"1516\" data-end=\"1630\"><strong data-start=\"1516\" data-end=\"1540\">Paroxysmal Activity:</strong><br data-start=\"1540\" data-end=\"1543\">(e.g., No epileptiform discharges observed / Intermittent bursts of spike-wave noted)</p>\n</li>\n<li data-start=\"1632\" data-end=\"1698\">\n<p data-start=\"1634\" data-end=\"1698\"><strong data-start=\"1634\" data-end=\"1654\">Artifacts Noted:</strong><br data-start=\"1654\" data-end=\"1657\">(e.g., Eye blink, muscle, ECG artifact)</p>\n</li>\n</ul>\n<p><strong>Impression:</strong></p>",
