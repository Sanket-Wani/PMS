  "cost": 0,
  "interpretation": "<table><thead><tr><th><div><span style=\"font-size: 10px;\">Parameter</span></div></th><th><div><span style=\"font-size: 10px;\">Interpretation</span></div></th></tr></thead><tbody><tr><td><div><span style=\"font-size: 10px;\">Color</span></div></td><td><div><span style=\"font-size: 10px;\">Normal color varies from light to dark brown</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Consistency</span></div></td><td><div><span style=\"font-size: 10px;\">Normal consistency should be formed or semi-formed</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Mucus</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of mucus may indicate inflammation or irritation in the intestinal lining</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Blood</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of blood may indicate bleeding in the gastrointestinal tract</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Occult Blood</span></div></td><td><div><span style=\"font-size: 10px;\">Positive result may indicate bleeding in the gastrointestinal tract</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">pH</span></div></td><td><div><span style=\"font-size: 10px;\">Normal pH range is 6.0 to 7.5</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Reducing Substances</span></div></td><td><div><span style=\"font-size: 10px;\">Positive result may indicate malabsorption of carbohydrates</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Ova and Parasites</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of ova or parasites may indicate a parasitic infection</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Cysts</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of cysts may indicate a protozoal infection</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Trophozoites</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of trophozoites may indicate a protozoal infection</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Worms</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of worms may indicate a helminthic infection</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Vegetative Forms</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of vegetative forms may indicate bacterial infection</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">RBCs</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of RBCs may indicate bleeding in the gastrointestinal tract</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Pus Cells</span></div></td><td><div><span style=\"font-size: 10px;\">Presence of pus cells may indicate inflammation or infection in the gastrointestinal tract</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Epithelial Cells</span></div></td><td><div><span style=\"font-size: 10px;\">Normal finding, may indicate contamination from skin</span></div></td></tr></tbody></table>",
