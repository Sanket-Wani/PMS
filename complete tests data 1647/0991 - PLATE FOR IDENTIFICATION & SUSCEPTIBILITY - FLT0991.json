    {
      "type": "textEditor",
      "data": {
        "value": "<p data-start=\"148\" data-end=\"360\"><strong data-start=\"148\" data-end=\"162\">Test Name:</strong> Culture Plate for Bacterial Identification and Antibiotic Susceptibility Testing</p>\n<p data-start=\"148\" data-end=\"360\"><strong data-start=\"246\" data-end=\"257\">Method:</strong> Culture &amp; Sensitivity (C/S)</p>\n<p data-start=\"148\" data-end=\"360\"><strong data-start=\"288\" data-end=\"304\">Sample Type:</strong> [Specify - e.g., Blood, Urine, Pus, Swab, Sputum, etc.]</p>\n<p data-start=\"148\" data-end=\"360\">BACTERIAL IDENTIFICATION:</p>\n<table style=\"height: 174px; width: 94.8153%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 25.5126%;\"><strong>Organism Isolated</strong></th>\n<th style=\"width: 71.1634%;\">[e.g., <em>Escherichia coli</em> / <em>Staphylococcus aureus</em> / No Growth]</th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 34px;\">\n<td style=\"width: 25.5126%;\"><strong>Colony Morphology</strong></td>\n<td style=\"width: 71.1634%;\">[e.g., Lactose fermenting colonies / Beta-hemolytic colonies]</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 25.5126%;\"><strong>Gram Stain</strong></td>\n<td style=\"width: 71.1634%;\">[e.g., Gram-negative bacilli / Gram-positive cocci]</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 25.5126%;\"><strong>Preliminary ID</strong></td>\n<td style=\"width: 71.1634%;\">[e.g., Enterobacteriaceae group]</td>\n</tr>\n<tr style=\"height: 38px;\">\n<td style=\"width: 25.5126%;\"><strong>Final Identification</strong></td>\n<td style=\"width: 71.1634%;\">[e.g., <em>Klebsiella pneumoniae</em> confirmed]</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p>ANTIBIOTIC SUSCEPTIBILITY PROFILE</p>\n<p>&nbsp;</p>\n<table style=\"height: 215px; width: 94.8113%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 36.3854%;\"><strong>Antibiotic</strong></th>\n<th style=\"width: 23.9691%;\"><strong>Result</strong> (S/I/R)</th>\n<th style=\"width: 34.6273%;\"><strong>MIC (if applicable)</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3854%;\">Ampicillin</td>\n<td style=\"width: 23.9691%;\">Resistant (R)</td>\n<td style=\"width: 34.6273%;\">&gt;32 &micro;g/mL</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3854%;\">Ceftriaxone</td>\n<td style=\"width: 23.9691%;\">Sensitive (S)</td>\n<td style=\"width: 34.6273%;\">&le;1 &micro;g/mL</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3854%;\">Ciprofloxacin</td>\n<td style=\"width: 23.9691%;\">Intermediate (I)</td>\n<td style=\"width: 34.6273%;\">2 &micro;g/mL</td>\n</tr>\n<tr style=\"height: 35px;\">\n<td style=\"width: 36.3854%;\">Piperacillin-Tazobactam</td>\n<td style=\"width: 23.9691%;\">Sensitive (S)</td>\n<td style=\"width: 34.6273%;\">8 &micro;g/mL</td>\n</tr>\n<tr style=\"height: 41px;\">\n<td style=\"width: 36.3854%;\">Meropenem</td>\n<td style=\"width: 23.9691%;\">Sensitive (S)</td>\n<td style=\"width: 34.6273%;\">&le;0.25 &micro;g/mL</td>\n</tr>\n</tbody>\n</table>\n<p data-start=\"148\" data-end=\"360\">&nbsp;</p>",
        "field": "textEditor"
      },
