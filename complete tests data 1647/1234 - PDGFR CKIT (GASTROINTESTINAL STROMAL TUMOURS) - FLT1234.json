        "value": "<h4 data-start=\"1010\" data-end=\"1047\"><strong data-start=\"1015\" data-end=\"1047\">c-KIT Gene Mutation Analysis</strong></h4>\n<div class=\"_tableContainer_80l1q_1\">\n<div class=\"_tableWrapper_80l1q_14 group flex w-fit flex-col-reverse\" tabindex=\"-1\">\n<table class=\"w-fit min-w-(--thread-content-width)\" data-start=\"1049\" data-end=\"1573\">\n<thead data-start=\"1049\" data-end=\"1133\">\n<tr data-start=\"1049\" data-end=\"1133\">\n<th data-start=\"1049\" data-end=\"1060\" data-col-size=\"sm\"><strong data-start=\"1051\" data-end=\"1059\">Exon</strong></th>\n<th data-start=\"1060\" data-end=\"1084\" data-col-size=\"sm\"><strong data-start=\"1062\" data-end=\"1083\">Mutation Detected</strong></th>\n<th data-start=\"1084\" data-end=\"1108\" data-col-size=\"sm\"><strong data-start=\"1086\" data-end=\"1107\">Nucleotide Change</strong></th>\n<th data-start=\"1108\" data-end=\"1133\" data-col-size=\"sm\"><strong data-start=\"1110\" data-end=\"1131\">Amino Acid Change</strong></th>\n</tr>\n</thead>\n<tbody data-start=\"1222\" data-end=\"1573\">\n<tr data-start=\"1222\" data-end=\"1309\">\n<td data-start=\"1222\" data-end=\"1233\" data-col-size=\"sm\">Exon 9</td>\n<td data-col-size=\"sm\" data-start=\"1233\" data-end=\"1258\">Yes / No</td>\n<td data-col-size=\"sm\" data-start=\"1258\" data-end=\"1283\">________</td>\n<td data-col-size=\"sm\" data-start=\"1283\" data-end=\"1309\">________</td>\n</tr>\n<tr data-start=\"1310\" data-end=\"1397\">\n<td data-start=\"1310\" data-end=\"1321\" data-col-size=\"sm\">Exon 11</td>\n<td data-start=\"1321\" data-end=\"1346\" data-col-size=\"sm\">Yes / No</td>\n<td data-col-size=\"sm\" data-start=\"1346\" data-end=\"1371\">________</td>\n<td data-col-size=\"sm\" data-start=\"1371\" data-end=\"1397\">________</td>\n</tr>\n<tr data-start=\"1398\" data-end=\"1485\">\n<td data-start=\"1398\" data-end=\"1409\" data-col-size=\"sm\">Exon 13</td>\n<td data-col-size=\"sm\" data-start=\"1409\" data-end=\"1434\">Yes / No