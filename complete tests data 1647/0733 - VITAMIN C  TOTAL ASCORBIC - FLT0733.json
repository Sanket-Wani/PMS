  "name": "VITAMIN C  TOTAL ASCORBIC",
  "code": "1843",
  "cost": 0,
  "interpretation": "<p><strong data-start=\"63\" data-end=\"92\">Vitamin C (ascorbic acid)</strong> is a <strong data-start=\"98\" data-end=\"123\">water-soluble vitamin</strong> and a powerful <strong data-start=\"139\" data-end=\"154\">antioxidant</strong> essential for collagen synthesis, immune function, wound healing, and absorption of iron. This test measures the total concentration of vitamin C (both reduced and oxidized forms) in blood.</p>\n<p>&nbsp;</p>\n<p data-start=\"1188\" data-end=\"1227\"><strong data-start=\"1192\" data-end=\"1227\">Low Vitamin C &ndash; Possible Causes</strong></p>\n<ul data-start=\"1228\" data-end=\"1562\">\n<li data-start=\"1228\" data-end=\"1313\">\n<p data-start=\"1230\" data-end=\"1313\"><strong data-start=\"1230\" data-end=\"1253\">Poor dietary intake</strong> (especially in people with low fruit/vegetable consumption)</p>\n</li>\n<li data-start=\"1314\" data-end=\"1330\">\n<p data-start=\"1316\" data-end=\"1330\"><strong data-start=\"1316\" data-end=\"1330\">Alcoholism</strong></p>\n</li>\n<li data-start=\"1331\" data-end=\"1400\">\n<p data-start=\"1333\" data-end=\"1400\"><strong data-start=\"1333\" data-end=\"1360\">Malabsorption syndromes</strong> (e.g., Crohn&rsquo;s disease, celiac disease)</p>\n</li>\n<li data-start=\"1401\" data-end=\"1466\">\n<p data-start=\"1403\" data-end=\"1466\"><strong data-start=\"1403\" data-end=\"1414\">Smoking</strong> (increases oxidative stress and vitamin C turnover)</p>\n</li>\n<li data-start=\"1467\" data-end=\"1519\">\n<p data-start=\"1469\" data-end=\"1519\"><strong data-start=\"1469\" data-end=\"1495\">Pregnancy or lactation</strong> (increased requirement)</p>\n</li>\n<li data-start=\"1520\" data-end=\"1562\">\n<p data-start=\"1522\" data-end=\"1562\"><strong data-start=\"1522\" data-end=\"1541\">Chronic illness</strong> or <strong data-start=\"1545\" data-end=\"1562\">renal failure</strong></p>\n</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th><strong>Vitamin C Level</strong></th>\n<th><strong>Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>&lt; 0.2 mg/dL</strong></td>\n<td><strong>Deficiency</strong> &ndash; consistent with <strong>scurvy</strong> or severe hypovitaminosis</td>\n</tr>\n<tr>\n<td><strong>0.2 &ndash; 0.4 mg/dL</strong></td>\n<td><strong>Low</strong> &ndash; marginal levels; may indicate <strong>subclinical deficiency</strong></td>\n</tr>\n<tr>\n<td><strong>0.4 &ndash; 2.0 mg/dL</strong></td>\n<td><strong>Normal range</strong> &ndash; adequate vitamin C status</td>\n</tr>\n<tr>\n<td><strong>&gt; 2.0 mg/dL</strong></td>\n<td><strong>High</strong> &ndash; may occur due to <strong>supplement overuse</strong>; generally not toxic</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
