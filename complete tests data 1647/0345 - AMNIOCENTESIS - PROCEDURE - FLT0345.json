        "value": "<h4 data-start=\"533\" data-end=\"561\">Patient Details:</h4>\n<ul data-start=\"562\" data-end=\"679\">\n<li data-start=\"562\" data-end=\"575\">\n<p data-start=\"564\" data-end=\"575\">Name:</p>\n</li>\n<li data-start=\"576\" data-end=\"588\">\n<p data-start=\"578\" data-end=\"588\">Age:</p>\n</li>\n<li data-start=\"589\" data-end=\"635\">\n<p data-start=\"591\" data-end=\"635\">Gestational Age: (e.g., 16 weeks 2 days)</p>\n</li>\n<li data-start=\"636\" data-end=\"652\">\n<p data-start=\"638\" data-end=\"652\">LMP/EDD:</p>\n</li>\n<li data-start=\"653\" data-end=\"679\">\n<p data-start=\"655\" data-end=\"679\">Ultrasound Findings:</p>\n</li>\n</ul>\n<h4 data-start=\"686\" data-end=\"716\">Procedure Details:</h4>\n<ul data-start=\"717\" data-end=\"963\">\n<li data-start=\"717\" data-end=\"743\">\n<p data-start=\"719\" data-end=\"743\">Date of Procedure:</p>\n</li>\n<li data-start=\"744\" data-end=\"811\">\n<p data-start=\"746\" data-end=\"811\">Technique: Ultrasound-guided transabdominal amniocentesis</p>\n</li>\n<li data-start=\"812\" data-end=\"854\">\n<p data-start=\"814\" data-end=\"854\">Needle Used: e.g., 22G spinal needle</p>\n</li>\n<li data-start=\"855\" data-end=\"900\">\n<p data-start=\"857\" data-end=\"900\">Volume Aspirated: ~20 ml amniotic fluid</p>\n</li>\n<li data-start=\"901\" data-end=\"963\">\n<p data-start=\"903\" data-end=\"963\">Complications: None / Mild cramping / Leaking / Bleeding</p>\n</li>\n</ul>\n<p>&nbsp;</p>\n<table>\n<thead>\n<tr>\n<th>Test</th>\n<th>Remarks</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>FISH for chromosomes 13, 18, 21, X, Y</td>\n<td>Preliminary result within 48 hours</td>\n</tr>\n<tr>\n<td>Karyotyping</td>\n<td>Full result in 10&ndash;14 days</td>\n</tr>\n<tr>\n<td>PCR/NGS for specific gene mutation</td>\n<td>If indicated by history</td>\n</tr>\n<tr>\n<td>TORCH / Infection panel</td>\n<td>If clinically suspected</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h4 data-start=\"1496\" data-end=\"1531\">Ultrasound Observation:</h4>\n<ul data-start=\"1532\" data-end=\"1691\">\n<li data-start=\"1532\" data-end=\"1564\">\n<p data-start=\"1534\" data-end=\"1564\">Single live intrauterine fetus</p>\n</li>\n<li data-start=\"1565\" data-end=\"1595\">\n<p data-start=\"1567\" data-end=\"1595\">Normal amniotic fluid volume</p>\n</li>\n<li data-start=\"1596\" data-end=\"1641\">\n<p data-start=\"1598\" data-end=\"1641\">Placenta location: e.g., anterior/posterior</p>\n</li>\n<li data-start=\"1642\" data-end=\"1691\">\n<p data-start=\"1644\" data-end=\"1691\">No visible fetal anomalies at time of procedure</p>\n</li>\n</ul>\n<h4 data-start=\"1698\" data-end=\"1731\">Post-Procedure Advice:</h4>\n<ul data-start=\"1732\" data-end=\"1856\">\n<li data-start=\"1732\" data-end=\"1771\">\n<p data-start=\"1734\" data-end=\"1771\">Avoid exertion, lifting heavy objects</p>\n</li>\n<li data-start=\"1772\" data-end=\"1823\">\n<p data-start=\"1774\" data-end=\"1823\">Watch for pain, fever, fluid leakage, or bleeding</p>\n</li>\n<li data-start=\"1824\" data-end=\"1856\">\n<p data-start=\"1826\" data-end=\"1856\">Follow-up ultrasound if needed</p>\n</li>\n</ul>\n<h3 data-start=\"1863\" data-end=\"1890\">Performed By:</h3>\n<ul data-start=\"1891\" data-end=\"1954\">\n<li data-start=\"1891\" data-end=\"1915\">\n<p data-start=\"1893\" data-end=\"1915\">Consultant Name:</p>\n</li>\n<li data-start=\"1916\" data-end=\"1938\">\n<p data-start=\"1918\" data-end=\"1938\">Qualification:</p>\n</li>\n<li data-start=\"1939\" data-end=\"1954\">\n<p data-start=\"1941\" data-end=\"1954\">Center:</p>\n</li>\n</ul>",
