  "_id": "6a7f5797757ee51246381be3",
  "lab": "6a7f5796eda1a5feaff0b458",
  "name": "Troponin T (Card)",
  "code": "TROP",
  "cost": 0,
  "interpretation": "<p><span style=\"font-size: 10px;\">The Troponin T test is a blood test used to diagnose and monitor heart muscle damage, such as in a heart attack. Troponin T is a protein found primarily in the heart muscle, and elevated levels may indicate damage to the heart muscle.<br></span></p><table><thead><tr><th><div><span style=\"font-size: 10px;\">Troponin T Level</span></div></th><th><div><span style=\"font-size: 10px;\">Interpretation</span></div></th></tr></thead><tbody><tr><td><div><span style=\"font-size: 10px;\">Less than 0.01 ng/mL (nanograms per milliliter)</span></div></td><td><div><span style=\"font-size: 10px;\">Normal</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Slightly elevated levels</span></div></td><td><div><span style=\"font-size: 10px;\">May be seen in people with mild heart muscle damage or in other conditions that affect the heart</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Moderately elevated levels</span></div></td><td><div><span style=\"font-size: 10px;\">Indicates significant heart muscle damage, such as in a heart attack</span></div></td></tr><tr><td><div><span style=\"font-size: 10px;\">Rapidly rising levels</span></div></td><td><div><span style=\"font-size: 10px;\">Indicates ongoing heart muscle damage, such as in an acute heart attack</span></div></td></tr></tbody></table>",
