      "data": {
        "value": "<h3 data-start=\"518\" data-end=\"546\"><strong data-start=\"522\" data-end=\"544\">GROSS EXAMINATION:</strong></h3>\n<p data-start=\"547\" data-end=\"576\">(Describe specimen in detail)</p>\n<ul data-start=\"578\" data-end=\"1070\">\n<li data-start=\"578\" data-end=\"654\">\n<p data-start=\"580\" data-end=\"654\"><strong data-start=\"580\" data-end=\"593\">Specimen:</strong> e.g., <em data-start=\"600\" data-end=\"652\">Radical Mastectomy specimen with axillary contents</em></p>\n</li>\n<li data-start=\"655\" data-end=\"691\">\n<p data-start=\"657\" data-end=\"691\"><strong data-start=\"657\" data-end=\"666\">Size:</strong> e.g., <em data-start=\"673\" data-end=\"689\">14 x 12 x 4 cm</em></p>\n</li>\n<li data-start=\"692\" data-end=\"775\">\n<p data-start=\"694\" data-end=\"775\"><strong data-start=\"694\" data-end=\"715\">External Surface:</strong> e.g., <em data-start=\"722\" data-end=\"773\">Skin overlying unremarkable / ulcerated area seen</em></p>\n</li>\n<li data-start=\"776\" data-end=\"911\">\n<p data-start=\"778\" data-end=\"911\"><strong data-start=\"778\" data-end=\"794\">Cut Surface:</strong> e.g., <em data-start=\"801\" data-end=\"909\">Well-defined grey-white tumor measuring 4.5 x 4.2 x 3.0 cm seen in upper outer quadrant. Necrosis present.</em></p>\n</li>\n<li data-start=\"912\" data-end=\"989\">\n<p data-start=\"914\" data-end=\"989\"><strong data-start=\"914\" data-end=\"926\">Margins:</strong> e.g., <em data-start=\"933\" data-end=\"987\">All margins inked. Tumor free margin &ndash; 1.2 cm (deep)</em></p>\n</li>\n<li data-start=\"990\" data-end=\"1070\">\n<p data-start=\"992\" data-end=\"1070\"><strong data-start=\"992\" data-end=\"1008\">Lymph Nodes:</strong> e.g., <em data-start=\"1015\" data-end=\"1070\">Axillary contents show 12 lymph nodes, largest 2.5 cm</em></p>\n</li>\n</ul>\n<h3 data-start=\"1077\" data-end=\"1098\">&nbsp;</h3>\n<h3 data-start=\"1077\" data-end=\"1098\"><strong data-start=\"1081\" data-end=\"1096\">MICROSCOPY:</strong></h3>\n<p data-start=\"1099\" data-end=\"1130\">(Detailed microscopic findings)</p>\n<ul data-start=\"1132\" data-end=\"1552\">\n<li data-start=\"1132\" data-end=\"1206\">\n<p data-start=\"1134\" data-end=\"1206\">Sections show invasive malignant tumor composed of [tumor description]</p>\n</li>\n<li data-start=\"1207\" data-end=\"1272\">\n<p data-start=\"1209\" data-end=\"1272\">Tumor cells arranged in [pattern] with [cytological features]</p>\n</li>\n<li data-start=\"1273\" data-end=\"1323\">\n<p data-start=\"1275\" data-end=\"1323\">Tumor infiltrates [adjacent tissue structures]</p>\n</li>\n<li data-start=\"1324\" data-end=\"1362\">\n<p data-start=\"1326\" data-end=\"1362\">Tumor necrosis: [Present / Absent]</p>\n</li>\n<li data-start=\"1363\" data-end=\"1410\">\n<p data-start=\"1365\" data-end=\"1410\">Lymphovascular invasion: [Present / Absent]</p>\n</li>\n<li data-start=\"1411\" data-end=\"1454\">\n<p data-start=\"1413\" data-end=\"1454\">Perineural invasion: [Present / Absent]</p>\n</li>\n<li data-start=\"1455\" data-end=\"1513\">\n<p data-start=\"1457\" data-end=\"1513\">Margins: [Free / Involved &ndash; specify site and distance]</p>\n</li>\n<li data-start=\"1514\" data-end=\"1552\">\n<p data-start=\"1516\" data-end=\"1552\">Lymph nodes: [Number involved/total]</p>\n</li>\n</ul>\n<h3 data-start=\"1559\" data-end=\"1579\"><strong data-start=\"1563\" data-end=\"1577\">DIAGNOSIS:</strong></h3>\n<ul data-start=\"1580\" data-end=\"1923\">\n<li data-start=\"1580\" data-end=\"1690\">\n<p data-start=\"1582\" data-end=\"1690\"><strong data-start=\"1582\" data-end=\"1604\">Histological Type:</strong> e.g., <em data-start=\"1611\" data-end=\"1688\">Invasive Ductal Carcinoma &ndash; Grade II (Nottingham Modified Bloom Richardson)</em></p>\n</li>\n<li data-start=\"1691\" data-end=\"1710\">\n<p data-start=\"1693\" data-end=\"1710\"><strong data-start=\"1693\" data-end=\"1708\">Tumor Size:</strong></p>\n</li>\n<li data-start=\"1711\" data-end=\"1727\">\n<p data-start=\"1713\" data-end=\"1727\"><strong data-start=\"1713\" data-end=\"1725\">Margins:</strong></p>\n</li>\n<li data-start=\"1728\" data-end=\"1771\">\n<p data-start=\"1730\" data-end=\"1771\"><strong data-start=\"1730\" data-end=\"1769\">Lymphovascular/Perineural Invasion:</strong></p>\n</li>\n<li data-start=\"1772\" data-end=\"1862\">\n<p data-start=\"1774\" data-end=\"1862\"><strong data-start=\"1774\" data-end=\"1796\">Lymph Node Status:</strong> e.g., <em data-start=\"1803\" data-end=\"1860\">4/12 nodes involved with perinodal extension in 2 nodes</em></p>\n</li>\n<li data-start=\"1863\" data-end=\"1923\">\n<p data-start=\"1865\" data-end=\"1923\"><strong data-start=\"1865\" data-end=\"1895\">Pathological Stage (pTNM):</strong> As per <strong data-start=\"1903\" data-end=\"1923\">AJCC 8th Edition</strong></p>\n</li>\n</ul>",
