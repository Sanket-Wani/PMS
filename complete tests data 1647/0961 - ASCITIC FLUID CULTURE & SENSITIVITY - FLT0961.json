  "interpretation": "<ul data-start=\"921\" data-end=\"1196\">\n<li data-start=\"921\" data-end=\"1043\">\n<p data-start=\"923\" data-end=\"1043\"><span style=\"font-size: 9px;\"><strong data-start=\"923\" data-end=\"943\">Positive Culture</strong> indicates bacterial peritonitis (Spontaneous Bacterial Peritonitis - SBP or Secondary peritonitis).</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1044\" data-end=\"1110\">\n<p data-start=\"1046\" data-end=\"1110\"><span style=\"font-size: 9px;\">Organism identification helps in targeted antimicrobial therapy.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1111\" data-end=\"1196\">\n<p data-start=\"1113\" data-end=\"1196\"><span style=\"font-size: 9px;\"><strong data-start=\"1113\" data-end=\"1136\">Sensitivity pattern</strong> provides guidance for <strong data-start=\"1159\" data-end=\"1195\">appropriate antibiotic selection</strong>.</span></p>\n</li>\n</ul>\n<p data-start=\"1198\" data-end=\"1218\"><span style=\"font-size: 9px;\"><strong data-start=\"1201\" data-end=\"1218\">Clinical Use:</strong></span></p>\n<ul data-start=\"1219\" data-end=\"1395\">\n<li style=\"font-size: 9px;\" data-start=\"1219\" data-end=\"1272\">\n<p data-start=\"1221\" data-end=\"1272\"><span style=\"font-size: 9px;\">Diagnosing <strong data-start=\"1232\" data-end=\"1272\">spontaneous or secondary peritonitis</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1273\" data-end=\"1350\">\n<p data-start=\"1275\" data-end=\"1350\"><span style=\"font-size: 9px;\">Assessing infection in patients with <strong data-start=\"1312\" data-end=\"1350\">cirrhosis, malignancy, or dialysis</strong></span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"1351\" data-end=\"1395\">\n<p data-start=\"1353\" data-end=\"1395\"><span style=\"font-size: 9px;\">Helps in <strong data-start=\"1362\" data-end=\"1395\">monitoring treatment response</strong></span></p>\n</li>\n</ul>",
