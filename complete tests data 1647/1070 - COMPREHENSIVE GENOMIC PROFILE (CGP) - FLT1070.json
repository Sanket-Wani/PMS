  "name": "COMPREHENSIVE GENOMIC PROFILE (CGP)",
  "code": "2310",
  "cost": 0,
  "interpretation": "<p>&nbsp;</p>\n<ul data-start=\"2427\" data-end=\"2822\">\n<li data-start=\"2427\" data-end=\"2573\">\n<p data-start=\"2429\" data-end=\"2573\">The identified <strong data-start=\"2444\" data-end=\"2469\">EGFR exon 19 deletion</strong> is associated with sensitivity to <strong data-start=\"2504\" data-end=\"2539\">EGFR tyrosine kinase inhibitors</strong> (e.g., osimertinib, erlotinib).</p>\n</li>\n<li data-start=\"2574\" data-end=\"2661\">\n<p data-start=\"2576\" data-end=\"2661\">The <strong data-start=\"2580\" data-end=\"2597\">TP53 mutation</strong> is a <strong data-start=\"2603\" data-end=\"2629\">poor prognostic marker</strong> but currently not targetable.</p>\n</li>\n<li data-start=\"2662\" data-end=\"2745\">\n<p data-start=\"2664\" data-end=\"2745\"><strong data-start=\"2664\" data-end=\"2689\">No actionable fusions</strong> or copy number changes were identified in this panel.</p>\n</li>\n<li data-start=\"2746\" data-end=\"2822\">\n<p data-start=\"2748\" data-end=\"2822\">Patient may be eligible for clinical trials targeting <strong data-start=\"2802\" data-end=\"2814\">TMB-high</strong> tumors.</p>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "tissue specimen (formalin)",
  "department": "6414fd22f02dc1ebb6a097ef",
  "isActive": true,
  "isOnboardedTest": false,
  "testCategory": [
    {
      "type": "textEditor",
      "data": {
        "value": "<p><strong>SUMMARY OF FINDINGS</strong></p>\n<table style=\"width: 96.2264%; height: 228.583px;\">\n<thead>\n<tr style=\"height: 53.2917px;\">\n<th style=\"width: 10.605%;\"><strong>Gene</strong></th>\n<th style=\"width: 27.0706%;\"><strong>Genomic Alteration</strong></th>\n<th style=\"width: 20.9308%;\"><strong>Type of Alteration</strong></th>\n<th style=\"width: 16.3261%;\"><strong>Exon/Region</strong></th>\n<th style=\"width: 24.9775%;\"><strong>Clinical Significance</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 53.2917px;\">\n<td style=\"width: 10.605%;\">e.g., TP53</td>\n<td style=\"width: 27.0706%;\">p.R248Q (c.743G&gt;A)</td>\n<td style=\"width: 20.9308%;\">Missense Mutation</td>\n<td style=\"width: 16.3261%;\">Exon 7</td>\n<td style=\"width: 24.9775%;\">Pathogenic (Tier I)</td>\n</tr>\n<tr style=\"height: 53.2917px;\">\n<td style=\"width: 10.605%;\">e.g., EGFR</td>\n<td style=\"width: 27.0706%;\">Exon 19 deletion</td>\n<td style=\"width: 20.9308%;\">Deletion</td>\n<td style=\"width: 16.3261%;\">Exon 19</td>\n<td style=\"width: 24.9775%;\">Sensitizing to EGFR TKI</td>\n</tr>\n<tr style=\"height: 68.7083px;\">\n<td style=\"width: 10.605%;\">e.g., ALK</td>\n<td style=\"width: 27.0706%;\">Rearrangement (EML4-ALK)</td>\n<td style=\"width: 20.9308%;\">Fusion Gene</td>\n<td style=\"width: 16.3261%;\">Intron 19</td>\n<td style=\"width: 24.9775%;\">Targetable (ALK inhibitors)</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p>VARIANT CLASSIFICATION (Based on AMP/ASCO/CAP Guidelines)</p>\n<table style=\"height: 174.833px; width: 96.8395%;\">\n<thead>\n<tr style=\"height: 33.7083px;\">\n<th style=\"width: 9.09458%;\"><strong>Tier</strong></th>\n<th style=\"width: 90.8246%;\"><strong>Clinical Interpretation</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 9.09458%;\">Tier I</td>\n<td style=\"width: 90.8246%;\">Strong clinical significance (FDA-approved therapies, NCCN guidelines)</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 9.09458%;\">Tier II</td>\n<td style=\"width: 90.8246%;\">Potential clinical significance (emerging evidence, clinical trials available)</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 9.09458%;\">Tier III</td>\n<td style=\"width: 90.8246%;\">Uncertain clinical significance</td>\n</tr>\n<tr style=\"height: 40px;\">\n<td style=\"width: 9.09458%;\">Tier IV</td>\n<td style=\"width: 90.8246%;\">Benign or likely benign variants</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p>&nbsp;</p>",
