        "value": "<table style=\"width: 94.9024%; height: 365.2px;\">\n<thead>\n<tr style=\"height: 33.2px;\">\n<th style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\"><strong>Parameter</strong></span></th>\n<th style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\"><strong>Result</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Marker Name</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">CK7 (Cytokeratin 7)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Clone</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">e.g., OV-TL 12/30 (lab-specific)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Antibody Type</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Monoclonal</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Dilution</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">1:100 (example)</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Localization</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Cytoplasmic</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Staining Intensity</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Negative / Weak / Moderate / Strong</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Percentage of Positive Cells</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">_______%</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Pattern</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Diffuse / Focal / Patchy</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Internal Control</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Present / Absent</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 43.6725%;\"><span style=\"font-size: 10px;\">Interpretation</span></td>\n<td style=\"width: 56.2838%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table style=\"width: 95.1735%;\">\n<thead>\n<tr>\n<th style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\"><strong>Findings</strong></span></th>\n<th style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\"><strong>Remarks</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\">CK7 Expression</span></td>\n<td style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\">Positive / Negative</span></td>\n</tr>\n<tr>\n<td style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\">Tumor Cell Positivity</span></td>\n<td style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\">Yes / No</span></td>\n</tr>\n<tr>\n<td style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\">Diagnostic Utility</span></td>\n<td style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\">Positive CK7 favors origin from lung, breast, ovary, endometrium, biliary tract, etc.</span></td>\n</tr>\n<tr>\n<td style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\">Use in Differential Diagnosis</span></td>\n<td style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\">CK7+/CK20&minus; &rarr; supports breast, lung, endometrium, etc. origin</span></td>\n</tr>\n<tr>\n<td style=\"width: 25.8402%;\"><span style=\"font-size: 10px;\">Combined Marker Utility</span></td>\n<td style=\"width: 74.2728%;\"><span style=\"font-size: 10px;\">Often interpreted with CK20, TTF-1, ER, etc.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
