  "interpretation": "<table style=\"border-collapse: collapse; width: 100%; height: 219.844px;\" border=\"1\"><colgroup><col style=\"width: 50%;\"><col style=\"width: 50%;\"></colgroup>\n<tbody>\n<tr style=\"height: 33.375px;\">\n<td><span style=\"font-size: 10px;\"><strong>Result Category</strong></span></td>\n<td><span style=\"font-size: 10px;\"><strong>Description</strong></span></td>\n</tr>\n<tr style=\"height: 52.9688px;\">\n<td><span style=\"font-size: 10px;\">Normal Disomy</span></td>\n<td><span style=\"font-size: 10px;\">Two signals for each chromosome (13, 18, 21); no aneuploidy detected.</span></td>\n</tr>\n<tr style=\"height: 33.375px;\">\n<td><span style=\"font-size: 10px;\">Trisomy 21 (Down Syndrome)</span></td>\n<td><span style=\"font-size: 10px;\">Three signals for chromosome 21; confirm by karyotype if needed.</span></td>\n</tr>\n<tr style=\"height: 33.375px;\">\n<td><span style=\"font-size: 10px;\">Trisomy 18 (Edwards Syndrome)</span></td>\n<td><span style=\"font-size: 10px;\">Three signals for chromosome 18; confirm by karyotype.</span></td>\n</tr>\n<tr style=\"height: 33.375px;\">\n<td><span style=\"font-size: 10px;\">Trisomy 13 (Patau Syndrome)</span></td>\n<td><span style=\"font-size: 10px;\">Three signals for chromosome 13; confirm by karyotype.</span></td>\n</tr>\n<tr style=\"height: 33.375px;\">\n<td><span style=\"font-size: 10px;\">Mosaicism</span></td>\n<td><span style=\"font-size: 10px;\">Mixed cell populations; percentage of abnormal cells reported, clinical correlation required.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
