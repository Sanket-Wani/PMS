        "value": "<table style=\"height: 203.583px; width: 96.733%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 30.7017%;\"><strong>Abnormality / Probe</strong></th>\n<th style=\"width: 20.5007%;\"><strong>Locus / Gene</strong></th>\n<th style=\"width: 43.984%;\"><strong>Result</strong> (Detected / Not Detected)</th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33px;\">\n<td style=\"width: 30.7017%;\"><strong>del(13q14)</strong></td>\n<td style=\"width: 20.5007%;\">D13S319 / RB1</td>\n<td style=\"width: 43.984%;\">&nbsp;</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 30.7017%;\"><strong>del(11q22.3)</strong></td>\n<td style=\"width: 20.5007%;\">ATM gene</td>\n<td style=\"width: 43.984%;\">&nbsp;</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 30.7017%;\"><strong>trisomy 12</strong></td>\n<td style=\"width: 20.5007%;\">CEP 12</td>\n<td style=\"width: 43.984%;\">&nbsp;</td>\n</tr>\n<tr style=\"height: 33px;\">\n<td style=\"width: 30.7017%;\"><strong>del(17p13.1)</strong></td>\n<td style=\"width: 20.5007%;\">TP53 gene</td>\n<td style=\"width: 43.984%;\">&nbsp;</td>\n</tr>\n<tr style=\"height: 37px;\">\n<td style=\"width: 30.7017%;\"><strong>del(6q23)</strong> <em>(optional)</em></td>\n<td style=\"width: 20.5007%;\">MYB</td>\n<td style=\"width: 43.984%;\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
