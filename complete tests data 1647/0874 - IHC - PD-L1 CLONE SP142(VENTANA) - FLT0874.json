  "interpretation": "<table>\n<thead>\n<tr>\n<th><span style=\"font-size: 10px;\"><strong>PD-L1 Expression Level</strong></span></th>\n<th><span style=\"font-size: 10px;\"><strong>Interpretation (SP142 Criteria)</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"font-size: 10px;\">TC &ge; 1%</span></td>\n<td><span style=\"font-size: 10px;\">PD-L1 Positive in tumor cells &ndash; may be eligible for immunotherapy (e.g., atezolizumab)</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">IC &ge; 1%</span></td>\n<td><span style=\"font-size: 10px;\">PD-L1 Positive in immune cells &ndash; may support eligibility for therapy</span></td>\n</tr>\n<tr>\n<td><span style=\"font-size: 10px;\">TC &lt; 1% and IC &lt; 1%</span></td>\n<td><span style=\"font-size: 10px;\">PD-L1 Negative &ndash; Limited or no response expected to PD-L1 targeted therapy (depending on tumor type)</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<ul>\n<li style=\"font-size: 10px;\" data-start=\"2983\" data-end=\"3116\">\n<p data-start=\"2985\" data-end=\"3116\"><span style=\"font-size: 10px;\">PD-L1 (SP142) expression helps guide treatment decisions involving <strong data-start=\"3052\" data-end=\"3084\">immune checkpoint inhibitors</strong>, particularly <strong data-start=\"3099\" data-end=\"3115\">atezolizumab</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3117\" data-end=\"3234\">\n<p data-start=\"3119\" data-end=\"3234\"><span style=\"font-size: 10px;\">Evaluation must be interpreted in the context of <strong data-start=\"3168\" data-end=\"3182\">tumor type</strong>, <strong data-start=\"3184\" data-end=\"3207\">clinical indication</strong>, and <strong data-start=\"3213\" data-end=\"3233\">other biomarkers</strong>.</span></p>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"3235\" data-end=\"3363\">\n<p data-start=\"3237\" data-end=\"3363\"><span style=\"font-size: 10px;\">Different clones (SP263, 22C3, 28-8) may give varying results &ndash; ensure consistency in assay and interpretation guideline used.</span></p>\n</li>\n</ul>",
