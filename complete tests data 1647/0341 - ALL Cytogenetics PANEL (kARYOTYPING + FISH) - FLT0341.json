  "code": "1385",
  "cost": 0,
  "interpretation": "<table style=\"height: 309px; width: 93.6435%;\">\n<thead>\n<tr style=\"height: 33px;\">\n<th style=\"width: 21.6487%;\"><strong>Test</strong></th>\n<th style=\"width: 40.0503%;\"><strong>Target / Marker</strong></th>\n<th style=\"width: 33.3286%;\"><strong>Clinical Utility</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">Karyotyping</td>\n<td style=\"width: 40.0503%;\">Full chromosome analysis (46,XX / 46,XY etc.)</td>\n<td style=\"width: 33.3286%;\">Detects numerical/structural abnormalities</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - BCR/ABL1</td>\n<td style=\"width: 40.0503%;\">t(9;22)(q34;q11)</td>\n<td style=\"width: 33.3286%;\">Philadelphia chromosome (CML/ALL)</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - MLL (KMT2A)</td>\n<td style=\"width: 40.0503%;\">11q23 rearrangements</td>\n<td style=\"width: 33.3286%;\">Poor prognosis marker</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - ETV6/RUNX1</td>\n<td style=\"width: 40.0503%;\">t(12;21)(p13;q22)</td>\n<td style=\"width: 33.3286%;\">Common in childhood ALL</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - TCF3/PBX1</td>\n<td style=\"width: 40.0503%;\">t(1;19)(q23;p13.3)</td>\n<td style=\"width: 33.3286%;\">Seen in pre-B ALL</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - Hyperdiploidy</td>\n<td style=\"width: 40.0503%;\">Chromosomes 4, 10, 17</td>\n<td style=\"width: 33.3286%;\">Favorable prognosis marker</td>\n</tr>\n<tr style=\"height: 34px;\">\n<td style=\"width: 21.6487%;\">FISH - iAMP21</td>\n<td style=\"width: 40.0503%;\">Intrachromosomal amplification of chromosome 21</td>\n<td style=\"width: 33.3286%;\">Associated with high-risk ALL</td>\n</tr>\n<tr style=\"height: 37px;\">\n<td style=\"width: 21.6487%;\">FISH - CDKN2A/IKZF1 del</td>\n<td style=\"width: 40.0503%;\">9p21 deletions</td>\n<td style=\"width: 33.3286%;\">Associated with T-ALL or poor-risk ALL</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
