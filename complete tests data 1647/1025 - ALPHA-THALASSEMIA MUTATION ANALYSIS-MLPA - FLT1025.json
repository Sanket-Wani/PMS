  "interpretation": "<ul>\n<li data-start=\"1848\" data-end=\"1947\">\n<p data-start=\"1851\" data-end=\"1899\"><span style=\"font-size: 10px;\"><strong data-start=\"1851\" data-end=\"1897\">Normal (&alpha;&alpha;/&alpha;&alpha; &ndash; 4 functional alpha genes):</strong></span></p>\n<ul data-start=\"1903\" data-end=\"1947\">\n<li style=\"font-size: 10px;\" data-start=\"1903\" data-end=\"1947\">\n<p data-start=\"1905\" data-end=\"1947\"><span style=\"font-size: 10px;\">No evidence of alpha-thalassemia mutation.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"1949\" data-end=\"2063\">\n<p data-start=\"1952\" data-end=\"2002\"><span style=\"font-size: 10px;\"><strong data-start=\"1952\" data-end=\"2000\">Silent Carrier (&ndash;&alpha;/&alpha;&alpha; &ndash; 3 functional genes):</strong></span></p>\n<ul data-start=\"2006\" data-end=\"2063\">\n<li style=\"font-size: 10px;\" data-start=\"2006\" data-end=\"2063\">\n<p data-start=\"2008\" data-end=\"2063\"><span style=\"font-size: 10px;\">Usually asymptomatic; may show borderline microcytosis.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2065\" data-end=\"2216\">\n<p data-start=\"2068\" data-end=\"2136\"><span style=\"font-size: 10px;\"><strong data-start=\"2068\" data-end=\"2134\">Alpha-Thalassemia Trait (&ndash;&alpha;/&ndash;&alpha; or &ndash;&ndash;/&alpha;&alpha; &ndash; 2 functional genes):</strong></span></p>\n<ul data-start=\"2140\" data-end=\"2216\">\n<li style=\"font-size: 10px;\" data-start=\"2140\" data-end=\"2216\">\n<p data-start=\"2142\" data-end=\"2216\"><span style=\"font-size: 10px;\">Mild hypochromic microcytic anemia; important for reproductive counseling.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2218\" data-end=\"2318\">\n<p data-start=\"2221\" data-end=\"2276\"><span style=\"font-size: 10px;\"><strong data-start=\"2221\" data-end=\"2274\">Hemoglobin H Disease (&ndash;&ndash;/&ndash;&alpha; &ndash; 1 functional gene):</strong></span></p>\n<ul data-start=\"2280\" data-end=\"2318\">\n<li style=\"font-size: 10px;\" data-start=\"2280\" data-end=\"2318\">\n<p data-start=\"2282\" data-end=\"2318\"><span style=\"font-size: 10px;\">Moderate to severe hemolytic anemia.</span></p>\n</li>\n</ul>\n</li>\n<li style=\"font-size: 10px;\" data-start=\"2320\" data-end=\"2415\">\n<p data-start=\"2323\" data-end=\"2374\"><span style=\"font-size: 10px;\"><strong data-start=\"2323\" data-end=\"2372\">Hydrops Fetalis (&ndash;&ndash;/&ndash;&ndash; &ndash; 0 functional genes):</strong></span></p>\n<ul data-start=\"2378\" data-end=\"2415\">\n<li style=\"font-size: 10px;\" data-start=\"2378\" data-end=\"2415\">\n<p data-start=\"2380\" data-end=\"2415\"><span style=\"font-size: 10px;\">Usually fatal in utero or at birth.</span></p>\n</li>\n</ul>\n</li>\n</ul>",
