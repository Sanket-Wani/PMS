  "cost": 0,
  "interpretation": "<table style=\"width: 73.2422%; height: 252.8px;\">\n<thead>\n<tr style=\"height: 34px;\">\n<th style=\"width: 38.093%;\"><span style=\"font-size: 10px;\"><strong>Finding</strong></span></th>\n<th style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\"><strong>Interpretation</strong></span></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">No Growth</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">No infection or suppressed by prior antibiotics</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">Single Pathogen Isolated</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">Likely cause of conjunctival infection</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">Mixed Growth</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">Possible contamination / co-infection</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">Fungal Elements Found</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">Indicates fungal conjunctivitis</span></td>\n</tr>\n<tr style=\"height: 52.8px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">Sensitive to Common Antibiotics</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">Routine topical antibiotics effective</span></td>\n</tr>\n<tr style=\"height: 33.2px;\">\n<td style=\"width: 38.093%;\"><span style=\"font-size: 10px;\">Resistant Pattern Seen</span></td>\n<td style=\"width: 56.4787%;\"><span style=\"font-size: 10px;\">Adjust therapy; consider ophthalmologist advice</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
