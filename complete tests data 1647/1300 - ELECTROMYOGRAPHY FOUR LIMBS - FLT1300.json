        "value": "<table style=\"width: 90.9801%; height: 280.25px;\">\n<thead>\n<tr style=\"height: 33.7083px;\">\n<th style=\"width: 46.01%;\"><strong>Parameter</strong></th>\n<th style=\"width: 54.0524%;\"><strong>Description</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 46.01%;\">Insertional Activity</td>\n<td style=\"width: 54.0524%;\">Assessed for abnormal spontaneous activity</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 46.01%;\">Resting Spontaneous Activity</td>\n<td style=\"width: 54.0524%;\">Fibrillations, positive sharp waves</td>\n</tr>\n<tr style=\"height: 53.2917px;\">\n<td style=\"width: 46.01%;\">Motor Unit Action Potentials (MUAPs)</td>\n<td style=\"width: 54.0524%;\">Amplitude, duration, polyphasia</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 46.01%;\">Recruitment Pattern</td>\n<td style=\"width: 54.0524%;\">Evaluates muscle activation</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 46.01%;\">Nerve Distribution</td>\n<td style=\"width: 54.0524%;\">Radial, Median, Ulnar, Tibial, Peroneal, etc.</td>\n</tr>\n<tr style=\"height: 33.7083px;\">\n<td style=\"width: 46.01%;\">Muscle Groups Tested</td>\n<td style=\"width: 54.0524%;\">Upper limb &amp; lower limb major muscles</td>\n</tr>\n<tr style=\"height: 24.7083px;\">\n<td style=\"width: 46.01%;\">Symmetry &amp; Comparison</td>\n<td style=\"width: 54.0524%;\">Right vs. Left, Proximal vs. Distal</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
