  "name": "IHC - PLACENTAL ALKALINE PHOSPHATASE (PLAP)",
  "code": "1945",
  "cost": 0,
  "interpretation": "<ul data-start=\"559\" data-end=\"747\">\n<li data-start=\"559\" data-end=\"659\">\n<p data-start=\"561\" data-end=\"659\"><span style=\"font-size: 9px;\"><strong data-start=\"561\" data-end=\"582\">Positive staining</strong> suggests <strong data-start=\"592\" data-end=\"612\">germ cell tumors</strong>, especially <strong data-start=\"625\" data-end=\"656\">seminomas and dysgerminomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"660\" data-end=\"747\">\n<p data-start=\"662\" data-end=\"747\"><span style=\"font-size: 9px;\">Also expressed in <strong data-start=\"680\" data-end=\"699\">some carcinomas</strong> like lung or ovarian tumors, but less specific.</span></p>\n</li>\n</ul>\n<h3 data-start=\"754\" data-end=\"782\"><span style=\"font-size: 9px;\"><strong data-start=\"761\" data-end=\"782\">Clinical Utility:</strong></span></h3>\n<ul data-start=\"784\" data-end=\"977\">\n<li style=\"font-size: 9px;\" data-start=\"784\" data-end=\"864\">\n<p data-start=\"786\" data-end=\"864\"><span style=\"font-size: 9px;\">Helps identify and confirm <strong data-start=\"813\" data-end=\"833\">germ cell tumors</strong>, particularly <strong data-start=\"848\" data-end=\"861\">seminomas</strong>.</span></p>\n</li>\n<li style=\"font-size: 9px;\" data-start=\"865\" data-end=\"977\">\n<p data-start=\"867\" data-end=\"977\"><span style=\"font-size: 9px;\">Used as part of an <strong data-start=\"886\" data-end=\"899\">IHC panel</strong> for tumor classification, especially in <strong data-start=\"940\" data-end=\"976\">testicular and ovarian neoplasms</strong></span></p>\n</li>\n</ul>",
