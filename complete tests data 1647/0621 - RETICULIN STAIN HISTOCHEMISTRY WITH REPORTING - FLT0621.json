    {
      "type": "textEditor",
      "data": {
        "value": "<p><strong data-start=\"543\" data-end=\"570\">Microscopic Observation</strong>:</p>\n<p data-start=\"574\" data-end=\"618\">Reticulin staining pattern is evaluated for:</p>\n<ul data-start=\"621\" data-end=\"715\">\n<li data-start=\"621\" data-end=\"640\">\n<p data-start=\"623\" data-end=\"640\">Fiber thickness</p>\n</li>\n<li data-start=\"643\" data-end=\"659\">\n<p data-start=\"645\" data-end=\"659\">Distribution</p>\n</li>\n<li data-start=\"662\" data-end=\"715\">\n<p data-start=\"664\" data-end=\"715\">Pattern (network, coarse/thin, increased/decreased)</p>\n</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th><strong>Grade</strong></th>\n<th><strong>Reticulin Fiber Pattern</strong></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>MF-0</strong></td>\n<td>Scattered linear fibers, no intersections</td>\n</tr>\n<tr>\n<td><strong>MF-1</strong></td>\n<td>Loose network with some intersections</td>\n</tr>\n<tr>\n<td><strong>MF-2</strong></td>\n<td>Diffuse and dense increase with intersections</td>\n</tr>\n<tr>\n<td><strong>MF-3</strong></td>\n<td>Coarse, thick fibers with collagen and osteosclerosis</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>",
        "field": "textEditor"
      },
