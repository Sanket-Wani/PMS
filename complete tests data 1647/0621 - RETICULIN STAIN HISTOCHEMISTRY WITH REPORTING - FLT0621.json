  "name": "RETICULIN STAIN HISTOCHEMISTRY WITH REPORTING",
  "code": "1721",
  "cost": 0,
  "interpretation": "<ul>\n<li data-start=\"1628\" data-end=\"1687\">\n<p data-start=\"1630\" data-end=\"1687\">Normal reticulin pattern suggests <strong data-start=\"1664\" data-end=\"1686\">no marrow fibrosis</strong>.</p>\n</li>\n<li data-start=\"1688\" data-end=\"1883\">\n<p data-start=\"1690\" data-end=\"1723\">Increased reticulin may indicate:</p>\n<ul data-start=\"1726\" data-end=\"1883\">\n<li data-start=\"1726\" data-end=\"1787\">\n<p data-start=\"1728\" data-end=\"1787\"><strong data-start=\"1728\" data-end=\"1745\">Myelofibrosis</strong>, <strong data-start=\"1747\" data-end=\"1787\">Chronic myeloproliferative neoplasms</strong></p>\n</li>\n<li data-start=\"1790\" data-end=\"1821\">\n<p data-start=\"1792\" data-end=\"1821\"><strong data-start=\"1792\" data-end=\"1821\">Post-chemotherapy changes</strong></p>\n</li>\n<li data-start=\"1824\" data-end=\"1883\">\n<p data-start=\"1826\" data-end=\"1883\"><strong data-start=\"1826\" data-end=\"1883\">Chronic inflammation or cirrhosis (in liver biopsies)</strong></p>\n</li>\n</ul>\n</li>\n</ul>",
  "showInterpretation": false,
  "sampleType": "tissue",
